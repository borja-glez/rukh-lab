---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, themeColors, localeTags, type Locale } from '../lib/site';
import themeInit from '../scripts/theme-init.js?raw';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /** Path of this page, used for the canonical URL (e.g. `/curso/`). */
  path: string;
  ogType?: 'website' | 'article';
}

const { title, description, lang = 'es', path, ogType = 'website' } = Astro.props;

/*
 * The theme bootstrap is inlined verbatim (`?raw` imports the file text at build
 * time): astro.config.mjs hashes the same file for the CSP, so the browser never
 * blocks it.
 */
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL('/og-default.png', SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={themeInit}></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={themeColors.light} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={localeTags[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-mono" preload={[{ subset: 'latin' }]} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
