---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import FigureFrame from '../components/FigureFrame.astro';
import ResultsTable from '../components/mdx/ResultsTable.astro';
import { getDictionary } from '../i18n';
import { SITE } from '../lib/site';

const t = getDictionary('en');
const stages = [
  ['M1', 'Data & tokenization', 'Lichess cut, UCI vocabulary, BPE, dataloaders'],
  ['M2', 'Decoder', 'GPT-style MoveDecoder trained from scratch, ONNX, WebGPU demo'],
  ['M3', 'Encoder', 'Masked move modeling, value and blunder heads'],
  ['M4', 'Fine-tuning', 'Masters SFT, Elo-conditioning, LoRA, QLoRA vs Qwen3'],
  ['M5', 'Alignment', 'Reward model, DPO, GRPO with Stockfish as verifier'],
  ['M6', 'Evaluation', 'Single results table, model cards, final demo'],
  ['A1-A6', 'Agentic coach', 'RAG over positions and books, LangGraph agent, MCP server'],
];
---

<Base
  title="Project"
  description="Rukh: a chess language model trained from scratch, aligned with verifiable rewards, deployed on WebGPU and turned into an agent with tools. Architecture, repositories, results and links."
  lang="en"
  path="/proyecto/"
>
  <main id="main" class="page container">
    <section class="section intro">
      <p class="label label--accent">// {t.project.kicker}</p>
      <h1 class="section__title section__title--narrow">{t.project.title}</h1>
      <p class="body section__lead pretty">{t.project.lead}</p>
      <div class="intro__actions">
        <a class="btn btn--primary" href={SITE.demoUrl} rel="noopener">
          {t.project.links.demo}
        </a>
        <a class="btn btn--secondary" href={SITE.hfUrl} rel="noopener">
          Hugging Face · chorcat
        </a>
        <a class="btn btn--secondary" href={SITE.githubUrl} rel="noopener">
          GitHub · borja-glez
        </a>
      </div>
    </section>

    <section class="section" aria-labelledby="what-title">
      <SectionHead n="01" label={t.project.what.title} kind="one artifact, the whole lifecycle" />
      <div class="two-col">
        <div>
          <h2 id="what-title" class="section__title section__title--narrow">
            One model, every stage of the lifecycle.
          </h2>
          <p class="body section__lead pretty">{t.project.what.body}</p>
        </div>
        <ol class="stages">
          {stages.map(([id, name, what]) => (
            <li class="stages__row">
              <span class="mono stages__id">{id}</span>
              <span class="stages__name">{name}</span>
              <span class="caption stages__what">{what}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="repos-title">
      <SectionHead n="02" label={t.project.repos.title} kind="architecture" />
      <h2 id="repos-title" class="section__title section__title--narrow">
        Three repositories, no shared packages.
      </h2>
      <p class="body section__lead pretty">
        Everything the two web apps share (CSS tokens, the TypeScript tokenizer, precomputed JSON)
        is copied by a script and guarded by a hash test. All trained weights and datasets live on
        Hugging Face, never in git.
      </p>
      <div class="repos">
        <FigureFrame>
          <svg class="diagram" viewBox="0 0 640 260" role="img" aria-labelledby="arch-title">
            <title id="arch-title">Architecture: rukh publishes to Hugging Face; rukh-lab and rukh-web read from it</title>
            <g class="diagram__box diagram__box--main">
              <rect x="20" y="90" width="180" height="80"></rect>
              <text x="110" y="120">
                rukh
              </text>
              <text x="110" y="144" class="diagram__sub">
                train · eval · agents
              </text>
            </g>
            <g class="diagram__box">
              <rect x="440" y="20" width="180" height="80"></rect>
              <text x="530" y="50">
                rukh-lab
              </text>
              <text x="530" y="74" class="diagram__sub">
                course · lab.rukh
              </text>
            </g>
            <g class="diagram__box">
              <rect x="440" y="160" width="180" height="80"></rect>
              <text x="530" y="190">
                rukh-web
              </text>
              <text x="530" y="214" class="diagram__sub">
                play · WebGPU
              </text>
            </g>
            <g class="diagram__box diagram__box--hub">
              <rect x="250" y="100" width="140" height="60" rx="30"></rect>
              <text x="320" y="135">
                Hugging Face
              </text>
            </g>
            <path class="diagram__wire" d="M200 130h50"></path>
            <path class="diagram__wire" d="M390 120c30 0 20-60 50-60"></path>
            <path class="diagram__wire" d="M390 140c30 0 20 60 50 60"></path>
            <path class="diagram__wire diagram__wire--dash" d="M200 110c40-40 200-60 240-60"></path>
            <text x="300" y="42" class="diagram__note">
              artifacts/web/*.json → sync:data
            </text>
            <text x="320" y="182" class="diagram__note">
              models · adapters · datasets
            </text>
          </svg>
        </FigureFrame>
        <ul class="repos__list">
          {t.project.repos.items.map((r) => (
            <li class="repos__item">
              <a class="repos__name mono" href={r.href} rel="noopener">
                borja-glez/{r.name}
              </a>
              <p class="repos__role">{r.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="results-title">
      <SectionHead n="03" label={t.project.results.title} kind="rukh eval nightly" />
      <h2 id="results-title" class="section__title section__title--narrow">
        Measured the same way, every time.
      </h2>
      <p class="body section__lead pretty">{t.project.results.lead}</p>
      <ResultsTable lang="en" emptyText={t.project.results.empty} />
    </section>

    <section class="section" aria-labelledby="links-title">
      <SectionHead n="04" label={t.project.links.title} kind="public artifacts" />
      <h2 id="links-title" class="sr-only">
        {t.project.links.title}
      </h2>
      <ul class="links">
        <li>
          <a class="links__item" href={SITE.hfUrl} rel="noopener">
            {t.project.links.hub}
            <span class="mono">huggingface.co/chorcat</span>
          </a>
        </li>
        <li>
          <a class="links__item" href={SITE.githubUrl} rel="noopener">
            {t.project.links.github}
            <span class="mono">github.com/borja-glez</span>
          </a>
        </li>
        <li>
          <a class="links__item" href={SITE.demoUrl} rel="noopener">
            {t.project.links.demo}
            <span class="mono">rukh.borjaglez.com</span>
          </a>
        </li>
        <li>
          <a class="links__item" href="/curso/" hreflang="es">
            {t.project.links.course}
            <span class="mono">lab.rukh.borjaglez.com/curso/</span>
          </a>
        </li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .intro {
    padding-bottom: clamp(48px, 8vh, 96px);
  }

  .intro .label {
    margin-bottom: 20px;
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .stages {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .stages__row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 4px 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .stages__id {
    font-size: 11px;
    color: var(--accent-text);
    padding-top: 3px;
  }

  .stages__name {
    font-weight: 600;
    color: var(--ink);
  }

  .stages__what {
    grid-column: 2;
  }

  .repos {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(24px, 4vw, 48px);
    margin-top: 40px;
    align-items: start;
  }

  .repos__list {
    display: grid;
    gap: 1px;
    padding: 1px;
  }

  .repos__item {
    padding: 18px 20px;
    box-shadow: 0 0 0 1px var(--line);
    background: var(--frame-bg);
  }

  .repos__name {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 13px;
    color: var(--ink);
  }

  .repos__role {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .diagram text {
    font-family: var(--font-mono);
    fill: var(--diagram-stroke);
  }

  .diagram__note {
    font-size: 10px;
    letter-spacing: 0.5px;
    text-anchor: middle;
  }

  .diagram__wire {
    fill: none;
    stroke: var(--diagram-stroke);
    stroke-width: 1.25;
  }

  .diagram__wire--dash {
    stroke-dasharray: 3 3;
  }

  .diagram__box rect {
    fill: var(--box-fill);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .diagram__box text {
    font-size: 14px;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .diagram__box .diagram__sub {
    font-size: 10px;
    fill: var(--muted);
  }

  .diagram__box--main rect {
    fill: var(--ink);
  }

  .diagram__box--main text {
    fill: var(--paper);
  }

  .diagram__box--hub rect {
    stroke: var(--accent-text);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1px;
    padding: 1px;
  }

  .links__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 44px;
    padding: 18px 20px;
    box-shadow: 0 0 0 1px var(--line);
    background: var(--frame-bg);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .links__item:hover {
    background: var(--card-hover);
    color: var(--ink);
  }

  .links__item .mono {
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .repos {
      grid-template-columns: 1fr;
    }
  }
</style>
