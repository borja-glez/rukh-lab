---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Recorrido from '../../components/Recorrido.astro';
import { courseTime, formatHours, moduleTime } from '../../lib/hours';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const lessonsOf = (moduleId: string) => lessons.filter((l) => l.data.module === moduleId);
const timeOf = (m: (typeof modules)[number]) => moduleTime(m, lessons);
const phase1 = modules.filter((m) => m.data.phase === 1);
const phase2 = modules.filter((m) => m.data.phase === 2);
const t1 = courseTime(phase1, lessons);
const t2 = courseTime(phase2, lessons);
const phases = [
  {
    n: '01',
    id: 'fase-1',
    label: 'Fase 1',
    title: 'Un modelo de lenguaje de ajedrez desde cero',
    kind: `siete módulos · 65 lecciones · ≈ ${formatHours(t1.work)} de trabajo + ${formatHours(t1.run)} de GPU y red`,
    modules: phase1,
  },
  {
    n: '02',
    id: 'fase-2',
    label: 'Fase 2',
    title: 'IA agéntica: el entrenador',
    kind: `seis módulos · cuatro semanas · ≈ ${formatHours(t2.work)} estimadas`,
    modules: phase2,
  },
];
/*
 * Only the two unfinished states get a chip. A module that is published is the normal case, and
 * labelling the normal case says nothing: the reader learns what is missing, not what is there.
 * `live` stays in the map because the status still drives the styling elsewhere.
 */
const statusLabel = { live: 'vigente', draft: 'borrador', planned: 'previsto' } as const;
const total = courseTime(modules, lessons);
---

<Base
  title="Curso"
  description="Los trece módulos del curso Rukh: siete para construir, entrenar y alinear un modelo de lenguaje de ajedrez desde cero y seis para convertirlo en un entrenador agéntico con RAG, herramientas y MCP."
  path="/curso/"
>
  <main id="main" class="page container">
    <section class="section intro">
      <p class="label label--accent">
        // curso · {modules.length} módulos · ≈ {formatHours(total.work)} de trabajo
      </p>
      <h1 class="section__title section__title--narrow">Dos fases, un artefacto.</h1>
      <p class="body section__lead pretty">
        Cada módulo cierra con algo que funciona y se mide con la misma tabla: legalidad, exactitud,
        puzles y Elo frente a Stockfish. Rukh empieza como un aprendiz que no sabe ni leer una
        jugada y, módulo a módulo, recorre las mismas etapas que cualquier modelo de lenguaje:
        datos, preentrenamiento, afinado, alineamiento y evaluación. La fase 1 está publicada
        entera; la fase 2, con los agentes, viene después.
      </p>
      <Recorrido />
      <p class="caption intro__clocks pretty">
        Las dos cifras de cada módulo son dos relojes distintos. <strong>Trabajo</strong> es el
        tiempo contigo delante: leer, escribir el código y hacer los ejercicios.{' '}
        <strong>GPU y red</strong> es el reloj de pared sin ti: entrenamientos, descargas y partidas
        contra el motor en la máquina de referencia (RTX 5090). Casi todo ese segundo reloj se puede
        saltar descargando el artefacto ya hecho con <code>rukh pull</code>; cada lección de labs
        dice cuál.
      </p>
    </section>

    {phases.map((phase) => (
      <section class="section" id={phase.id} aria-labelledby={`${phase.id}-title`}>
        <SectionHead n={phase.n} label={phase.label} kind={phase.kind} />
        <h2 id={`${phase.id}-title`} class="phase__title">
          {phase.title}
        </h2>
        <ol class="card-grid modules">
          {phase.modules.map((m) => {
            const ls = lessonsOf(m.id);
            const time = timeOf(m);
            return (
              <li class="module" id={m.id}>
                <div class="module__head">
                  <span class="mono module__id">{m.id.toUpperCase()}</span>
                  <span class="module__hours mono">
                    {formatHours(time.work)}
                    {time.run > 0 && (
                      <span class="module__run"> + {formatHours(time.run)} de GPU</span>
                    )}
                  </span>
                  {m.data.status !== 'live' && (
                    <span class:list={['chip', { 'chip--draft': m.data.status === 'draft' }]}>
                      {statusLabel[m.data.status]}
                    </span>
                  )}
                  {ls.length > 0 && (
                    <span
                      class="chip module__progress"
                      data-progress-count
                      data-module={m.id}
                      data-lessons={ls.map((l) => l.id.split('/')[1]).join(',')}
                      aria-label="Lecciones completadas"
                    >
                      0/{ls.length}
                    </span>
                  )}
                </div>
                <h3 class="module__title">
                  {ls.length > 0 ? (
                    <a class="module__title-link" href={`/curso/${ls[0].id}/`}>
                      {m.data.title}
                    </a>
                  ) : (
                    m.data.title
                  )}
                </h3>
                <p class="module__summary pretty">{m.data.summary}</p>
                <ul class="module__outcomes">
                  {m.data.outcomes.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
                {m.data.artifacts.length > 0 && (
                  <ul class="module__artifacts">
                    {m.data.artifacts.map((a) => (
                      <li class="chip">
                        {a.href ? (
                          <a href={a.href} rel="noopener">
                            {a.kind} · {a.label}
                          </a>
                        ) : (
                          <span>
                            {a.kind} · {a.label}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="module__lessons">
                  {ls.length > 0 ? (
                    <ol class="lessons">
                      {ls.map((l) => (
                        <li
                          class="lessons__item"
                          data-progress-lesson
                          data-module={m.id}
                          data-lesson={l.id.split('/')[1]}
                        >
                          <a class="lessons__link" href={`/curso/${l.id}/`}>
                            <span class="mono lessons__n">
                              {String(l.data.order).padStart(2, '0')}
                            </span>
                            <span class="lessons__title">{l.data.title}</span>
                            <span class="caption lessons__meta">
                              {l.data.duration} min
                              {l.data.runtime ? ` + ${l.data.runtime} de GPU` : ''}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <p class="caption">Lecciones en cuanto se cierre el hito.</p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </main>
  <script>
    import '../../scripts/progress';
  </script>
</Base>

<style>
  .intro {
    padding-bottom: clamp(48px, 8vh, 96px);
  }

  .intro .label {
    margin-bottom: 20px;
  }

  .phase__title {
    margin: -16px 0 28px;
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .modules {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    margin: 0;
    padding: 1px;
    list-style: none;
  }

  .module {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: var(--frame-bg);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .module__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .module__id {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    padding: 2px 8px;
    background: var(--ink);
    color: var(--paper);
  }

  .module__hours {
    font-size: 12px;
    color: var(--muted);
  }

  .module__run {
    color: var(--muted);
  }

  .intro__clocks {
    max-width: 62ch;
    margin-top: 14px;
    padding-left: 14px;
    border-left: 1px solid var(--line);
    color: var(--muted);
  }

  .intro__clocks strong {
    color: var(--ink);
    font-weight: 600;
  }

  .module__progress {
    margin-left: auto;
    min-width: 44px;
    justify-content: center;
  }

  .module__progress.is-complete {
    border-color: var(--ok);
    color: var(--ok);
  }

  .module__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  /* The title is the link. Before this the only way into a module was the small numbered row at
     the bottom of the card, which nobody looks for: the thing that reads like the door is the
     heading. The lesson rows stay as they are -- they are the list, not the door. */
  .module__title-link {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 2px;
    transition: background-size 160ms ease;
  }

  .module:hover .module__title-link,
  .module__title-link:hover,
  .module__title-link:focus-visible {
    background-size: 100% 2px;
  }

  .module__title-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .module:has(.module__title-link):hover {
    border-color: var(--ink-3, var(--line));
  }

  @media (prefers-reduced-motion: reduce) {
    .module__title-link {
      transition: none;
    }
  }

  .module__summary {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .module__label {
    margin-top: 4px;
  }

  .module__outcomes {
    display: grid;
    gap: 6px;
    padding-left: 1.1em;
    list-style: square;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .module__outcomes :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .module__artifacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .module__artifacts a {
    color: inherit;
    text-decoration: none;
  }

  .module__artifacts a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .module__lessons {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
  }

  .lessons {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .lessons__link {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 6px 0;
    color: var(--ink);
    text-decoration: none;
  }

  .lessons__link:hover .lessons__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .lessons__n {
    font-size: 11px;
    color: var(--muted);
  }

  .lessons__item.is-done .lessons__n {
    color: var(--ok);
  }

  .lessons__item.is-done .lessons__n::after {
    content: ' ✓';
  }

  .lessons__title {
    font-size: 15px;
    font-weight: 500;
  }
</style>
