---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const lessonsOf = (moduleId: string) => lessons.filter((l) => l.data.module === moduleId);
const phases = [
  {
    n: '01',
    id: 'fase-1',
    label: 'Fase 1',
    title: 'Un modelo de lenguaje de ajedrez desde cero',
    kind: 'siete módulos · cinco semanas · ≈ 44 h',
    modules: modules.filter((m) => m.data.phase === 1),
  },
  {
    n: '02',
    id: 'fase-2',
    label: 'Fase 2',
    title: 'IA agéntica: el entrenador',
    kind: 'seis módulos · cuatro semanas · ≈ 30 h',
    modules: modules.filter((m) => m.data.phase === 2),
  },
];
const statusLabel = { live: 'vigente', draft: 'borrador', planned: 'previsto' } as const;
const totalHours = modules.reduce((acc, m) => acc + m.data.hours, 0);
---

<Base
  title="Curso"
  description="Los trece módulos del curso Rukh: siete para construir, entrenar y alinear un modelo de lenguaje de ajedrez desde cero y seis para convertirlo en un entrenador agéntico con RAG, herramientas y MCP."
  path="/curso/"
>
  <main id="main" class="page container">
    <section class="section intro">
      <p class="label label--accent">
        // curso · {modules.length} módulos · ≈ {totalHours} h
      </p>
      <h1 class="section__title section__title--narrow">Dos fases, un artefacto.</h1>
      <p class="body section__lead pretty">
        Cada módulo cierra con algo que funciona y se mide con la misma tabla: legalidad, exactitud,
        puzles y Elo frente a Stockfish. Las lecciones se publican hito a hito; el módulo 0 ya está
        disponible.
      </p>
    </section>

    {phases.map((phase) => (
      <section class="section" id={phase.id} aria-labelledby={`${phase.id}-title`}>
        <SectionHead n={phase.n} label={phase.label} kind={phase.kind} />
        <h2 id={`${phase.id}-title`} class="phase__title">
          {phase.title}
        </h2>
        <ol class="card-grid modules">
          {phase.modules.map((m) => {
            const ls = lessonsOf(m.id);
            return (
              <li class="module" id={m.id}>
                <div class="module__head">
                  <span class="mono module__id">{m.id.toUpperCase()}</span>
                  <span class="module__hours mono">{m.data.hours} h</span>
                  <span
                    class:list={[
                      'chip',
                      {
                        'chip--live': m.data.status === 'live',
                        'chip--draft': m.data.status === 'draft',
                      },
                    ]}
                  >
                    {statusLabel[m.data.status]}
                  </span>
                  {ls.length > 0 && (
                    <span
                      class="chip module__progress"
                      data-progress-count
                      data-module={m.id}
                      data-lessons={ls.map((l) => l.id.split('/')[1]).join(',')}
                      aria-label="Lecciones completadas"
                    >
                      0/{ls.length}
                    </span>
                  )}
                </div>
                <h3 class="module__title">{m.data.title}</h3>
                <p class="module__summary pretty">{m.data.summary}</p>
                <p class="label label--plain module__label">Al terminar funciona</p>
                <ul class="module__outcomes">
                  {m.data.outcomes.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
                {m.data.artifacts.length > 0 && (
                  <ul class="module__artifacts">
                    {m.data.artifacts.map((a) => (
                      <li class="chip">
                        {a.href ? (
                          <a href={a.href} rel="noopener">
                            {a.kind} · {a.label}
                          </a>
                        ) : (
                          <span>
                            {a.kind} · {a.label}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="module__lessons">
                  {ls.length > 0 ? (
                    <ol class="lessons">
                      {ls.map((l) => (
                        <li
                          class="lessons__item"
                          data-progress-lesson
                          data-module={m.id}
                          data-lesson={l.id.split('/')[1]}
                        >
                          <a class="lessons__link" href={`/curso/${l.id}/`}>
                            <span class="mono lessons__n">
                              {String(l.data.order).padStart(2, '0')}
                            </span>
                            <span class="lessons__title">{l.data.title}</span>
                            <span class="caption lessons__meta">{l.data.duration} min</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <p class="caption">Lecciones en cuanto se cierre el hito.</p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </main>
  <script>
    import '../../scripts/progress';
  </script>
</Base>

<style>
  .intro {
    padding-bottom: clamp(48px, 8vh, 96px);
  }

  .intro .label {
    margin-bottom: 20px;
  }

  .phase__title {
    margin: -16px 0 28px;
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .modules {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    margin: 0;
    padding: 1px;
    list-style: none;
  }

  .module {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: var(--frame-bg);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .module__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .module__id {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    padding: 2px 8px;
    background: var(--ink);
    color: var(--paper);
  }

  .module__hours {
    font-size: 12px;
    color: var(--muted);
  }

  .module__progress {
    margin-left: auto;
    min-width: 44px;
    justify-content: center;
  }

  .module__progress.is-complete {
    border-color: var(--ok);
    color: var(--ok);
  }

  .module__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .module__summary {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .module__label {
    margin-top: 4px;
  }

  .module__outcomes {
    display: grid;
    gap: 6px;
    padding-left: 1.1em;
    list-style: square;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .module__outcomes :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .module__artifacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .module__artifacts a {
    color: inherit;
    text-decoration: none;
  }

  .module__artifacts a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .module__lessons {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
  }

  .lessons {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .lessons__link {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 6px 0;
    color: var(--ink);
    text-decoration: none;
  }

  .lessons__link:hover .lessons__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .lessons__n {
    font-size: 11px;
    color: var(--muted);
  }

  .lessons__item.is-done .lessons__n {
    color: var(--ok);
  }

  .lessons__item.is-done .lessons__n::after {
    content: ' ✓';
  }

  .lessons__title {
    font-size: 15px;
    font-weight: 500;
  }
</style>
