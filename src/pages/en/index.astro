---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getDictionary } from '../../i18n';
import { SITE } from '../../lib/site';

const t = getDictionary('en');
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  lang="en"
  path="/en/"
  alternate={{ lang: 'es', path: '/' }}
>
  <main id="main" class="page container">
    <section class="section hero">
      <p class="label label--accent">// {t.landing.kicker}</p>
      <h1 class="hero__title">{t.landing.title}</h1>
      <p class="body hero__lead pretty">{t.landing.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/proyecto/">
          {t.landing.ctaProject}
        </a>
        <a class="btn btn--secondary" href={SITE.demoUrl} rel="noopener">
          {t.landing.ctaPlay}
        </a>
        <a class="hero__course mono" href="/curso/" hreflang="es">
          {t.landing.ctaCourse} →
        </a>
      </div>
    </section>

    <section class="section" aria-labelledby="why-title">
      <SectionHead n="01" label={t.landing.whyKicker} kind="design criteria" />
      <h2 id="why-title" class="section__title section__title--narrow">
        {t.landing.whyTitle}
      </h2>
      <ul class="why">
        {t.landing.why.map((item, i) => (
          <li class="why__item">
            <span class="mono why__n">0{i + 1}</span>
            <h3 class="why__title">{item.title}</h3>
            <p class="why__body pretty">{item.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="repos-title">
      <SectionHead n="02" label={t.project.repos.title} kind="open source" />
      <h2 id="repos-title" class="section__title section__title--narrow">
        {t.project.title}
      </h2>
      <ul class="repos">
        {t.project.repos.items.map((r) => (
          <li class="repos__item">
            <a class="repos__name mono" href={r.href} rel="noopener">
              borja-glez/{r.name}
            </a>
            <p class="repos__role">{r.role}</p>
          </li>
        ))}
      </ul>
      <div class="hero__actions">
        <a class="btn btn--secondary" href={SITE.hfUrl} rel="noopener">
          {t.project.links.hub}
        </a>
        <a class="btn btn--secondary" href="/proyecto/">
          Full project page →
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: var(--section-gap);
  }

  .hero__title {
    max-width: 16ch;
    font-size: clamp(40px, 6.5vw, 92px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: pretty;
  }

  .hero__lead {
    max-width: 62ch;
    font-size: clamp(17px, 1.4vw, 20px);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 8px;
  }

  .hero__course {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .hero__course:hover {
    color: var(--ink);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    padding: 1px;
    margin-top: 40px;
  }

  .why__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    box-shadow: 0 0 0 1px var(--line);
    background: var(--frame-bg);
  }

  .why__n {
    font-size: 11px;
    color: var(--accent-text);
  }

  .why__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .why__body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .repos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    padding: 1px;
    margin: 32px 0;
  }

  .repos__item {
    padding: 18px 20px;
    box-shadow: 0 0 0 1px var(--line);
    background: var(--frame-bg);
  }

  .repos__name {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 13px;
    color: var(--ink);
  }

  .repos__role {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
</style>
