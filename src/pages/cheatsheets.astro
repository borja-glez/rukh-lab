---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const sheets = await getCollection('cheatsheets');
const byModule = new Map(sheets.map((s) => [s.data.module, s]));
const published = modules.filter((m) => byModule.has(m.id));
const questions = published.reduce(
  (acc, m) => acc + (byModule.get(m.id)?.data.items.length ?? 0),
  0,
);
---

<Base
  title="Cheatsheets"
  description="Preguntas de entrevista con respuesta corta, una hoja por módulo del curso Rukh. Imprimible."
  path="/cheatsheets/"
>
  <main id="main" class="page container">
    <section class="section intro">
      <p class="label label--accent">
        // cheatsheets · {published.length} módulos · {questions} preguntas
      </p>
      <h1 class="section__title section__title--narrow">Lo que te preguntarían, en corto.</h1>
      <p class="body section__lead pretty">
        Al final de cada módulo, ocho preguntas de entrevista con la respuesta que darías en un
        minuto. Esta página está pensada para imprimirse.
      </p>
      <div class="intro__actions no-print">
        <button class="btn btn--secondary" type="button" data-print>
          Imprimir
        </button>
      </div>
    </section>

    {published.map((m) => {
      const sheet = byModule.get(m.id);
      if (!sheet) return null;
      return (
        <section class="sheet" id={m.id} aria-labelledby={`${m.id}-title`}>
          <p class="label label--ink">// {m.id.toUpperCase()}</p>
          <h2 id={`${m.id}-title`} class="sheet__title">
            {m.data.title}
          </h2>
          <ol class="sheet__list">
            {sheet.data.items.map((item) => (
              <li class="sheet__item">
                <p class="sheet__q">{item.q}</p>
                <p class="sheet__a">{item.a}</p>
              </li>
            ))}
          </ol>
        </section>
      );
    })}
  </main>
  <script>
    document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => {
      window.print();
    });
  </script>
</Base>

<style>
  .intro {
    padding-bottom: clamp(40px, 6vh, 72px);
  }

  .intro .label {
    margin-bottom: 20px;
  }

  .intro__actions {
    margin-top: 24px;
  }

  .sheet {
    max-width: 80ch;
    padding: 32px 0 48px;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 16px);
    break-inside: avoid;
  }

  .sheet__title {
    margin: 8px 0 24px;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .sheet__list {
    margin: 0;
    padding-left: 1.6em;
    display: grid;
    gap: 18px;
    font-family: var(--font-mono);
  }

  .sheet__item {
    break-inside: avoid;
  }

  .sheet__item::marker {
    color: var(--accent-text-aa);
    font-size: 12px;
  }

  .sheet__q {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  .sheet__a {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media print {
    .intro {
      padding-bottom: 16px;
    }

    .section__title {
      font-size: 24pt;
    }

    .sheet {
      padding: 12pt 0 18pt;
      max-width: none;
    }

    .sheet__title {
      font-size: 16pt;
    }

    .sheet__q,
    .sheet__a {
      color: #000;
      font-size: 10.5pt;
    }
  }
</style>
