---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term, 'es'),
);
---

<Base
  title="Glosario"
  description="Los términos del curso Rukh explicados con el proyecto: token, decoder, encoder, Elo, UCI, SAN, FEN, PGN, Stockfish, MLflow, fine-tuning, LoRA, RLVR, RAG, agente y más."
  path="/glosario/"
>
  <main id="main" class="page container">
    <section class="section intro">
      <p class="label label--accent">// glosario · {terms.length} términos</p>
      <h1 class="section__title section__title--narrow">Las palabras, con el proyecto delante.</h1>
      <p class="body section__lead pretty">
        Cada término se define con lo que hace en Rukh, no en abstracto. Las lecciones enlazan aquí
        desde el texto subrayado.
      </p>
    </section>

    <dl class="glossary">
      {terms.map((t) => (
        <div class="glossary__item" id={t.id}>
          <dt class="glossary__term">
            <a class="glossary__anchor" href={`#${t.id}`}>
              {t.data.term}
            </a>
            <span class="glossary__meta">
              <a class="chip" href={`/curso/#${t.data.module}`}>
                {t.data.module.toUpperCase()}
              </a>
              {t.data.aliases.length > 0 && (
                <span class="caption">{t.data.aliases.join(' · ')}</span>
              )}
            </span>
          </dt>
          <dd class="glossary__def body pretty">{t.data.definition}</dd>
        </div>
      ))}
    </dl>
  </main>
</Base>

<style>
  .intro {
    padding-bottom: clamp(40px, 6vh, 72px);
  }

  .intro .label {
    margin-bottom: 20px;
  }

  .glossary {
    margin: 0;
    max-width: 80ch;
    border-top: 1px solid var(--line);
  }

  .glossary__item {
    padding: 24px 0;
    border-bottom: 1px solid var(--line-soft);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .glossary__item:target {
    box-shadow: inset 3px 0 0 var(--accent);
    padding-left: 16px;
  }

  .glossary__term {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .glossary__anchor {
    color: var(--ink);
    text-decoration: none;
  }

  .glossary__anchor:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }

  .glossary__meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .glossary__meta .chip {
    text-decoration: none;
  }

  .glossary__def {
    margin: 10px 0 0;
    max-width: 72ch;
  }

  .glossary__def :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
