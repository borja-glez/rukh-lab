---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Esta ruta no existe." path="/404/">
  <main id="main" class="notfound container">
    <p class="label">// 404 · casilla fuera del tablero</p>
    <h1 class="notfound__title">Esta ruta no existe.</h1>
    <p class="notfound__body">Ninguna casilla del sitio tiene esa dirección.</p>
    <div class="notfound__actions">
      <a class="btn btn--primary" href="/">
        Volver al inicio
      </a>
      <a class="btn btn--secondary" href="/curso/">
        Ir al curso
      </a>
    </div>
  </main>
</Base>

<style>
  .notfound {
    min-height: calc(100vh - 200px);
    padding-top: calc(var(--header-h) + 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }

  .notfound__title {
    font-size: clamp(40px, 7vw, 96px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .notfound__body {
    font-size: var(--text-body);
    color: var(--ink-2);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>
