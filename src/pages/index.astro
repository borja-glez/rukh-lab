---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import FigureFrame from '../components/FigureFrame.astro';
import { getDictionary } from '../i18n';
import { formatHours, moduleTime } from '../lib/hours';
import { SITE } from '../lib/site';

const t = getDictionary('es');
const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const lessons = await getCollection('lessons');
const lessonIds = (moduleId: string) =>
  lessons.filter((l) => l.data.module === moduleId).map((l) => l.id.split('/')[1]);
const firstLesson = lessons
  .filter((l) => l.data.module === 'm0')
  .sort((a, b) => a.data.order - b.data.order)[0];
const startHref = firstLesson ? `/curso/${firstLesson.id}/` : '/curso/';
---

<Base title={t.meta.title} description={t.meta.description} path="/">
  <main id="main" class="page container">
    <section class="section hero">
      <p class="label label--accent">// {t.landing.kicker}</p>
      <h1 class="hero__title">{t.landing.title}</h1>
      <p class="body hero__lead pretty">{t.landing.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={startHref}>
          {t.landing.ctaCourse}
        </a>
        <a class="btn btn--secondary" href={SITE.demoUrl} rel="noopener">
          {t.landing.ctaPlay}
        </a>
        <a class="hero__project mono" href="/proyecto/">
          {t.landing.ctaProject} →
        </a>
      </div>
    </section>

    <section class="section" aria-labelledby="why-title">
      <SectionHead n="01" label={t.landing.whyKicker} kind="criterios" />
      <h2 id="why-title" class="section__title section__title--narrow">
        {t.landing.whyTitle}
      </h2>
      <ul class="why">
        {t.landing.why.map((item, i) => (
          <li class="why__item">
            <span class="mono why__n">0{i + 1}</span>
            <h3 class="why__title">{item.title}</h3>
            <p class="why__body pretty">{item.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="map-title">
      <SectionHead n="02" label={t.landing.mapKicker} kind={`${modules.length} módulos`} />
      <h2 id="map-title" class="section__title section__title--narrow">
        {t.landing.mapTitle}
      </h2>
      <p class="body section__lead pretty">{t.landing.mapLead}</p>
      <div class="map">
        {[1, 2].map((phase) => (
          <div class="map__phase">
            <p class="label label--ink map__phase-title">
              {phase === 1 ? t.landing.phase1 : t.landing.phase2}
            </p>
            <ol class="map__list">
              {modules
                .filter((m) => m.data.phase === phase)
                .map((m) => {
                  const ids = lessonIds(m.id);
                  const time = moduleTime(m, lessons);
                  return (
                    <li class="map__row">
                      <a class="map__link" href={`/curso/#${m.id}`}>
                        <span class="mono map__id">{m.id.toUpperCase()}</span>
                        <span class="map__title">{m.data.title}</span>
                        <span class="caption map__hours">{formatHours(time.work)}</span>
                        {/*
                          Only the unfinished states get a chip (see src/pages/curso/index.astro).
                          A published module still emits the empty cell: the row is a five-column
                          grid, and dropping the element would slide the progress counter out of
                          its track.
                        */}
                        <span class="map__status">
                          {m.data.status === 'live' ? (
                            ''
                          ) : (
                            <span class="chip">{t.landing.status[m.data.status]}</span>
                          )}
                        </span>
                        <span
                          class="mono map__progress"
                          data-progress-count={ids.length > 0 ? '' : undefined}
                          data-module={m.id}
                          data-lessons={ids.join(',')}
                        >
                          {ids.length > 0 ? `0/${ids.length}` : '—'}
                        </span>
                      </a>
                    </li>
                  );
                })}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="play-title">
      <SectionHead n="03" label={t.landing.playKicker} kind="rukh.borjaglez.com" />
      <div class="two-col">
        <div>
          <h2 id="play-title" class="section__title section__title--narrow">
            {t.landing.playTitle}
          </h2>
          <p class="body section__lead pretty">{t.landing.playLead}</p>
          <div class="play__actions">
            <a class="btn btn--primary" href={SITE.demoUrl} rel="noopener">
              {t.landing.playCta}
            </a>
          </div>
        </div>
        <FigureFrame>
          <svg class="board" viewBox="0 0 8 8" role="img" aria-label="Tablero de ajedrez">
            {Array.from({ length: 64 }, (_, i) => {
              const x = i % 8;
              const y = Math.floor(i / 8);
              return (
                <rect x={x} y={y} width="1" height="1" class={(x + y) % 2 ? 'dark' : 'light'} />
              );
            })}
            <path
              class="rook"
              transform="translate(4.1 3.1) scale(0.0125)"
              d="M16 8h8v8h6V8h4v8h6V8h8v14l-4 4v22l4 4v4H16v-4l4-4V26l-4-4Zm10 20v20h12V28Z"
            ></path>
          </svg>
        </FigureFrame>
      </div>
    </section>
  </main>
  <script>
    import '../scripts/progress';
  </script>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: var(--section-gap);
  }

  .hero__title {
    max-width: 16ch;
    font-size: clamp(40px, 6.5vw, 92px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: pretty;
  }

  .hero__lead {
    max-width: 62ch;
    font-size: clamp(17px, 1.4vw, 20px);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 8px;
  }

  .hero__project {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .hero__project:hover {
    color: var(--ink);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    padding: 1px;
    margin-top: 40px;
  }

  .why__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    box-shadow: 0 0 0 1px var(--line);
    background: var(--frame-bg);
  }

  .why__n {
    font-size: 11px;
    color: var(--accent-text-aa);
  }

  .why__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .why__body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .map {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(24px, 4vw, 48px);
    margin-top: 40px;
  }

  .map__phase-title {
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .map__list {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .map__row {
    border-bottom: 1px solid var(--line-soft);
  }

  .map__link {
    display: grid;
    grid-template-columns: 36px 1fr auto auto 44px;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 8px 0;
    color: var(--ink);
    text-decoration: none;
  }

  .map__link:hover {
    background: var(--hover-soft);
  }

  .map__id {
    font-size: 11px;
    color: var(--muted);
  }

  .map__title {
    font-size: 15px;
    font-weight: 500;
  }

  .map__hours {
    white-space: nowrap;
  }

  .map__progress {
    font-size: 11px;
    text-align: right;
    color: var(--muted);
  }

  .map__progress.is-complete {
    color: var(--ok);
  }

  .play__actions {
    margin-top: 28px;
  }

  .board {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 1;
  }

  .board .light {
    fill: var(--paper);
  }

  .board .dark {
    fill: var(--split-5);
  }

  .board .rook {
    fill: var(--ink);
  }

  @media (max-width: 720px) {
    .map__link {
      grid-template-columns: 36px 1fr 44px;
    }

    .map__hours,
    .map__status {
      display: none;
    }
  }
</style>
