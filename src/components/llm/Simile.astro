---
/**
 * "En la vida real": the everyday comparison that carries a chapter of /como-funciona-un-llm/.
 * A note, not a landmark, for the same reason as Callout: a page with fifteen of them would be
 * fifteen landmarks with one name.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="llm-simile" role="note" aria-label={`En la vida real: ${title}`}>
  <p class="llm-simile__head">
    <span class="label llm-simile__kind">// En la vida real</span>
    <span class="llm-simile__title">{title}</span>
  </p>
  <div class="llm-simile__body">
    <slot />
  </div>
</aside>
