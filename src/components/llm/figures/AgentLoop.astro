---
/**
 * An agent is a language model in a loop: it decides what to do, calls a tool, reads what came
 * back and decides again, until it can answer. RAG is the one-lap version where the tool is a
 * search over documents and the lap always happens before answering.
 *
 * Animated: a marker goes round the loop twice-ish and leaves through the answer. Without motion
 * the loop and its four stations are the figure; the marker exists only to move.
 */
const L = 90;
const R = 470;
const T = 44;
const B = 156;
const stations = [
  { x: L, y: T, lines: ['el modelo', 'decide el paso'] },
  { x: R, y: T, lines: ['llama a una', 'herramienta'] },
  { x: R, y: B, lines: ['la herramienta', 'devuelve algo'] },
  { x: L, y: B, lines: ['el resultado entra', 'en el contexto'] },
];
const bw = 150;
const bh = 44;
---

<svg
  class="llm-agent"
  viewBox="0 0 660 220"
  role="img"
  aria-label="El bucle de un agente. El modelo decide el siguiente paso; llama a una herramienta, como un buscador, un motor de ajedrez o una calculadora; la herramienta devuelve un resultado; ese resultado entra en el contexto del modelo, que vuelve a decidir. El bucle se repite hasta que el modelo tiene bastante y responde. RAG es la versión de una sola vuelta en la que la herramienta es una búsqueda en documentos."
>
  <g font-family="var(--font-mono)" font-size="10.5">
    <rect
      x={L + bw / 2}
      y={T + bh / 2}
      width={R - L}
      height={B - T}
      fill="none"
      stroke="var(--diagram-stroke)"
      stroke-dasharray="4 4"
    />
    {stations.map((s) => (
      <g>
        <rect x={s.x} y={s.y} width={bw} height={bh} fill="var(--box-fill)" stroke="var(--ink)" />
        {s.lines.map((line, k) => (
          <text x={s.x + 10} y={s.y + 18 + k * 15} fill={k === 0 ? 'var(--ink)' : 'var(--ink-2)'}>
            {line}
          </text>
        ))}
      </g>
    ))}
    <text x={R + bw / 2} y={T - 10} text-anchor="middle" fill="var(--muted)">
      buscador · motor · código
    </text>
    <line
      x1={L}
      y1={T + bh / 2}
      x2="22"
      y2={T + bh / 2}
      stroke="var(--accent-text-aa)"
      stroke-width="2"
    />
    <polygon
      points={`16,${T + bh / 2} 24,${T + bh / 2 - 5} 24,${T + bh / 2 + 5}`}
      fill="var(--accent-text-aa)"
    />
    <text x="16" y={T - 10} fill="var(--accent-text-aa)">
      responde
    </text>
    <circle
      class="llm-agent__mark"
      cx={L + bw / 2}
      cy={T + bh / 2}
      r="7"
      fill="var(--accent)"
      stroke="var(--ink)"
    />
  </g>
</svg>

<style>
  .llm-agent__mark {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-agent__mark {
      animation: llm-agent-lap 10s linear infinite;
    }
  }

  /* Two laps round the 380 × 112 loop, then out to the left through "responde". */
  @keyframes llm-agent-lap {
    0% {
      opacity: 1;
      transform: translate(0, 0);
    }
    13% {
      transform: translate(380px, 0);
    }
    20% {
      transform: translate(380px, 112px);
    }
    33% {
      transform: translate(0, 112px);
    }
    40% {
      transform: translate(0, 0);
    }
    53% {
      transform: translate(380px, 0);
    }
    60% {
      transform: translate(380px, 112px);
    }
    73% {
      transform: translate(0, 112px);
    }
    80% {
      opacity: 1;
      transform: translate(0, 0);
    }
    90% {
      opacity: 1;
      transform: translate(-143px, 0);
    }
    95%,
    100% {
      opacity: 0;
      transform: translate(-143px, 0);
    }
  }
</style>
