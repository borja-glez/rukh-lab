---
/**
 * Backpropagation on the tiny network of chapter 1, drawn in the same language (thickness is the
 * size of a weight, a dashed line is a negative one). Three numbers in, two small layers, one
 * number out that is compared with the one it should have been.
 *
 * Animated, in three phases over a 12 s loop:
 *   1. forward: the signal runs left to right, layer by layer, and the output lights up;
 *   2. backward: the error runs right to left in another colour, layer by layer, and as it passes
 *      each weight gets a small arrow saying which way to move, sized by its share of the blame;
 *   3. update: every weight changes thickness a little, the old drawing fading under the new one.
 * Without motion the figure keeps what tells the story: the network, the error and every blame
 * arrow, with the legend naming both directions. The weights and blames are made up (seeded, so
 * the drawing is stable) and the caption says so.
 */
const layers = [
  { x: 90, n: 3, name: 'entrada' },
  { x: 270, n: 4, name: 'capa 1' },
  { x: 450, n: 3, name: 'capa 2' },
  { x: 610, n: 1, name: 'salida' },
];
const top = 70;
const bottom = 232;
const ys = (n: number) =>
  Array.from({ length: n }, (_, i) =>
    n === 1 ? (top + bottom) / 2 : top + ((bottom - top) * i) / (n - 1),
  );

let seed = 11;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

const edges = layers.slice(0, -1).flatMap((layer, l) => {
  const next = layers[l + 1];
  return ys(layer.n).flatMap((y1) =>
    ys(next.n).map((y2) => {
      const w = rand() * 4 - 1.6;
      const blame = rand() * 2 - 1;
      /* The update moves each weight against its blame: a little thicker or thinner. */
      const after = w - blame * 0.9;
      return { l, x1: layer.x + 16, y1, x2: next.x - 16, y2, w, blame, after };
    }),
  );
});

const thick = (w: number) => 0.6 + Math.abs(w) * 1.1;
const stroke = (w: number) => (w < 0 ? 'var(--accent-text-aa)' : 'var(--split-4)');
const dash = (w: number) => (w < 0 ? '5 4' : undefined);

/* A blame arrow sits at the middle of its line: up to raise the weight, down to lower it. */
const arrow = (e: (typeof edges)[number]) => {
  const cx = (e.x1 + e.x2) / 2;
  const cy = (e.y1 + e.y2) / 2;
  const s = 3 + Math.abs(e.blame) * 5;
  const up = e.blame < 0;
  return up
    ? `M ${cx - s} ${cy + s * 0.6} L ${cx} ${cy - s * 0.8} L ${cx + s} ${cy + s * 0.6} Z`
    : `M ${cx - s} ${cy - s * 0.6} L ${cx} ${cy + s * 0.8} L ${cx + s} ${cy - s * 0.6} Z`;
};

const inputs = ['0,8', '0,3', '1,0'];
const outY = ys(1)[0];
const phases = [
  { x: 90, text: '1 · hacia delante: la señal' },
  { x: 330, text: '2 · hacia atrás: la culpa' },
  { x: 560, text: '3 · cada peso se ajusta' },
];
---

<svg
  class="llm-bp"
  viewBox="0 0 820 320"
  role="img"
  aria-label="Retropropagación en una red diminuta: tres números de entrada, dos capas pequeñas y una salida. Hacia delante, la señal recorre la red de izquierda a derecha y la salida predice 0,9 cuando debía dar 0,4: se pasa por 0,5. Hacia atrás, ese error recorre la red de derecha a izquierda, capa a capa, y cada peso recibe una flecha que dice si debe subir o bajar, más grande cuanta más culpa tiene del error. Al final cada peso cambia un poco de grosor. Los pesos y las culpas son de ejemplo."
>
  <g font-family="var(--font-mono)">
    {phases.map((p, i) => (
      <text
        class={`llm-bp__phase llm-bp__phase--${i}`}
        x={p.x}
        y="22"
        font-size="11"
        fill="var(--ink)"
      >
        {p.text}
      </text>
    ))}

    {layers.map((layer) => (
      <text x={layer.x} y="50" font-size="10.5" text-anchor="middle" fill="var(--muted)">
        {layer.name}
      </text>
    ))}

    <!-- the weights before the update, and after it (shown only in phase 3) -->
    {edges.map((e) => (
      <line
        class="llm-bp__w"
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        stroke={stroke(e.w)}
        stroke-opacity="0.75"
        stroke-width={thick(e.w)}
        stroke-dasharray={dash(e.w)}
      />
    ))}
    {edges.map((e) => (
      <line
        class="llm-bp__w-new"
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        stroke={stroke(e.after)}
        stroke-width={thick(e.after)}
        stroke-dasharray={dash(e.after)}
      />
    ))}

    <!-- forward signal and backward blame -->
    {edges.map((e) => (
      <line
        class={`llm-bp__fwd llm-bp__fwd--${e.l}`}
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        pathLength="100"
        stroke="var(--accent)"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-dasharray="6 200"
      />
    ))}
    {edges.map((e) => (
      <line
        class={`llm-bp__back llm-bp__back--${e.l}`}
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        pathLength="100"
        stroke="var(--event-text-aa)"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-dasharray="6 200"
      />
    ))}

    {edges.map((e) => (
      <path
        class={`llm-bp__blame llm-bp__blame--${e.l}`}
        d={arrow(e)}
        fill="var(--event-text-aa)"
        stroke="var(--box-fill)"
        stroke-width="1"
      />
    ))}

    {layers.map((layer, l) =>
      ys(layer.n).map((y, i) => (
        <g>
          <circle
            class={`llm-bp__node llm-bp__node--${l}`}
            cx={layer.x}
            cy={y}
            r="16"
            fill="var(--box-fill)"
            stroke="var(--ink)"
          />
          {l === 0 && (
            <text x={layer.x} y={y + 4} font-size="11" text-anchor="middle" fill="var(--ink)">
              {inputs[i]}
            </text>
          )}
          {l === layers.length - 1 && (
            <text x={layer.x} y={y + 4} font-size="11" text-anchor="middle" fill="var(--ink)">
              0,9
            </text>
          )}
        </g>
      )),
    )}

    <g class="llm-bp__error">
      <rect
        x="652"
        y={outY - 44}
        width="156"
        height="88"
        fill="color-mix(in srgb, var(--event) 12%, var(--box-fill))"
        stroke="var(--event-text-aa)"
      ></rect>
      <text x="664" y={outY - 22} font-size="11" fill="var(--ink)">
        predice 0,9
      </text>
      <text x="664" y={outY - 4} font-size="11" fill="var(--ink)">
        quería 0,4
      </text>
      <text x="664" y={outY + 22} font-size="12" font-weight="500" fill="var(--event-text-aa)">
        error: se pasa 0,5
      </text>
    </g>

    <g font-size="10.5" fill="var(--muted)">
      <line x1="90" y1="288" x2="120" y2="288" stroke="var(--accent)" stroke-width="3.5"></line>
      <text x="128" y="292">
        señal hacia delante
      </text>
      <line
        x1="300"
        y1="288"
        x2="330"
        y2="288"
        stroke="var(--event-text-aa)"
        stroke-width="3.5"
      ></line>
      <text x="338" y="292">
        culpa hacia atrás
      </text>
      <path d="M 510 293 L 516 283 L 522 293 Z" fill="var(--event-text-aa)"></path>
      <path d="M 528 283 L 534 293 L 540 283 Z" fill="var(--event-text-aa)"></path>
      <text x="548" y="292">
        subir o bajar el peso
      </text>
      <text x="548" y="308">
        (tamaño = cuánta culpa)
      </text>
    </g>
  </g>
</svg>

<style>
  .llm-bp__fwd,
  .llm-bp__back,
  .llm-bp__w-new {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-bp__fwd--0 {
      animation: llm-bp-fwd-0 12s linear infinite;
    }
    .llm-bp__fwd--1 {
      animation: llm-bp-fwd-1 12s linear infinite;
    }
    .llm-bp__fwd--2 {
      animation: llm-bp-fwd-2 12s linear infinite;
    }
    .llm-bp__back--2 {
      animation: llm-bp-back-2 12s linear infinite;
    }
    .llm-bp__back--1 {
      animation: llm-bp-back-1 12s linear infinite;
    }
    .llm-bp__back--0 {
      animation: llm-bp-back-0 12s linear infinite;
    }
    .llm-bp__blame--2 {
      animation: llm-bp-blame-2 12s linear infinite;
    }
    .llm-bp__blame--1 {
      animation: llm-bp-blame-1 12s linear infinite;
    }
    .llm-bp__blame--0 {
      animation: llm-bp-blame-0 12s linear infinite;
    }
    .llm-bp__node--3 {
      animation: llm-bp-out 12s linear infinite;
    }
    .llm-bp__error {
      animation: llm-bp-error 12s linear infinite;
    }
    .llm-bp__w {
      animation: llm-bp-old 12s linear infinite;
    }
    .llm-bp__w-new {
      animation: llm-bp-new 12s linear infinite;
    }
    .llm-bp__phase--0 {
      animation: llm-bp-phase-0 12s linear infinite;
    }
    .llm-bp__phase--1 {
      animation: llm-bp-phase-1 12s linear infinite;
    }
    .llm-bp__phase--2 {
      animation: llm-bp-phase-2 12s linear infinite;
    }
  }

  /* Phase 1, forward: 6 → −100 carries the dash from the start of every line past its end. */
  @keyframes llm-bp-fwd-0 {
    0%,
    2% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
    3% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    10% {
      opacity: 1;
      stroke-dashoffset: -100;
    }
    11%,
    100% {
      opacity: 0;
      stroke-dashoffset: -100;
    }
  }

  @keyframes llm-bp-fwd-1 {
    0%,
    11% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
    12% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    19% {
      opacity: 1;
      stroke-dashoffset: -100;
    }
    20%,
    100% {
      opacity: 0;
      stroke-dashoffset: -100;
    }
  }

  @keyframes llm-bp-fwd-2 {
    0%,
    20% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
    21% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    28% {
      opacity: 1;
      stroke-dashoffset: -100;
    }
    29%,
    100% {
      opacity: 0;
      stroke-dashoffset: -100;
    }
  }

  /* Phase 2, backward: −94 → 6 carries the dash from the end of every line back to its start. */
  @keyframes llm-bp-back-2 {
    0%,
    36% {
      opacity: 0;
      stroke-dashoffset: -94;
    }
    37% {
      opacity: 1;
      stroke-dashoffset: -94;
    }
    44% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    45%,
    100% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
  }

  @keyframes llm-bp-back-1 {
    0%,
    45% {
      opacity: 0;
      stroke-dashoffset: -94;
    }
    46% {
      opacity: 1;
      stroke-dashoffset: -94;
    }
    53% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    54%,
    100% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
  }

  @keyframes llm-bp-back-0 {
    0%,
    54% {
      opacity: 0;
      stroke-dashoffset: -94;
    }
    55% {
      opacity: 1;
      stroke-dashoffset: -94;
    }
    62% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    63%,
    100% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
  }

  /* Each layer's blame arrows appear as the wave passes and stay until the loop ends. */
  @keyframes llm-bp-blame-2 {
    0%,
    41% {
      opacity: 0;
    }
    44%,
    95% {
      opacity: 1;
    }
    99%,
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-bp-blame-1 {
    0%,
    50% {
      opacity: 0;
    }
    53%,
    95% {
      opacity: 1;
    }
    99%,
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-bp-blame-0 {
    0%,
    59% {
      opacity: 0;
    }
    62%,
    95% {
      opacity: 1;
    }
    99%,
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-bp-out {
    0%,
    27% {
      fill: var(--box-fill);
    }
    30%,
    95% {
      fill: color-mix(in srgb, var(--accent) 45%, var(--box-fill));
    }
    100% {
      fill: var(--box-fill);
    }
  }

  @keyframes llm-bp-error {
    0%,
    29% {
      opacity: 0;
    }
    33%,
    95% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Phase 3, update: the old weights fade under the new ones, then the loop starts over. */
  @keyframes llm-bp-old {
    0%,
    66% {
      opacity: 1;
    }
    74%,
    95% {
      opacity: 0.15;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-bp-new {
    0%,
    66% {
      opacity: 0;
    }
    74%,
    95% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-bp-phase-0 {
    0%,
    32% {
      opacity: 1;
    }
    35%,
    100% {
      opacity: 0.3;
    }
  }

  @keyframes llm-bp-phase-1 {
    0%,
    33% {
      opacity: 0.3;
    }
    36%,
    64% {
      opacity: 1;
    }
    67%,
    100% {
      opacity: 0.3;
    }
  }

  @keyframes llm-bp-phase-2 {
    0%,
    64% {
      opacity: 0.3;
    }
    67%,
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0.3;
    }
  }
</style>
