---
/**
 * The transformer block as a conveyor belt. The residual stream runs straight along the bottom;
 * each block has two stations that read a normalised copy of what passes (attention, which looks
 * at the other positions; the MLP, which works on this one alone) and add their correction back
 * with a "+". Nothing is replaced, everything is added. Two blocks are drawn; rukh-small stacks
 * twelve (M2 · el decoder).
 *
 * Animated: a token's vector rides the belt and grows one segment at every "+", one per station.
 * Without motion it sits at the end of the line with its four additions, which is the point.
 *
 * Two renderings: the belt runs left to right on wide screens and top to bottom on phones, where
 * the horizontal one shrinks its labels to 5 px. The hidden one is `display: none` (llm.css).
 */
const belt = 180;
const blocks = [110, 390];
const stations = blocks.flatMap((bx, b) => [
  { bx, off: 14, name: 'atención', what: 'mira a los otros', b },
  { bx, off: 134, name: 'MLP', what: 'trabaja a solas', b },
]);

/* Narrow layout: the belt is vertical at x = 40 and the four stations hang to its right. */
const vx = 40;
const vStations = stations.map((st, k) => ({ ...st, y0: 50 + k * 104 + st.b * 14 }));
const label =
  'El bloque transformer como una cinta transportadora. La corriente residual corre en línea recta y lleva el vector de cada token. Cada bloque tiene dos estaciones: la atención, que mira a las demás posiciones, y el MLP, que trabaja solo con la suya. Cada estación toma una copia normalizada de lo que pasa, calcula una corrección y la suma de vuelta a la cinta con un más. Nada se sustituye, todo se suma. Se dibujan dos bloques; rukh-small apila doce. En la versión animada el vector recorre la cinta y crece un trozo en cada suma.';
---

<svg class="llm-rb llm-wide" viewBox="0 0 720 250" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" fill="var(--ink)">
    {blocks.map((bx, i) => (
      <g>
        <rect
          x={bx - 4}
          y="30"
          width="254"
          height="196"
          fill="none"
          stroke="var(--diagram-stroke)"
          stroke-dasharray="4 4"
        />
        <text x={bx + 2} y="46" font-size="10" fill="var(--muted)">
          bloque {i + 1}
        </text>
      </g>
    ))}

    <line x1="20" y1={belt} x2="700" y2={belt} stroke="var(--ink)" stroke-width="3"></line>
    <text x="20" y="198" font-size="10" fill="var(--muted)">
      corriente residual
    </text>
    <text x="652" y="120" font-size="10" fill="var(--muted)">
      … × 12
    </text>
    <text x="652" y="134" font-size="10" fill="var(--muted)">
      en Rukh
    </text>

    {stations.map((s) => {
      const x = s.bx + s.off;
      return (
        <g>
          <line x1={x + 10} y1={belt} x2={x + 10} y2="102" stroke="var(--diagram-stroke)" />
          <rect x={x - 6} y="122" width="36" height="16" fill="var(--paper)" stroke="var(--line)" />
          <text x={x + 12} y="134" font-size="9" text-anchor="middle" fill="var(--muted)">
            norma
          </text>
          <rect
            x={x}
            y="60"
            width="106"
            height="42"
            fill={
              s.name === 'atención'
                ? 'color-mix(in srgb, var(--split-3) 22%, var(--box-fill))'
                : 'var(--box-fill)'
            }
            stroke="var(--ink)"
          />
          <text x={x + 8} y="78" font-size="12" font-family="var(--font-display)" font-weight="600">
            {s.name}
          </text>
          <text x={x + 8} y="94" font-size="9.5" fill="var(--ink-2)">
            {s.what}
          </text>
          <line x1={x + 86} y1="102" x2={x + 86} y2={belt - 12} stroke="var(--accent-text-aa)" />
          <circle
            cx={x + 86}
            cy={belt}
            r="11"
            fill="var(--paper)"
            stroke="var(--accent-text-aa)"
            stroke-width="1.5"
          />
          <text
            x={x + 86}
            y={belt + 4}
            font-size="13"
            text-anchor="middle"
            fill="var(--accent-text-aa)"
          >
            +
          </text>
        </g>
      );
    })}

    <g class="llm-rb__pkg">
      <rect x="650" y="208" width="16" height="16" fill="var(--split-3)" stroke="var(--ink)"></rect>
      {[0, 1, 2, 3].map((k) => (
        <rect
          class={`llm-rb__seg llm-rb__seg--${k}`}
          x={666 + k * 10}
          y="208"
          width="10"
          height="16"
          fill="var(--accent)"
          fill-opacity="0.85"
          stroke="var(--ink)"
        />
      ))}
    </g>
    <text x="20" y="244" font-size="10" fill="var(--muted)">
      el vector de un token viaja por la cinta →
    </text>
    <text x="700" y="244" font-size="10" text-anchor="end" fill="var(--muted)">
      con 4 correcciones sumadas
    </text>
  </g>
</svg>

<svg class="llm-rb llm-narrow" viewBox="0 0 340 520" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" fill="var(--ink)">
    {blocks.map((_, b) => (
      <g>
        <rect
          x="20"
          y={36 + b * 222}
          width="314"
          height="206"
          fill="none"
          stroke="var(--diagram-stroke)"
          stroke-dasharray="4 4"
        />
        <text x="334" y={31 + b * 222} font-size="11" text-anchor="end" fill="var(--muted)">
          bloque {b + 1}
        </text>
      </g>
    ))}

    <text x="4" y="16" font-size="11" fill="var(--muted)">
      entra el vector ↓
    </text>
    <line x1={vx} y1="22" x2={vx} y2="478" stroke="var(--ink)" stroke-width="3"></line>

    {vStations.map((st) => {
      const y = st.y0;
      return (
        <g>
          <line x1={vx} y1={y + 21} x2="124" y2={y + 21} stroke="var(--diagram-stroke)" />
          <rect x="62" y={y + 13} width="48" height="16" fill="var(--paper)" stroke="var(--line)" />
          <text x="86" y={y + 25} font-size="10" text-anchor="middle" fill="var(--muted)">
            norma
          </text>
          <rect
            x="124"
            y={y}
            width="192"
            height="44"
            fill={
              st.name === 'atención'
                ? 'color-mix(in srgb, var(--split-3) 22%, var(--box-fill))'
                : 'var(--box-fill)'
            }
            stroke="var(--ink)"
          />
          <text
            x="134"
            y={y + 19}
            font-size="14"
            font-family="var(--font-display)"
            font-weight="600"
          >
            {st.name}
          </text>
          <text x="134" y={y + 36} font-size="11" fill="var(--ink-2)">
            {st.what}
          </text>
          <path
            d={`M 220 ${y + 44} V ${y + 72} H ${vx + 11}`}
            fill="none"
            stroke="var(--accent-text-aa)"
          />
          <circle
            cx={vx}
            cy={y + 72}
            r="11"
            fill="var(--paper)"
            stroke="var(--accent-text-aa)"
            stroke-width="1.5"
          />
          <text x={vx} y={y + 77} font-size="14" text-anchor="middle" fill="var(--accent-text-aa)">
            +
          </text>
        </g>
      );
    })}

    <g class="llm-rb__vpkg">
      <rect x="32" y="486" width="16" height="16" fill="var(--split-3)" stroke="var(--ink)"></rect>
      {[0, 1, 2, 3].map((k) => (
        <rect
          class={`llm-rb__vseg llm-rb__vseg--${k}`}
          x={48 + k * 10}
          y="486"
          width="10"
          height="16"
          fill="var(--accent)"
          fill-opacity="0.85"
          stroke="var(--ink)"
        />
      ))}
    </g>
    <text x="100" y="499" font-size="11" fill="var(--muted)">
      sale con 4 correcciones
    </text>
    <text x="100" y="514" font-size="11" fill="var(--muted)">
      … × 12 bloques en Rukh
    </text>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .llm-rb__pkg {
      animation: llm-rb-ride 10s linear infinite;
    }
    .llm-rb__seg--0 {
      animation: llm-rb-seg-0 10s linear infinite;
    }
    .llm-rb__seg--1 {
      animation: llm-rb-seg-1 10s linear infinite;
    }
    .llm-rb__seg--2 {
      animation: llm-rb-seg-2 10s linear infinite;
    }
    .llm-rb__seg--3 {
      animation: llm-rb-seg-3 10s linear infinite;
    }

    .llm-rb__vpkg {
      animation: llm-rb-drop 10s linear infinite;
    }
    .llm-rb__vseg--0 {
      animation: llm-rb-vseg-0 10s linear infinite;
    }
    .llm-rb__vseg--1 {
      animation: llm-rb-vseg-1 10s linear infinite;
    }
    .llm-rb__vseg--2 {
      animation: llm-rb-vseg-2 10s linear infinite;
    }
    .llm-rb__vseg--3 {
      animation: llm-rb-vseg-3 10s linear infinite;
    }
  }

  /* Narrow: from the top of the belt to its foot in 80 % of the loop. */
  @keyframes llm-rb-drop {
    0% {
      transform: translateY(-462px);
      opacity: 1;
    }
    80%,
    94% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  /* From the start of the belt to its end in 80 % of the loop, then a pause at the end. */
  @keyframes llm-rb-ride {
    0% {
      transform: translateX(-610px);
      opacity: 1;
    }
    80%,
    94% {
      transform: translateX(0);
      opacity: 1;
    }
    100% {
      transform: translateX(0);
      opacity: 0;
    }
  }

  /* Each segment appears as the vector passes its "+" (at 22 %, 38 %, 59 % and 75 % of the ride). */
  @keyframes llm-rb-seg-0 {
    0%,
    21% {
      opacity: 0;
    }
    23%,
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-rb-seg-1 {
    0%,
    37% {
      opacity: 0;
    }
    39%,
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-rb-seg-2 {
    0%,
    58% {
      opacity: 0;
    }
    60%,
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-rb-seg-3 {
    0%,
    74% {
      opacity: 0;
    }
    76%,
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-rb-vseg-0 {
    0%,
    15% {
      opacity: 0;
    }
    17%,
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-rb-vseg-1 {
    0%,
    33% {
      opacity: 0;
    }
    35%,
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-rb-vseg-2 {
    0%,
    53% {
      opacity: 0;
    }
    55%,
    100% {
      opacity: 1;
    }
  }

  @keyframes llm-rb-vseg-3 {
    0%,
    71% {
      opacity: 0;
    }
    73%,
    100% {
      opacity: 1;
    }
  }
</style>
