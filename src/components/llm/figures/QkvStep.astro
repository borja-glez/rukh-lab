---
/**
 * One attention step, told as questions and labels: the query of «maulló» is compared with the
 * key of every word, the scores go through a softmax, and the output is the values mixed by those
 * weights. The scores are made up for the example; the weights are their real softmax.
 *
 * Animated in three beats: the scores appear, the weight bars grow, the output arrives. Without
 * motion all three are on the page at once.
 *
 * Two renderings of the same step: five columns side by side for wide screens, and one card per
 * word stacked for phones (below 600 px the wide one shrinks its labels to 6 px). Both carry the
 * same classes, so the same keyframes drive them; the hidden one is `display: none` (llm.css).
 */
import { softmax } from '../../../lib/llm/sampling';

const rows = [
  { word: 'La', key: 'artículo', score: 0.6, value: 'lo que dice «La»' },
  { word: 'gata', key: 'animal · quien actúa', score: 3.6, value: 'lo que dice «gata»' },
  { word: 'vio', key: 'otra acción', score: 0, value: 'lo que dice «vio»' },
  { word: 'maulló', key: 'soy yo', score: 0.5, value: 'lo que dice «maulló»' },
];
const weights = softmax(rows.map((r) => r.score));
const fmt = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 1 });
const top = 78;
const step = 36;
const barX = 380;
const barW = 120;

/* Narrow layout: one card per word, 64 units tall. */
const nTop = 84;
const nStep = 64;
const nBarX = 82;
const nBarW = 196;
const label = `Un paso de atención. La consulta de «maulló» pregunta quién hace la acción. Se compara con la clave de cada palabra: La, artículo, parecido ${fmt(0.6)}; gata, animal que actúa, parecido ${fmt(3.6)}; vio, otra acción, parecido 0; maulló, soy yo, parecido ${fmt(0.5)}. El softmax convierte los parecidos en porcentajes de atención que suman cien: ${weights.map((w) => Math.round(w * 100)).join(', ')} por ciento. La salida es la mezcla de los valores con esos porcentajes: casi todo lo que dice «gata».`;
---

<svg class="llm-qkv llm-wide" viewBox="0 0 700 300" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
    <rect
      x="16"
      y="12"
      width="668"
      height="32"
      fill="color-mix(in srgb, var(--accent) 22%, var(--box-fill))"
      stroke="var(--accent-text-aa)"
    ></rect>
    <text x="28" y="33" font-size="12">
      Q · consulta de «maulló»: <tspan font-weight="600">¿quién hace la acción?</tspan>
    </text>

    <text x="16" y="66" fill="var(--muted)" font-size="10">
      PALABRA
    </text>
    <text x="96" y="66" fill="var(--muted)" font-size="10">
      K · QUÉ OFRECE
    </text>
    <text x="276" y="66" fill="var(--muted)" font-size="10">
      Q·K
    </text>
    <text x={barX} y="66" fill="var(--muted)" font-size="10">
      ATENCIÓN
    </text>
    <text x="560" y="66" fill="var(--muted)" font-size="10">
      V · QUÉ ENTREGA
    </text>

    {rows.map((r, i) => {
      const y = top + i * step;
      const lead = i === 1;
      return (
        <g>
          <rect x="16" y={y} width="68" height="26" fill="var(--box-fill)" stroke="var(--line)" />
          <text x="24" y={y + 17} font-size="12">
            {r.word}
          </text>
          <text x="96" y={y + 17} fill="var(--ink-2)">
            {r.key}
          </text>
          <text class="llm-qkv__score" x="276" y={y + 17} font-weight={lead ? 600 : 400}>
            {fmt(r.score)}
          </text>
          <rect x={barX} y={y + 6} width={barW} height="14" fill="none" stroke="var(--line)" />
          <rect
            class="llm-qkv__bar"
            x={barX}
            y={y + 6}
            width={barW * weights[i]}
            height="14"
            fill={lead ? 'var(--accent)' : 'var(--split-4)'}
          />
          <text x={barX + barW + 8} y={y + 17} font-size="11">
            {Math.round(weights[i] * 100)} %
          </text>
          <text x="560" y={y + 17} fill="var(--ink-2)" font-size="10.5">
            {r.value}
          </text>
        </g>
      );
    })}

    <g class="llm-qkv__out">
      <line
        x1="620"
        y1={top + 4 * step}
        x2="620"
        y2={top + 4 * step + 18}
        stroke="var(--ink)"
      ></line>
      <path
        d={`M614 ${top + 4 * step + 12} L620 ${top + 4 * step + 20} L626 ${top + 4 * step + 12}`}
        fill="none"
        stroke="var(--ink)"
      ></path>
      <rect
        x="276"
        y={top + 4 * step + 24}
        width="408"
        height="30"
        fill="var(--box-fill)"
        stroke="var(--ink)"
      ></rect>
      <text x="288" y={top + 4 * step + 44} font-size="12">
        salida = {Math.round(weights[1] * 100)} % de «gata» + un poco del resto
      </text>
    </g>
  </g>
</svg>

<svg class="llm-qkv llm-narrow" viewBox="0 0 340 424" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" font-size="12" fill="var(--ink)">
    <rect
      x="4"
      y="4"
      width="332"
      height="50"
      fill="color-mix(in srgb, var(--accent) 22%, var(--box-fill))"
      stroke="var(--accent-text-aa)"
    ></rect>
    <text x="14" y="24">
      Q · consulta de «maulló»:
    </text>
    <text x="14" y="44" font-weight="600">
      ¿quién hace la acción?
    </text>
    <text x="4" y="74" fill="var(--muted)" font-size="10.5">
      K · QUÉ OFRECE · Q·K · ATENCIÓN
    </text>

    {rows.map((r, i) => {
      const y = nTop + i * nStep;
      const lead = i === 1;
      return (
        <g>
          <rect x="4" y={y} width="70" height="26" fill="var(--box-fill)" stroke="var(--line)" />
          <text x="11" y={y + 17} font-size="12.5">
            {r.word}
          </text>
          <text x={nBarX + 4} y={y + 17} fill="var(--ink-2)" font-size="11.5">
            {r.key}
          </text>
          <text
            class="llm-qkv__score"
            x="336"
            y={y + 17}
            text-anchor="end"
            font-weight={lead ? 600 : 400}
          >
            {fmt(r.score)}
          </text>
          <rect x={nBarX} y={y + 34} width={nBarW} height="14" fill="none" stroke="var(--line)" />
          <rect
            class="llm-qkv__bar"
            x={nBarX}
            y={y + 34}
            width={nBarW * weights[i]}
            height="14"
            fill={lead ? 'var(--accent)' : 'var(--split-4)'}
          />
          <text x="336" y={y + 46} text-anchor="end" font-size="12">
            {Math.round(weights[i] * 100)} %
          </text>
        </g>
      );
    })}

    <g class="llm-qkv__out">
      <path
        d={`M170 ${nTop + 4 * nStep - 6} V ${nTop + 4 * nStep + 10} M164 ${nTop + 4 * nStep + 4} L170 ${nTop + 4 * nStep + 12} L176 ${nTop + 4 * nStep + 4}`}
        fill="none"
        stroke="var(--ink)"
      ></path>
      <rect
        x="4"
        y={nTop + 4 * nStep + 16}
        width="332"
        height="60"
        fill="var(--box-fill)"
        stroke="var(--ink)"
      ></rect>
      <text x="14" y={nTop + 4 * nStep + 40}>
        salida = {Math.round(weights[1] * 100)} % de lo que dice «gata»
      </text>
      <text x="14" y={nTop + 4 * nStep + 60} fill="var(--ink-2)">
        + un poco del resto (V)
      </text>
    </g>
  </g>
</svg>

<style>
  .llm-qkv__bar {
    transform-box: fill-box;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-qkv__score {
      animation: llm-qkv-score 9s ease-out infinite backwards;
    }

    .llm-qkv__bar {
      animation: llm-qkv-bar 9s ease-out infinite backwards;
    }

    .llm-qkv__out {
      animation: llm-qkv-out 9s ease-out infinite backwards;
    }
  }

  @keyframes llm-qkv-score {
    0%,
    6% {
      opacity: 0;
    }
    14%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-qkv-bar {
    0%,
    24% {
      transform: scaleX(0);
    }
    40%,
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes llm-qkv-out {
    0%,
    50% {
      opacity: 0;
    }
    60%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
