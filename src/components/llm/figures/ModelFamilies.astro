---
/**
 * The three branches of the transformer family, what each is for and where Rukh has one. The
 * examples are well-known public models; the encoder-decoder branch is not built in the course.
 *
 * Static: a map of kinds, nothing happens in time.
 */
const families = [
  {
    name: 'solo decoder',
    mask: 'causal',
    examples: ['GPT, Llama,', 'Qwen, Mistral'],
    job: ['genera: escribe', 'token a token'],
    rukh: 'en Rukh: M2, el que juega',
    inCourse: true,
  },
  {
    name: 'solo encoder',
    mask: 'bidireccional',
    examples: ['BERT, RoBERTa,', 'ModernBERT'],
    job: ['representa: clasifica', 'y da embeddings'],
    rukh: 'en Rukh: M3, el que valora',
    inCourse: true,
  },
  {
    name: 'encoder-decoder',
    mask: 'mixta',
    examples: ['T5, traductores,', 'Whisper'],
    job: ['transforma: de un', 'texto a otro'],
    rukh: 'fuera del curso',
    inCourse: false,
  },
];
const w = 216;
const gap = 16;
---

<svg
  class="llm-fam"
  viewBox="0 0 700 200"
  role="img"
  aria-label="Las tres ramas de la familia transformer. Solo decoder, con máscara causal: GPT, Llama, Qwen o Mistral; genera texto token a token; en Rukh es el decoder de M2, el que juega. Solo encoder, bidireccional: BERT, RoBERTa o ModernBERT; representa, es decir, clasifica y da embeddings para buscar; en Rukh es el encoder de M3, el que valora posiciones. Encoder-decoder, que lee entero con un encoder y escribe con un decoder causal: T5, los traductores clásicos o Whisper; transforma un texto en otro; no se construye en el curso."
>
  <g font-family="var(--font-mono)" fill="var(--ink)">
    {families.map((f, i) => {
      const x = 8 + i * (w + gap);
      return (
        <g>
          <rect
            x={x}
            y="8"
            width={w}
            height="184"
            fill="var(--box-fill)"
            stroke="var(--ink)"
            stroke-dasharray={f.inCourse ? undefined : '5 4'}
          />
          <text
            x={x + 14}
            y="36"
            font-size="15"
            font-family="var(--font-display)"
            font-weight="600"
          >
            {f.name}
          </text>
          <text x={x + 14} y="54" font-size="10" fill="var(--muted)">
            máscara {f.mask}
          </text>
          {f.examples.map((line, j) => (
            <text x={x + 14} y={82 + j * 15} font-size="11" fill="var(--ink-2)">
              {line}
            </text>
          ))}
          {f.job.map((line, j) => (
            <text x={x + 14} y={126 + j * 15} font-size="11" fill="var(--ink)">
              {line}
            </text>
          ))}
          <text
            x={x + 14}
            y="178"
            font-size="10.5"
            fill={f.inCourse ? 'var(--accent-text-aa)' : 'var(--muted)'}
          >
            {f.rukh}
          </text>
        </g>
      );
    })}
  </g>
</svg>
