---
/**
 * The leash and the hack in one plot. Horizontally, how far the aligned model has drifted from
 * the frozen reference (the KL); vertically, two curves: the reward the optimiser sees, which
 * keeps climbing, and the quality we actually wanted, which rises and then falls. Past the peak
 * the model is learning the reward's loopholes, not the task: reward hacking. The shapes are
 * schematic (no run is plotted); the inverted U is what M5 measured with GRPO.
 *
 * Animated: the policy walks away from its post with the leash paying out, overshoots into the
 * hacking zone, is reeled back to the peak and finally walks home to start again. Without motion it stands at the peak, which is the
 * point of the leash.
 */
const x0 = 70;
const x1 = 600;
const yBase = 220;
const yTop = 36;
const peak = 240;
const span = x1 - x0;

const proxy = (x: number) => yBase - 160 * (1 - Math.exp(-x / 170));
const quality = (x: number) => yBase - 20 - 120 * Math.exp(-(((x - peak) / 150) ** 2));

const path = (f: (x: number) => number) =>
  Array.from({ length: 54 }, (_, i) => {
    const x = (i / 53) * span;
    return `${i === 0 ? 'M' : 'L'}${(x0 + x).toFixed(1)},${f(x).toFixed(1)}`;
  }).join(' ');

const hackFrom = x0 + peak + 120;
---

<svg
  class="llm-kl"
  viewBox="0 0 640 290"
  role="img"
  aria-label="Esquema de la correa KL y del reward hacking. En horizontal, cuánto se aleja el modelo alineado de la copia congelada de la que partió; en vertical, dos curvas. La recompensa que ve el optimizador sube sin parar cuanto más se aleja. La calidad que de verdad queríamos sube al principio, llega a un máximo y después cae. A la derecha del máximo está la zona de reward hacking: el modelo aprende los agujeros de la recompensa, no la tarea. La correa, atada a un poste en la referencia, es la penalización KL, que lo mantiene cerca del máximo."
>
  <g font-family="var(--font-mono)" font-size="10.5">
    <rect
      x={hackFrom}
      y={yTop - 8}
      width={x1 - hackFrom}
      height={yBase - yTop + 8}
      fill="color-mix(in srgb, var(--event) 10%, transparent)"
    />
    <text x={hackFrom + 10} y={yBase - 12} fill="var(--event-text-aa)">
      zona de reward hacking
    </text>

    <line x1={x0} y1={yBase} x2={x1} y2={yBase} stroke="var(--diagram-stroke)" />
    <line x1={x0} y1={yBase} x2={x0} y2={yTop - 8} stroke="var(--diagram-stroke)" />
    <text x={x0 + span / 2} y={yBase + 58} text-anchor="middle" fill="var(--muted)">
      cuánto se aleja de la referencia (KL) →
    </text>

    <path
      d={path(proxy)}
      fill="none"
      stroke="var(--split-4)"
      stroke-width="2"
      stroke-dasharray="6 4"
    />
    <text x={x1 - 4} y={proxy(span) - 10} text-anchor="end" fill="var(--ink-2)">
      recompensa que ve el optimizador
    </text>
    <path d={path(quality)} fill="none" stroke="var(--accent)" stroke-width="2.5" />
    <text x={x0 + peak} y={quality(peak) - 12} text-anchor="middle" fill="var(--accent-text-aa)">
      calidad de verdad
    </text>

    <rect x={x0 - 5} y={yBase + 12} width="10" height="26" fill="var(--ink)" />
    <text x={x0 - 8} y={yBase + 52} text-anchor="middle" fill="var(--muted)">
      poste
    </text>

    <g class="llm-kl__walker">
      <line x1={x0} y1={yTop} x2={x0} y2={yBase} stroke="var(--ink)" stroke-dasharray="2 4" />
      <circle cx={x0} cy={yBase + 25} r="9" fill="var(--accent)" stroke="var(--ink)" />
      <text x={x0} y={yBase + 29} text-anchor="middle" font-size="9" fill="var(--ink)">
        π
      </text>
    </g>
    <rect class="llm-kl__leash" x={x0} y={yBase + 24} width="1" height="2" fill="var(--ink)" />
  </g>
</svg>

<style>
  /* Parked at the peak: the leash paid out exactly that far. */
  .llm-kl__walker {
    transform: translateX(240px);
  }

  .llm-kl__leash {
    transform-box: fill-box;
    transform-origin: left center;
    transform: scaleX(240);
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-kl__walker {
      animation: llm-kl-walk 10s ease-in-out infinite;
    }

    .llm-kl__leash {
      animation: llm-kl-leash 10s ease-in-out infinite;
    }
  }

  @keyframes llm-kl-walk {
    0%,
    6% {
      transform: translateX(0);
    }
    30%,
    38% {
      transform: translateX(240px);
    }
    62%,
    70% {
      transform: translateX(500px);
    }
    88%,
    92% {
      transform: translateX(240px);
    }
    100% {
      transform: translateX(0);
    }
  }

  @keyframes llm-kl-leash {
    0%,
    6% {
      transform: scaleX(1);
    }
    30%,
    38% {
      transform: scaleX(240);
    }
    62%,
    70% {
      transform: scaleX(500);
    }
    88%,
    92% {
      transform: scaleX(240);
    }
    100% {
      transform: scaleX(1);
    }
  }
</style>
