---
/**
 * The life of a language model in seven stations: what happens in general, what it is in Rukh,
 * and what the model can do after each one. It is the map the rest of the page walks through, and
 * each station names the chapter that explains it.
 *
 * Animated: the stations light up in order, the whole column with them (box, Rukh line and the
 * gain), the arrow to the next one flashes as the step is taken, and each gain stays written once
 * earned, like a tally. The last station holds for a few seconds so the end state can be read,
 * then the loop starts over. Without motion the figure is the finished tally: every gain written,
 * every arrow drawn, nothing lit.
 *
 * The keyframes are one set per station because each has its own window in an 11 s loop
 * (1.2 s per station, the rest held on the last): a shared keyframe with staggered delays cannot
 * express "stays lit until the end of the loop".
 *
 * On phones the seven columns become seven rows read top to bottom (general, Rukh, gain side by
 * side); the rows carry the same classes, so the same keyframes light them. The hidden rendering
 * is `display: none` (llm.css).
 */
interface Props {
  /** The closing chapter reuses the map; the id only tells the two apart. */
  id?: string;
}

const { id = 'mapa' } = Astro.props;

const stations = [
  {
    name: 'Datos',
    ch: 'antes de todo',
    what: ['montañas', 'de texto'],
    rukh: ['partidas', 'de Lichess'],
    gain: ['solo hay', 'texto suelto'],
  },
  {
    name: 'Tokenizar',
    ch: 'cap. 02',
    what: ['texto →', 'números'],
    rukh: ['jugadas', 'UCI'],
    gain: ['lee números,', 'no entiende'],
  },
  {
    name: 'Preentrenar',
    ch: 'cap. 08',
    what: ['adivinar lo', 'siguiente'],
    rukh: ['decoder', 'de M2'],
    gain: ['sabe continuar', 'un texto'],
  },
  {
    name: 'Afinar',
    ch: 'cap. 11',
    what: ['imitar', 'ejemplos'],
    rukh: ['tokens de', 'Elo · LoRA'],
    gain: ['sigue', 'instrucciones'],
  },
  {
    name: 'Alinear',
    ch: 'cap. 12',
    what: ['comparar', 'respuestas'],
    rukh: ['DPO', 'y GRPO'],
    gain: ['prefiere lo', 'que elegimos'],
  },
  {
    name: 'Evaluar',
    ch: 'cap. 13',
    what: ['medir sin', 'engañarse'],
    rukh: ['Elo contra', 'Stockfish'],
    gain: ['tiene nota', 'con margen'],
  },
  {
    name: 'Servir',
    ch: 'cap. 14',
    what: ['cuantizar', 'y ejecutar'],
    rukh: ['ONNX en el', 'navegador'],
    gain: ['responde a', 'quien lo use'],
  },
];

const w = 96;
const gap = 22;
const x0 = 8;
const boxTop = 30;
const boxH = 96;
const arrowY = boxTop + boxH / 2;
const colX = (i: number) => x0 + i * (w + gap);

/* Narrow layout: one row per station. */
const rowY = (i: number) => 30 + i * 84;
const RH = 66;
const label =
  'La vida de un modelo de lenguaje en siete estaciones, en orden, con lo que es cada una en general, lo que es en Rukh y lo que el modelo sabe hacer al salir de ella. Datos: montañas de texto; en Rukh, partidas de Lichess; solo hay texto suelto. Tokenizar: texto a números; jugadas UCI; lee números pero no entiende. Preentrenar: adivinar lo siguiente; el decoder de M2; sabe continuar un texto. Afinar: imitar ejemplos; tokens de Elo y LoRA; sigue instrucciones. Alinear: comparar respuestas; DPO y GRPO; prefiere lo que elegimos. Evaluar: medir sin engañarse; Elo contra Stockfish; tiene una nota con su margen. Servir: cuantizar y ejecutar; ONNX en el navegador; responde a quien lo use. En la versión animada las estaciones se encienden por orden y cada logro queda escrito al conseguirse.';
---

<svg class="llm-map llm-wide" viewBox="0 0 820 272" role="img" aria-label={label} data-map={id}>
  <g font-family="var(--font-mono)">
    {stations.map((_, i) => (
      <rect
        class={`llm-map__col llm-map__col--${i}`}
        x={colX(i) - 5}
        y={boxTop - 6}
        width={w + 10}
        height="242"
        fill="transparent"
      />
    ))}

    <text x={x0} y="16" font-size="10" fill="var(--muted)">
      EN GENERAL
    </text>
    <text x={x0} y="152" font-size="10" fill="var(--accent-text-aa)">
      EN RUKH
    </text>
    <text x={x0} y="212" font-size="10" fill="var(--ink)">
      QUÉ SABE YA EL MODELO
    </text>

    {stations.slice(0, -1).map((_, i) => {
      const from = colX(i) + w + 4;
      const to = colX(i + 1) - 4;
      return (
        <path
          class={`llm-map__arrow llm-map__arrow--${i}`}
          d={`M ${from} ${arrowY} H ${to} M ${to - 5} ${arrowY - 4} L ${to} ${arrowY} L ${to - 5} ${arrowY + 4}`}
          fill="none"
          stroke="var(--diagram-stroke)"
          stroke-width="1.5"
        />
      );
    })}

    {stations.map((s, i) => {
      const x = colX(i);
      return (
        <g>
          <rect
            class={`llm-map__box llm-map__box--${i}`}
            x={x}
            y={boxTop}
            width={w}
            height={boxH}
            fill="var(--box-fill)"
            stroke="var(--ink)"
          />
          <text x={x + 10} y={boxTop + 18} font-size="10" fill="var(--muted)">
            {s.ch}
          </text>
          <text
            x={x + 10}
            y={boxTop + 42}
            font-size="14"
            font-weight="600"
            font-family="var(--font-display)"
            fill="var(--ink)"
          >
            {s.name}
          </text>
          {s.what.map((line, j) => (
            <text x={x + 10} y={boxTop + 64 + j * 15} font-size="10.5" fill="var(--ink-2)">
              {line}
            </text>
          ))}
          {s.rukh.map((line, j) => (
            <text x={x + 2} y={170 + j * 15} font-size="10.5" fill="var(--accent-text-aa)">
              {line}
            </text>
          ))}
          <g class={`llm-map__gain llm-map__gain--${i}`}>
            <path
              d={`M ${x + 2} 229 l 3 3 l 6 -7`}
              fill="none"
              stroke="var(--ok)"
              stroke-width="1.6"
            />
            {s.gain.map((line, j) => (
              <text
                x={x + (j === 0 ? 16 : 2)}
                y={234 + j * 15}
                font-size="10.5"
                font-weight="500"
                fill="var(--ink)"
              >
                {line}
              </text>
            ))}
          </g>
        </g>
      );
    })}
  </g>
</svg>

<svg class="llm-map llm-narrow" viewBox="0 0 340 614" role="img" aria-label={label} data-map={id}>
  <g font-family="var(--font-mono)">
