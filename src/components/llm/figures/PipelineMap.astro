    </text>
    <text x="146" y="14" font-size="9.5" fill="var(--accent-text-aa)">
      EN RUKH
    </text>
    <text x="232" y="14" font-size="9.5" fill="var(--ink)">
      QUÉ SABE YA
    </text>

    {stations.map((_, i) => (
      <rect
        class={`llm-map__col llm-map__col--${i}`}
        x="0"
        y={rowY(i) - 5}
        width="340"
        height={RH + 10}
        fill="transparent"
      />
    ))}

    {stations.slice(0, -1).map((_, i) => {
      const y1 = rowY(i) + RH + 2;
      const y2 = rowY(i + 1) - 2;
      return (
        <path
          class={`llm-map__arrow llm-map__arrow--${i}`}
          d={`M 66 ${y1} V ${y2} M 62 ${y2 - 5} L 66 ${y2} L 70 ${y2 - 5}`}
          fill="none"
          stroke="var(--diagram-stroke)"
          stroke-width="1.5"
        />
      );
    })}

    {stations.map((s, i) => {
      const y = rowY(i);
      return (
        <g>
          <rect
            class={`llm-map__box llm-map__box--${i}`}
            x="4"
            y={y}
            width="128"
            height={RH}
            fill="var(--box-fill)"
            stroke="var(--ink)"
          />
          <text x="12" y={y + 14} font-size="9.5" fill="var(--muted)">
            {s.ch}
          </text>
          <text
            x="12"
            y={y + 32}
            font-size="13.5"
            font-weight="600"
            font-family="var(--font-display)"
            fill="var(--ink)"
          >
            {s.name}
          </text>
          {s.what.map((line, j) => (
            <text x="12" y={y + 46 + j * 12} font-size="10" fill="var(--ink-2)">
              {line}
            </text>
          ))}
          {s.rukh.map((line, j) => (
            <text x="146" y={y + 26 + j * 15} font-size="10.5" fill="var(--accent-text-aa)">
              {line}
            </text>
          ))}
          <g class={`llm-map__gain llm-map__gain--${i}`}>
            <path
              d={`M 232 ${y + 21} l 3 3 l 6 -7`}
              fill="none"
              stroke="var(--ok)"
              stroke-width="1.6"
            />
            {s.gain.map((line, j) => (
              <text
                x={j === 0 ? 245 : 232}
                y={y + 26 + j * 15}
                font-size="10.5"
                font-weight="500"
                fill="var(--ink)"
              >
                {line}
              </text>
            ))}
          </g>
        </g>
      );
    })}
  </g>
</svg>

