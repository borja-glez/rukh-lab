---
/**
 * The life of a language model in seven stations, general on top and Rukh underneath: the map
 * the rest of the page walks through. Each station names the chapter that explains it.
 *
 * Animated: a pulse runs along the line and each station lights up as it passes. Without motion,
 * the seven stations sit unlit and the pulse, which exists only to move, is not drawn.
 */
interface Props {
  /** The closing chapter reuses the map with a different label. */
  id?: string;
}

const { id = 'mapa' } = Astro.props;

const stations = [
  { name: 'Datos', what: ['montañas', 'de texto'], rukh: ['partidas', 'de Lichess'], ch: '01' },
  { name: 'Tokenizar', what: ['texto →', 'números'], rukh: ['jugadas', 'UCI'], ch: '01' },
  { name: 'Preentrenar', what: ['adivinar lo', 'siguiente'], rukh: ['decoder', 'M2'], ch: '07' },
  {
    name: 'Afinar',
    what: ['seguir', 'instrucciones'],
    rukh: ['tokens de', 'Elo · LoRA'],
    ch: '10',
  },
  { name: 'Alinear', what: ['preferir', 'lo bueno'], rukh: ['DPO', 'y GRPO'], ch: '11' },
  {
    name: 'Evaluar',
    what: ['medir sin', 'engañarse'],
    rukh: ['Elo contra', 'Stockfish'],
    ch: '12',
  },
  {
    name: 'Servir',
    what: ['cuantizar', 'y ejecutar'],
    rukh: ['ONNX en el', 'navegador'],
    ch: '13',
  },
];

const w = 96;
const gap = 12;
const x0 = 8;
const top = 40;
const h = 104;
const lineY = top + h / 2;
---

<svg
  class="llm-map"
  viewBox="0 0 760 236"
  role="img"
  aria-label={`La vida de un modelo de lenguaje en siete estaciones, de izquierda a derecha: datos (montañas de texto; en Rukh, partidas de Lichess), tokenizar (texto a números; jugadas UCI), preentrenar (adivinar lo siguiente; el decoder de M2), afinar (seguir instrucciones; tokens de Elo y LoRA), alinear (preferir lo bueno; DPO y GRPO), evaluar (medir sin engañarse; Elo contra Stockfish) y servir (cuantizar y ejecutar; ONNX en el navegador).`}
  data-map={id}
>
  <line
    x1={x0}
    y1={lineY}
    x2={x0 + 7 * w + 6 * gap}
    y2={lineY}
    stroke="var(--diagram-stroke)"
    stroke-dasharray="3 5"
  ></line>
  <circle class="llm-map__pulse" cx={x0} cy={lineY} r="7" fill="var(--accent)"></circle>
  <g font-family="var(--font-mono)">
    <text x={x0} y="22" font-size="10" fill="var(--muted)">
      EN GENERAL
    </text>
    <text x={x0} y={top + h + 34} font-size="10" fill="var(--accent-text-aa)">
      EN RUKH
    </text>
    {stations.map((s, i) => {
      const x = x0 + i * (w + gap);
      return (
        <g class={`llm-map__station llm-map__station--${i}`}>
          <rect
            class="llm-map__box"
            x={x}
            y={top}
            width={w}
            height={h}
            fill="var(--box-fill)"
            stroke="var(--ink)"
          />
          <text x={x + 10} y={top + 20} font-size="10" fill="var(--muted)">
            cap. {s.ch}
          </text>
          <text
            x={x + 10}
            y={top + 44}
            font-size="14"
            font-weight="600"
            font-family="var(--font-display)"
            fill="var(--ink)"
          >
            {s.name}
          </text>
          {s.what.map((line, j) => (
            <text x={x + 10} y={top + 68 + j * 15} font-size="10.5" fill="var(--ink-2)">
              {line}
            </text>
          ))}
          {s.rukh.map((line, j) => (
            <text
              x={x + 10}
              y={top + h + 56 + j * 15}
              font-size="10.5"
              fill="var(--accent-text-aa)"
            >
              {line}
            </text>
          ))}
        </g>
      );
    })}
  </g>
</svg>

<style>
  .llm-map__pulse {
    opacity: 0;
  }

  .llm-map__box {
    transition: fill 0.2s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-map__pulse {
      animation: llm-map-pulse 8.4s linear infinite;
    }

    .llm-map__station .llm-map__box {
      animation: llm-map-light 8.4s ease-out infinite;
    }

    .llm-map__station--0 .llm-map__box {
      animation-delay: 0.45s;
    }
    .llm-map__station--1 .llm-map__box {
      animation-delay: 1.47s;
    }
    .llm-map__station--2 .llm-map__box {
      animation-delay: 2.49s;
    }
    .llm-map__station--3 .llm-map__box {
      animation-delay: 3.51s;
    }
    .llm-map__station--4 .llm-map__box {
      animation-delay: 4.53s;
    }
    .llm-map__station--5 .llm-map__box {
      animation-delay: 5.55s;
    }
    .llm-map__station--6 .llm-map__box {
      animation-delay: 6.57s;
    }
  }

  /* The pulse crosses the 744 px of line in 87 % of the loop, then rests; each station lights up
     as the pulse reaches its centre (delays above). */
  @keyframes llm-map-pulse {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    3% {
      opacity: 1;
    }
    87% {
      opacity: 1;
      transform: translateX(744px);
    }
    92%,
    100% {
      opacity: 0;
      transform: translateX(744px);
    }
  }

  @keyframes llm-map-light {
    0% {
      fill: var(--box-fill);
    }
    4% {
      fill: color-mix(in srgb, var(--accent) 35%, var(--box-fill));
    }
    14%,
    100% {
      fill: var(--box-fill);
    }
  }
</style>
