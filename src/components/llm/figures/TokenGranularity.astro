---
/**
 * The same sentence cut three ways: by characters, by whole words and by BPE pieces, with the
 * numbers the model really receives under the BPE row. The BPE cut and the ids are illustrative
 * (every tokenizer cuts differently); the point is the trade-off, which the side notes state.
 *
 * Animated: the BPE row's ids drop in under their pieces, one after another, because that
 * translation is the only thing that reaches the network. Without motion the ids are simply there.
 */
const rows = [
  {
    name: 'por letras',
    note: '28 tokens · vocabulario mínimo, secuencias larguísimas',
    pieces: [...'El gatito se subió al tejado'].map((c) => (c === ' ' ? '␣' : c)),
    w: 16,
  },
  {
    name: 'por palabras',
    note: '6 tokens · pero «gatito» o «tejadito» pueden no existir',
    pieces: ['El', 'gatito', 'se', 'subió', 'al', 'tejado'],
    w: 64,
  },
  {
    name: 'BPE',
    note: '9 tokens · trozos frecuentes; nada queda fuera',
    pieces: ['El', '␣gat', 'ito', '␣se', '␣sub', 'ió', '␣al', '␣tej', 'ado'],
    w: 48,
  },
];
const ids = [3226, 7412, 973, 409, 5230, 2894, 435, 18402, 2170];
const x0 = 120;
const gap = 3;
---

<svg
  class="llm-tg"
  viewBox="0 0 700 250"
  role="img"
  aria-label="La frase «El gatito se subió al tejado» cortada de tres maneras. Por letras: 28 caracteres, contando espacios, cada uno un token; vocabulario mínimo pero secuencias larguísimas. Por palabras: seis tokens, pero una palabra que no estaba en la lista, como gatito o tejadito, no tiene token. Con BPE: nueve trozos frecuentes, El, gat, ito, se, sub, ió, al, tej, ado, y debajo de cada uno el número entero que es lo único que recibe el modelo."
>
  <g font-family="var(--font-mono)">
    {rows.map((row, r) => {
      const y = 18 + r * 64;
      let x = x0;
      return (
        <g>
          <text x="8" y={y + 17} font-size="11" fill="var(--ink)">
            {row.name}
          </text>
          {row.pieces.map((p) => {
            const w = r === 0 ? row.w : Math.max(row.w * 0.6, p.length * 9 + 14);
            const box = (
              <g>
                <rect
                  x={x}
                  y={y}
                  width={w}
                  height="26"
                  fill={
                    r === 2
                      ? 'color-mix(in srgb, var(--accent) 24%, var(--box-fill))'
                      : 'var(--box-fill)'
                  }
                  stroke={r === 2 ? 'var(--accent-text-aa)' : 'var(--line)'}
                />
                <text
                  x={x + w / 2}
                  y={y + 17}
                  font-size="12"
                  text-anchor="middle"
                  fill="var(--ink)"
                >
                  {p}
                </text>
              </g>
            );
            x += w + gap;
            return box;
          })}
          <text x={x0} y={y + 42} font-size="10" fill="var(--muted)">
            {row.note}
          </text>
        </g>
      );
    })}
    {(() => {
      let x = x0;
      return rows[2].pieces.map((p, i) => {
        const w = Math.max(rows[2].w * 0.6, p.length * 9 + 14);
        const cx = x + w / 2;
        x += w + gap;
        return (
          <text
            class={`llm-tg__id llm-tg__id--${i}`}
            x={cx}
            y="232"
            font-size="11"
            text-anchor="middle"
            fill="var(--accent-text-aa)"
          >
            {ids[i]}
          </text>
        );
      });
    })()}
    <text x="8" y="232" font-size="11" fill="var(--accent-text-aa)">
      lo que entra
    </text>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .llm-tg__id {
      animation: llm-tg-id 6s ease-out infinite backwards;
    }
    .llm-tg__id--1 {
      animation-delay: 0.25s;
    }
    .llm-tg__id--2 {
      animation-delay: 0.5s;
    }
    .llm-tg__id--3 {
      animation-delay: 0.75s;
    }
    .llm-tg__id--4 {
      animation-delay: 1s;
    }
    .llm-tg__id--5 {
      animation-delay: 1.25s;
    }
    .llm-tg__id--6 {
      animation-delay: 1.5s;
    }
    .llm-tg__id--7 {
      animation-delay: 1.75s;
    }
    .llm-tg__id--8 {
      animation-delay: 2s;
    }
  }

  @keyframes llm-tg-id {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    8%,
    85% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
</style>
