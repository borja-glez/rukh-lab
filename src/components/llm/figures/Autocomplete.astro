---
/**
 * The whole idea of a language model in one picture: a sentence, three candidates for the next
 * word with their probabilities, and the chosen one joining the sentence. The numbers are made
 * up for the example (no model was run), and the caption says so.
 *
 * Animated: the bars grow from zero (the model "computes"), the winner lights up, and the word
 * appears in the sentence. Without motion the figure is the end state: full bars, winner lit,
 * word in place.
 */
const candidates = [
  { word: 'paraguas', p: 0.71 },
  { word: 'abrigo', p: 0.18 },
  { word: 'coche', p: 0.06 },
];
const barX = 150;
const barMax = 380;
---

<svg
  class="llm-ac"
  viewBox="0 0 640 250"
  role="img"
  aria-label="Autocompletado: el texto «Hoy llueve en Ourense, así que me llevo el» y tres candidatos para la palabra siguiente con su probabilidad: paraguas 71 %, abrigo 18 %, coche 6 %. Se elige paraguas y pasa a formar parte del texto; el modelo vuelve a empezar con la frase más larga."
>
  <g font-family="var(--font-mono)" fill="var(--ink)">
    <rect
      x="16"
      y="16"
      width="608"
      height="52"
      fill="var(--box-fill)"
      stroke="var(--diagram-stroke)"
    ></rect>
    <text x="32" y="48" font-size="15" font-family="var(--font-display)">
      Hoy llueve en Ourense, así que me llevo el
      <tspan class="llm-ac__word" font-weight="600" fill="var(--accent-text-aa)">
        paraguas
      </tspan>
    </text>

    <text x="16" y="100" font-size="11" fill="var(--muted)">
      ¿qué viene después? · probabilidad
    </text>
    {candidates.map((c, i) => (
      <g class={`llm-ac__row llm-ac__row--${i}`}>
        <text x="16" y={134 + i * 38} font-size="13">
          {c.word}
        </text>
        <rect
          x={barX}
          y={120 + i * 38}
          width={barMax}
          height="20"
          fill="none"
          stroke="var(--line)"
        />
        <rect
          class={`llm-ac__bar llm-ac__bar--${i}`}
          x={barX}
          y={120 + i * 38}
          width={barMax * c.p}
          height="20"
          fill={i === 0 ? 'var(--accent)' : 'var(--split-3)'}
          fill-opacity={i === 0 ? 0.9 : 0.55}
        />
        <text x={barX + barMax + 12} y={135 + i * 38} font-size="12">
          {Math.round(c.p * 100)} %
        </text>
      </g>
    ))}
    <text x="16" y="240" font-size="10" fill="var(--muted)">
      … y otras miles de palabras con probabilidades minúsculas (5 % entre todas)
    </text>
  </g>
</svg>

<style>
  .llm-ac__bar {
    transform-box: fill-box;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-ac__bar {
      animation: llm-ac-grow 7s ease-out infinite backwards;
    }

    .llm-ac__bar--1 {
      animation-delay: 0.15s;
    }

    .llm-ac__bar--2 {
      animation-delay: 0.3s;
    }

    .llm-ac__word {
      animation: llm-ac-word 7s ease-out infinite;
    }

    .llm-ac__row--1,
    .llm-ac__row--2 {
      animation: llm-ac-fade 7s ease-out infinite;
    }
  }

  @keyframes llm-ac-grow {
    0%,
    8% {
      transform: scaleX(0);
    }
    35%,
    92% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes llm-ac-word {
    0%,
    48% {
      opacity: 0;
    }
    58%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-ac-fade {
    0%,
    45% {
      opacity: 1;
    }
    55%,
    90% {
      opacity: 0.35;
    }
    100% {
      opacity: 1;
    }
  }
</style>
