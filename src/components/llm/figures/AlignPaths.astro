---
/**
 * The three ways to align a model, one lane each: RLHF with PPO (a reward model and a value
 * network on top of the policy), DPO (the pairs straight into the policy, against a frozen
 * reference) and GRPO (the policy proposes a group, a program scores it, each answer is pushed
 * by how it did against the group's mean). The boxes are the machinery; what the figure shows is
 * how much of it each path needs.
 *
 * Animated: a signal runs along each lane in turn, from the data to the tuned policy. Without
 * motion the three lanes are the whole figure and the signal, which exists only to move, is not
 * drawn.
 */
type Box = { x: number; w: number; lines: string[]; dashed?: boolean; accent?: boolean };

const x = [130, 286, 442, 598];
const w = 130;

const lanes: { name: string; sub: string; boxes: Box[] }[] = [
  {
    name: 'RLHF + PPO',
    sub: '2 redes más',
    boxes: [
      { x: x[0], w, lines: ['pares', 'humanos'] },
      { x: x[1], w, lines: ['reward model', 'aprende a puntuar'], dashed: true },
      { x: x[2], w, lines: ['PPO + red', 'de valor'], dashed: true },
      { x: x[3], w, lines: ['política', 'afinada'], accent: true },
    ],
  },
  {
    name: 'DPO',
    sub: 'solo los pares',
    boxes: [
      { x: x[0], w, lines: ['pares', 'humanos'] },
      {
        x: x[1],
        w: x[2] + w - x[1],
        lines: ['pérdida DPO: sube la preferida', 'frente a una copia congelada'],
      },
      { x: x[3], w, lines: ['política', 'afinada'], accent: true },
    ],
  },
  {
    name: 'GRPO',
    sub: 'ni pares ni RM',
    boxes: [
      { x: x[0], w, lines: ['la política', 'propone 4'] },
      { x: x[1], w, lines: ['un programa', 'las puntúa'] },
      { x: x[2], w, lines: ['ventaja: nota', 'menos la media'] },
      { x: x[3], w, lines: ['política', 'afinada'], accent: true },
    ],
  },
];

const laneY = (i: number) => 26 + i * 92;
const boxH = 52;
---

<svg
  class="llm-align"
  viewBox="0 0 760 300"
  role="img"
  aria-label="Tres caminos para alinear un modelo. RLHF con PPO: pares de respuestas elegidas por personas entrenan un reward model que aprende a puntuar; PPO, con una red de valor, usa esas puntuaciones para afinar la política; son dos redes más. DPO: los mismos pares entran directamente en una pérdida que sube la respuesta preferida frente a una copia congelada del modelo de partida, sin reward model. GRPO: la política propone cuatro respuestas, un programa las puntúa, y cada una se empuja según su nota menos la media del grupo; no hacen falta ni pares ni reward model."
>
  <g font-family="var(--font-mono)">
    {lanes.map((lane, i) => {
      const y = laneY(i);
      const cy = y + boxH / 2;
      return (
        <g>
          <text
            x="8"
            y={cy - 3}
            font-size="13"
            font-weight="600"
            font-family="var(--font-display)"
            fill="var(--ink)"
          >
            {lane.name}
          </text>
          <text x="8" y={cy + 14} font-size="10" fill="var(--muted)">
            {lane.sub}
          </text>
          {lane.boxes.slice(1).map((b, j) => {
            const prev = lane.boxes[j];
            const from = prev.x + prev.w;
            const to = b.x;
            return (
              <g>
                <line x1={from} y1={cy} x2={to - 6} y2={cy} stroke="var(--diagram-stroke)" />
                <polygon
                  points={`${to},${cy} ${to - 7},${cy - 4} ${to - 7},${cy + 4}`}
                  fill="var(--diagram-stroke)"
                />
              </g>
            );
          })}
          {lane.boxes.map((b) => (
            <g>
              <rect
                x={b.x}
                y={y}
                width={b.w}
                height={boxH}
                fill={
                  b.accent
                    ? 'color-mix(in srgb, var(--accent) 22%, var(--box-fill))'
                    : 'var(--box-fill)'
                }
                stroke={b.accent ? 'var(--accent-text-aa)' : 'var(--ink)'}
                stroke-dasharray={b.dashed ? '4 3' : undefined}
              />
              {b.lines.map((line, k) => (
                <text
                  x={b.x + 10}
                  y={y + 21 + k * 16}
                  font-size={k === 0 ? 12 : 10.5}
                  fill={k === 0 ? 'var(--ink)' : 'var(--ink-2)'}
                >
                  {line}
                </text>
              ))}
            </g>
          ))}
          <circle
            class={`llm-align__signal llm-align__signal--${i}`}
            cx={x[0]}
            cy={cy}
            r="6"
            fill="var(--accent)"
          />
        </g>
      );
    })}
    <text x={x[1]} y="296" font-size="10" fill="var(--muted)">
      caja a trazos: una red entera que hay que entrenar además del modelo
    </text>
  </g>
</svg>

<style>
  .llm-align__signal {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-align__signal {
      animation: llm-align-run 7.5s ease-in-out infinite backwards;
    }

    .llm-align__signal--1 {
      animation-delay: 2.5s;
    }

    .llm-align__signal--2 {
      animation-delay: 5s;
    }
  }

  /* 598 px from the first box to the far edge of the last one, in the first third of the loop. */
  @keyframes llm-align-run {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    3% {
      opacity: 1;
    }
    30% {
      opacity: 1;
      transform: translateX(598px);
    }
    34%,
    100% {
      opacity: 0;
      transform: translateX(598px);
    }
  }
</style>
