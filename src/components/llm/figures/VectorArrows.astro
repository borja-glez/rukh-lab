---
/**
 * A vector as an arrow. [1, 2] means one step right and two up; drawn from the origin it is an
 * arrow, and that is what "apuntar hacia el mismo sitio", "cerca" and "girar" mean in every later
 * chapter. Next to it, the dot product of [1, 2] with three others, one per case: pointing roughly
 * the same way (large, positive), at a right angle (zero) and the opposite way (negative). The
 * numbers are the real products of those vectors.
 *
 * Animated: the reference arrow is drawn first, then each other arrow draws itself from the origin
 * while its row of the table lights up. Without motion every arrow and every row is shown.
 */
const unit = 40;
const ox = 200;
const oy = 170;
const px = (x: number) => ox + x * unit;
const py = (y: number) => oy - y * unit;

const ref = { v: [1, 2], name: 'a', color: 'var(--ink)' };
const others = [
  {
    v: [3, 1],
    name: 'b',
    color: 'var(--accent-text-aa)',
    sum: '1×3 + 2×1 = 5',
    what: 'apuntan parecido: grande',
  },
  {
    v: [-2, 1],
    name: 'c',
    color: 'var(--event-text-aa)',
    sum: '1×(−2) + 2×1 = 0',
    what: 'en ángulo recto: cero',
  },
  {
    v: [-3, -1],
    name: 'd',
    color: 'var(--muted)',
    sum: '1×(−3) + 2×(−1) = −5',
    what: 'sentidos opuestos: negativo',
  },
];
const fmt = (v: number[]) => `[${v.map((n) => String(n).replace('-', '−')).join(', ')}]`;

/** An arrow from the origin to v, as a line plus a head. */
const arrow = (v: number[]) => {
  const x = px(v[0]);
  const y = py(v[1]);
  const len = Math.hypot(x - ox, y - oy);
  const ux = (x - ox) / len;
  const uy = (y - oy) / len;
  const hx = x - ux * 9;
  const hy = y - uy * 9;
  return {
    line: `M ${ox} ${oy} L ${hx.toFixed(1)} ${hy.toFixed(1)}`,
    head: `M ${x} ${y} L ${(hx - uy * 5).toFixed(1)} ${(hy + ux * 5).toFixed(1)} L ${(hx + uy * 5).toFixed(1)} ${(hy - ux * 5).toFixed(1)} Z`,
    lx: x + ux * 14,
    ly: y + uy * 14,
  };
};
const ticks = [-3, -2, -1, 1, 2, 3];
---

<svg
  class="llm-vec"
  viewBox="0 0 700 300"
  role="img"
  aria-label="Un vector dibujado como flecha. La lista [1, 2] es una flecha que va un paso a la derecha y dos hacia arriba. Junto a ella, tres flechas más y su producto escalar con [1, 2]: [3, 1] apunta parecido y da 1 por 3 más 2 por 1, igual a 5; [−2, 1] forma un ángulo recto y da 0; [−3, −1] va en sentido contrario y da menos 5. Cuanto más se parecen las direcciones, mayor es el producto."
>
  <g font-family="var(--font-mono)">
    <line x1={px(-3.4)} y1={oy} x2={px(3.6)} y2={oy} stroke="var(--line)" />
    <line x1={ox} y1={py(-2.4)} x2={ox} y2={py(2.9)} stroke="var(--line)" />
    {ticks.map((t) => (
      <g>
        <line x1={px(t)} y1={oy - 3} x2={px(t)} y2={oy + 3} stroke="var(--diagram-stroke)" />
        <line x1={ox - 3} y1={py(t)} x2={ox + 3} y2={py(t)} stroke="var(--diagram-stroke)" />
      </g>
    ))}

    {[ref, ...others].map((o, i) => {
      const a = arrow(o.v);
      return (
        <g class={`llm-vec__arrow llm-vec__arrow--${i}`}>
          <path d={a.line} stroke={o.color} stroke-width="3" stroke-linecap="round" fill="none" />
          <path d={a.head} fill={o.color} />
          <text
            x={a.lx}
            y={a.ly + 4}
            font-size="12"
            text-anchor="middle"
            fill={o.color}
            font-weight="600"
          >
            {o.name}
          </text>
        </g>
      );
    })}
    <circle cx={ox} cy={oy} r="3" fill="var(--ink)" />

    <text x="400" y="42" font-size="11" fill="var(--muted)">
      a = [1, 2]: 1 a la derecha, 2 arriba
    </text>
    <text x="400" y="72" font-size="10" fill="var(--muted)">
      PRODUCTO ESCALAR CON a
    </text>
    {others.map((o, i) => (
      <g class={`llm-vec__row llm-vec__row--${i}`}>
        <text x="400" y={104 + i * 58} font-size="12" fill={o.color} font-weight="600">
          {o.name} = {fmt(o.v)}
        </text>
        <text x="400" y={122 + i * 58} font-size="12" fill="var(--ink)">
          {o.sum}
        </text>
        <text x="400" y={138 + i * 58} font-size="10.5" fill="var(--ink-2)">
          {o.what}
        </text>
      </g>
    ))}
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .llm-vec__arrow--1,
    .llm-vec__row--0 {
      animation: llm-vec-in 9s ease-out infinite backwards;
      animation-delay: 1s;
    }
    .llm-vec__arrow--2,
    .llm-vec__row--1 {
      animation: llm-vec-in 9s ease-out infinite backwards;
      animation-delay: 2.6s;
    }
    .llm-vec__arrow--3,
    .llm-vec__row--2 {
      animation: llm-vec-in 9s ease-out infinite backwards;
      animation-delay: 4.2s;
    }
  }

  /* Each arrow and its row fade in together and stay until the loop starts over. */
  @keyframes llm-vec-in {
    0% {
      opacity: 0;
    }
    5%,
    58% {
      opacity: 1;
    }
    64%,
    100% {
      opacity: 0;
    }
  }
</style>
