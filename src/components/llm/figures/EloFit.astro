---
/**
 * How an Elo number comes out of games: the model plays a ladder of rivals of known strength,
 * each rung gives a score, and the logistic curve of the Elo formula is fitted through them; the
 * rating is where the curve says "50 %". The rung ratings are Rukh's real ladder (M6: four
 * `UCI_Elo` rungs and four `Skill Level` anchors); the scores are illustrative, for a model around
 * 1500, and the band is the ±57 a bootstrap over 160 games gives.
 *
 * Animated: the rung results land one by one, then the curve is drawn through them and the
 * estimate with its interval appears. Without motion, everything is drawn.
 */
const rungs = [1320, 1381, 1467, 1500, 1589, 1678, 1800, 2000];
const model = 1500;
const noise = [0.07, -0.08, 0.06, -0.05, 0.08, -0.04, 0.05, 0.02];

const dMin = -550;
const dMax = 250;
const xL = 70;
const xR = 600;
const yT = 30;
const yB = 230;
const expected = (d: number) => 1 / (1 + 10 ** (-d / 400));
/* Mirrored: d is model − rung, so a stronger rival (negative d) sits further right. */
const sx = (d: number) => xL + ((dMax - d) / (dMax - dMin)) * (xR - xL);
const sy = (p: number) => yB - p * (yB - yT);

const points = rungs.map((r, i) => {
  const d = model - r;
  const score = Math.min(1, Math.max(0, Math.round((expected(d) + noise[i]) * 40) / 40));
  return { r, x: sx(d), y: sy(score) };
});

const curve = Array.from({ length: 60 }, (_, i) => {
  const d = dMin + (i / 59) * (dMax - dMin);
  return `${i === 0 ? 'M' : 'L'}${sx(d).toFixed(1)},${sy(expected(d)).toFixed(1)}`;
}).join(' ');

const bandHalf = sx(0) - sx(57);
---

<svg
  class="llm-elo"
  viewBox="0 0 640 290"
  role="img"
  aria-label="Cómo sale un Elo. Cada punto es un peldaño de la escalera de Rukh, rivales de Stockfish de 1320 a 2000 de Elo, con la puntuación que sacó el modelo contra él en veinte partidas: casi todo contra los flojos, casi nada contra los fuertes. Por los puntos se ajusta la curva logística de la fórmula del Elo, y el Elo estimado es la diferencia en la que la curva cruza el 50 por ciento, con una banda de unos 57 puntos a cada lado que da el bootstrap sobre 160 partidas."
>
  <g font-family="var(--font-mono)" font-size="10.5">
    <line x1={xL} y1={yB} x2={xR} y2={yB} stroke="var(--diagram-stroke)" />
    <line x1={xL} y1={yB} x2={xL} y2={yT} stroke="var(--diagram-stroke)" />
    {[0, 0.5, 1].map((p) => (
      <g>
        <line x1={xL} y1={sy(p)} x2={xR} y2={sy(p)} stroke="var(--line-soft)" />
        <text x={xL - 8} y={sy(p) + 4} text-anchor="end" fill="var(--muted)">
          {p * 100} %
        </text>
      </g>
    ))}
    <text x={xL} y={yT - 12} fill="var(--muted)">
      puntuación del modelo contra el peldaño
    </text>

    <g class="llm-elo__band">
      <rect
        x={sx(0) - bandHalf}
        y={yT}
        width={bandHalf * 2}
        height={yB - yT}
        fill="color-mix(in srgb, var(--accent) 16%, transparent)"
      />
      <line
        x1={sx(0)}
        y1={yT}
        x2={sx(0)}
        y2={yB}
        stroke="var(--accent-text-aa)"
        stroke-dasharray="4 3"
      />
      <text x={sx(0) + bandHalf + 6} y={yT + 14} fill="var(--accent-text-aa)">
        Elo estimado ± intervalo
      </text>
    </g>

    <path
      class="llm-elo__curve"
      d={curve}
      pathLength="1"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2"
    />

    {points.map((pt, i) => (
      <g class={`llm-elo__pt llm-elo__pt--${i}`}>
        <circle cx={pt.x} cy={pt.y} r="5.5" fill="var(--split-4)" stroke="var(--ink)" />
        <text
          x={pt.x}
          y={yB + 16 + (i % 2) * 12}
          text-anchor="middle"
          font-size="9.5"
          fill="var(--ink-2)"
        >
          {pt.r}
        </text>
      </g>
    ))}
    <text x={(xL + xR) / 2} y={yB + 50} text-anchor="middle" fill="var(--muted)">
      Elo del peldaño (rival más fuerte hacia la derecha)
    </text>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .llm-elo__pt {
      animation: llm-elo-pt 9s ease-out infinite backwards;
    }
    .llm-elo__pt--1 {
      animation-delay: 0.3s;
    }
    .llm-elo__pt--2 {
      animation-delay: 0.6s;
    }
    .llm-elo__pt--3 {
      animation-delay: 0.9s;
    }
    .llm-elo__pt--4 {
      animation-delay: 1.2s;
    }
    .llm-elo__pt--5 {
      animation-delay: 1.5s;
    }
    .llm-elo__pt--6 {
      animation-delay: 1.8s;
    }
    .llm-elo__pt--7 {
      animation-delay: 2.1s;
    }

    .llm-elo__curve {
      stroke-dasharray: 1;
      animation: llm-elo-curve 9s ease-in-out infinite;
    }

    .llm-elo__band {
      animation: llm-elo-band 9s ease-out infinite;
    }
  }

  @keyframes llm-elo-pt {
    0% {
      opacity: 0;
      transform: translateY(-14px);
    }
    6%,
    90% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }

  @keyframes llm-elo-curve {
    0%,
    30% {
      stroke-dashoffset: 1;
    }
    55%,
    92% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  @keyframes llm-elo-band {
    0%,
    55% {
      opacity: 0;
    }
    63%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
