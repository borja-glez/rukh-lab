---
/**
 * RoPE as an arrow that turns. The vector of each move is drawn as a 2D arrow (chapter 1), and
 * each position turns it a fixed step more than the one before. Underneath, two comparisons: the
 * arrows of positions 0 and 2, and those of positions 3 and 5, overlaid on one dial each. The gap
 * between the two arrows is the same in both, because it only depends on the distance between
 * the positions, which is what attention gets to see.
 *
 * The step is chosen for the eye, not taken from a model, and the figure shows no angles: the
 * point is "same distance, same turn", not a number.
 *
 * Animated: each arrow sweeps its last step into place, one position after another, and then the
 * two comparisons light up in turn. Without motion every arrow sits at its angle and both
 * comparisons are lit.
 */
const moves = ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'f1b5', 'a7a6'];
const step = 40; // degrees per position, for the eye
const cy = 96;
const r = 34;
const len = 28;
const cx = (i: number) => 70 + i * 112;
const tip = (x: number, y: number, deg: number, l = len) => {
  const a = (deg * Math.PI) / 180;
  return { x: x + l * Math.sin(a), y: y - l * Math.cos(a) };
};
/** An arc of radius `rr` from angle a to angle b (clockwise from twelve o'clock). */
const arc = (x: number, y: number, rr: number, a: number, b: number) => {
  const p = tip(x, y, a, rr);
  const q = tip(x, y, b, rr);
  const large = b - a > 180 ? 1 : 0;
  return `M ${p.x.toFixed(1)} ${p.y.toFixed(1)} A ${rr} ${rr} 0 ${large} 1 ${q.x.toFixed(1)} ${q.y.toFixed(1)}`;
};
const compare = [
  { x: 210, a: 0, b: 2 },
  { x: 490, a: 3, b: 5 },
];
const cy2 = 206;
---

<svg
  class="llm-ropea"
  viewBox="0 0 700 300"
  role="img"
  aria-label="RoPE como una flecha que gira. Seis jugadas seguidas, e2e4, e7e5, g1f3, b8c6, f1b5 y a7a6, en las posiciones 0 a 5; el vector de cada una se dibuja como una flecha, y cada posición la gira un paso más que la anterior. Debajo, dos comparaciones: las flechas de las posiciones 0 y 2 superpuestas, y las de las posiciones 3 y 5. El hueco entre las dos flechas es el mismo en las dos comparaciones, porque solo depende de la distancia entre posiciones, que es lo que ve la atención."
>
  <g font-family="var(--font-mono)">
    {moves.map((m, i) => {
      const t = tip(cx(i), cy, i * step);
      return (
        <g>
          <text x={cx(i)} y="40" font-size="12" text-anchor="middle" fill="var(--ink)">
            {m}
          </text>
          <circle cx={cx(i)} cy={cy} r={r} fill="var(--box-fill)" stroke="var(--line)" />
          <line
            x1={cx(i)}
            y1={cy}
            x2={cx(i)}
            y2={cy - len}
            stroke="var(--diagram-stroke)"
            stroke-dasharray="2 3"
          />
          <g class={`llm-ropea__arrow llm-ropea__arrow--${i}`}>
            <circle cx={cx(i)} cy={cy} r={r} fill="none" />
            <line
              x1={cx(i)}
              y1={cy}
              x2={t.x}
              y2={t.y}
              stroke="var(--accent-text-aa)"
              stroke-width="3"
              stroke-linecap="round"
            />
            <circle cx={t.x} cy={t.y} r="3.5" fill="var(--accent-text-aa)" />
          </g>
          <circle cx={cx(i)} cy={cy} r="3" fill="var(--ink)" />
          <text x={cx(i)} y="148" font-size="10" text-anchor="middle" fill="var(--muted)">
            posición {i}
          </text>
        </g>
      );
    })}

    {compare.map((c, k) => {
      const a = tip(c.x, cy2, c.a * step);
      const b = tip(c.x, cy2, c.b * step);
      return (
        <g class={`llm-ropea__cmp llm-ropea__cmp--${k}`}>
          <circle cx={c.x} cy={cy2} r={r} fill="var(--box-fill)" stroke="var(--ink)" />
          <path
            class="llm-ropea__gap"
            d={arc(c.x, cy2, 18, c.a * step, c.b * step)}
            fill="none"
            stroke="var(--event-text-aa)"
            stroke-width="3"
          />
          <line
            x1={c.x}
            y1={cy2}
            x2={a.x}
            y2={a.y}
            stroke="var(--accent-text-aa)"
            stroke-width="3"
            stroke-linecap="round"
          />
          <line
            x1={c.x}
            y1={cy2}
            x2={b.x}
            y2={b.y}
            stroke="var(--accent-text-aa)"
            stroke-width="3"
            stroke-linecap="round"
          />
          <circle cx={c.x} cy={cy2} r="3" fill="var(--ink)" />
          <text x={c.x} y={cy2 + 52} font-size="11" text-anchor="middle" fill="var(--ink)">
            posiciones {c.a} y {c.b}
          </text>
          <text
            x={c.x}
            y={cy2 + 67}
            font-size="10"
            text-anchor="middle"
            fill="var(--event-text-aa)"
          >
            hueco entre flechas
          </text>
        </g>
      );
    })}
    <text x="350" y={cy2 + 4} font-size="16" text-anchor="middle" fill="var(--ink)">
      =
    </text>
    <text x="350" y="294" font-size="11" text-anchor="middle" fill="var(--muted)">
      misma distancia entre posiciones → mismo giro entre sus flechas
    </text>
  </g>
</svg>

<style>
  .llm-ropea__arrow {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-ropea__arrow {
      animation: llm-ropea-sweep 9s ease-out infinite backwards;
    }
    .llm-ropea__arrow--1 {
      animation-delay: 0.45s;
    }
    .llm-ropea__arrow--2 {
      animation-delay: 0.9s;
    }
    .llm-ropea__arrow--3 {
      animation-delay: 1.35s;
    }
    .llm-ropea__arrow--4 {
      animation-delay: 1.8s;
    }
    .llm-ropea__arrow--5 {
      animation-delay: 2.25s;
    }

    .llm-ropea__cmp {
      animation: llm-ropea-cmp 9s ease-in-out infinite backwards;
    }
    .llm-ropea__cmp--1 {
      animation-delay: 1.2s;
    }
  }

  /* Each arrow arrives by turning its last step, so "one step more per position" is what moves. */
  @keyframes llm-ropea-sweep {
    0% {
      opacity: 0;
      transform: rotate(-40deg);
    }
    6%,
    100% {
      opacity: 1;
      transform: rotate(0deg);
    }
  }

  /* The two comparisons come up after the row is built, one after the other, and stay. */
  @keyframes llm-ropea-cmp {
    0%,
    38% {
      opacity: 0.15;
    }
    46%,
    94% {
      opacity: 1;
    }
    100% {
      opacity: 0.15;
    }
  }
</style>
