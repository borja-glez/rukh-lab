---
/**
 * Quantization in two panels. Left: weights with arbitrary values snap to the nearest step of a
 * coarse grid (int8 has 256 steps; the figure draws 13 so they can be seen). Right: the error that
 * rounding leaves on each logit is small and the same size in two positions; where the best move
 * leads by a lot nothing changes, where the top two are close the order can flip. Values are
 * illustrative; M2 and M6 measured the real effect (parity 95,40 % for int8).
 *
 * Animated: the weights fall onto the grid; then the logits jitter, and in the close position the
 * second one overtakes the first now and then. Without motion the weights sit on the grid (their
 * original places as hollow ghosts) and the logits are still, with the error drawn as whiskers.
 */
const lineX0 = 30;
const lineX1 = 310;
const steps = 13;
const stepW = (lineX1 - lineX0) / (steps - 1);
/* Each weight sits a drift away from its step; three drifts, one per keyframe below. */
const drifts = [8, -9, 6];
const dots = [1, 2, 4, 5, 6, 8, 9, 10, 12].map((step, i) => {
  const snapped = lineX0 + step * stepW;
  return { snapped, x: snapped + drifts[i % 3] };
});

const barX = 470;
const unit = 26;
const positions = [
  { name: 'la mejor saca ventaja', y: 60, bars: [7.1, 4.3], moves: ['Dxf7+', 'Cc3'] },
  { name: 'dos jugadas casi empatadas', y: 170, bars: [5.3, 5.15], moves: ['Ae2', 'Cf3'] },
];
---

<svg
  class="llm-qs"
  viewBox="0 0 700 270"
  role="img"
  aria-label="Cuantizar, en dos paneles. A la izquierda, nueve pesos con valores cualesquiera caen al escalón más cercano de una rejilla gruesa: eso es guardar cada número con menos bits. A la derecha, el pequeño error que deja el redondeo en los logits de dos posiciones. En la primera la mejor jugada saca mucha ventaja a la segunda y el error no cambia nada. En la segunda las dos mejores están casi empatadas y el error, del mismo tamaño, puede darles la vuelta: el modelo cuantizado juega otra jugada."
>
  <g font-family="var(--font-mono)" font-size="10.5">
    <text x={lineX0} y="26" fill="var(--muted)">
      pesos → escalones (int8)
    </text>
    <line x1={lineX0} y1="150" x2={lineX1} y2="150" stroke="var(--diagram-stroke)" />
    {Array.from({ length: steps }, (_, i) => (
      <line x1={lineX0 + i * stepW} y1="142" x2={lineX0 + i * stepW} y2="158" stroke="var(--ink)" />
    ))}
    {dots.map((d) => (
      <circle
        cx={d.x}
        cy="90"
        r="5"
        fill="none"
        stroke="var(--diagram-stroke)"
        stroke-dasharray="2 2"
      />
    ))}
    {dots.map((d, i) => (
      <g class={`llm-qs__dot llm-qs__dot--${i % 3}`}>
        <circle cx={d.snapped} cy="150" r="5.5" fill="var(--accent)" stroke="var(--ink)" />
      </g>
    ))}
    <text x={lineX0} y="92" fill="var(--muted)" font-size="9.5" dx="-26">
      fp32
    </text>
    <text x={lineX0} y="186" fill="var(--ink-2)">
      cada peso cae al escalón más cercano:
    </text>
    <text x={lineX0} y="202" fill="var(--ink-2)">
      menos bits, un poco de error en cada uno
    </text>

    <line x1="350" y1="20" x2="350" y2="250" stroke="var(--line)" />

    <text x="380" y="26" fill="var(--muted)">
      logits de las dos mejores jugadas
    </text>
    {positions.map((pos, p) => (
      <g>
        <text x="380" y={pos.y - 8} fill="var(--ink)">
          {pos.name}
        </text>
        {pos.bars.map((v, b) => {
          const y = pos.y + b * 30;
          const w = v * unit;
          return (
            <g>
              <text x="380" y={y + 14} fill="var(--ink-2)">
                {pos.moves[b]}
              </text>
              <rect
                class={`llm-qs__bar llm-qs__bar--${p}${b}`}
                x={barX}
                y={y}
                width={w}
                height="20"
                fill={b === 0 ? 'var(--accent)' : 'var(--split-3)'}
                fill-opacity={b === 0 ? 0.9 : 0.7}
              />
              <line
                x1={barX + w - 6}
                y1={y + 10}
                x2={barX + w + 6}
                y2={y + 10}
                stroke="var(--ink)"
              />
              <line
                x1={barX + w - 6}
                y1={y + 5}
                x2={barX + w - 6}
                y2={y + 15}
                stroke="var(--ink)"
              />
              <line
                x1={barX + w + 6}
                y1={y + 5}
                x2={barX + w + 6}
                y2={y + 15}
                stroke="var(--ink)"
              />
            </g>
          );
        })}
      </g>
    ))}
    <text class="llm-qs__flip" x="380" y="248" fill="var(--event-text-aa)" font-weight="500">
      ¡se cruzan: el int8 juega Cf3!
    </text>
    <text x="380" y="264" fill="var(--muted)" font-size="9.5">
      ├┤ = error de redondeo, igual en las dos posiciones
    </text>
  </g>
</svg>

<style>
  .llm-qs__flip {
    opacity: 0;
  }

  .llm-qs__bar {
    transform-box: fill-box;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-qs__dot--0 {
      animation: llm-qs-fall-a 8s ease-in infinite;
    }
    .llm-qs__dot--1 {
      animation: llm-qs-fall-b 8s ease-in infinite;
    }
    .llm-qs__dot--2 {
      animation: llm-qs-fall-c 8s ease-in infinite;
    }

    .llm-qs__bar--00,
    .llm-qs__bar--10 {
      animation: llm-qs-jitter-down 8s ease-in-out infinite;
    }

    .llm-qs__bar--01,
    .llm-qs__bar--11 {
      animation: llm-qs-jitter-up 8s ease-in-out infinite;
    }

    .llm-qs__flip {
      animation: llm-qs-flip 8s ease-in-out infinite;
    }
  }

  /* The dots start 60 px up, on their hollow ghosts (drifts 8, −9 and 6 px), and fall onto the
     nearest step. */
  @keyframes llm-qs-fall-a {
    0%,
    8% {
      transform: translate(8px, -60px);
    }
    22%,
    100% {
      transform: translate(0, 0);
    }
  }

  @keyframes llm-qs-fall-b {
    0%,
    10% {
      transform: translate(-9px, -60px);
    }
    24%,
    100% {
      transform: translate(0, 0);
    }
  }

  @keyframes llm-qs-fall-c {
    0%,
    12% {
      transform: translate(6px, -60px);
    }
    26%,
    100% {
      transform: translate(0, 0);
    }
  }

  /* The error is ±0.2 logits on each bar: 0.2 × 26 px ≈ 5 px, 3-4 % of the bar. */
  @keyframes llm-qs-jitter-down {
    0%,
    30%,
    100% {
      transform: scaleX(1);
    }
    45%,
    60% {
      transform: scaleX(0.965);
    }
    75% {
      transform: scaleX(1.02);
    }
  }

  @keyframes llm-qs-jitter-up {
    0%,
    30%,
    100% {
      transform: scaleX(1);
    }
    45%,
    60% {
      transform: scaleX(1.035);
    }
    75% {
      transform: scaleX(0.98);
    }
  }

  @keyframes llm-qs-flip {
    0%,
    40% {
      opacity: 0;
    }
    46%,
    60% {
      opacity: 1;
    }
    66%,
    100% {
      opacity: 0;
    }
  }
</style>
