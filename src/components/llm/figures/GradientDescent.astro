---
/**
 * Training as a walk down a foggy hill. Left: a one-dimensional loss landscape and the steps of
 * real gradient descent on it (x ← x − 30·f′(x) on the curve drawn, computed once and pasted:
 * the steps shrink by themselves as the slope flattens). The fog is a mask with a hole around the
 * ball: the walker only knows the slope under its feet. Right: the loss curve a training run
 * logs, fast at first and then flat (illustrative, not a Rukh run).
 *
 * Animated: the ball hops from step to step with the clear patch of fog following it, and the
 * loss curve draws itself in step. Without motion the ball rests in the valley, the trail of
 * steps and the whole curve are drawn, and the fog stays open around the valley.
 */
const f = (x: number) => 60 + 0.0036 * (x - 250) ** 2 + 5 * Math.sin(x / 18);
/* SVG y grows downwards, so the plot is 320 − f: low loss sits low on the page. */
const y = (x: number) => 320 - f(x);
let hill = '';
for (let x = 20; x <= 390; x += 5) hill += `${x === 20 ? 'M' : 'L'}${x} ${y(x).toFixed(1)} `;

/* Gradient-descent steps on f, from x = 36 with learning rate 30. */
const steps = [36, 86, 121, 141, 165, 191, 207, 212].map((x) => ({ x, y: y(x) - 8 }));

const loss =
  '450,82.4 456,101.9 462,125.9 467,133.9 473,155.8 479,159.9 485,174.9 490,181.3 496,187.3 502,197.4 508,197.0 513,207.8 519,206.0 525,213.3 531,214.4 536,216.2 542,220.9 548,218.6 554,224.8 559,221.8 565,226.0 571,225.5 577,226.0 582,228.6 588,226.2 594,230.1 600,227.3 605,230.2 611,229.2 617,229.4 623,230.9 628,229.0 634,231.7 640,229.4 646,231.4 651,230.5 657,230.6 663,231.5 669,230.1 674,232.0 680,230.2';
---

<svg
  class="llm-gd"
  viewBox="0 0 700 300"
  role="img"
  aria-label="Descenso de gradiente. A la izquierda, un paisaje con forma de valle: la altura es la pérdida y la posición horizontal son los pesos del modelo. Una bola baja por él en ocho pasos, primero largos y luego cada vez más cortos, hasta quedarse en el fondo. Una niebla tapa todo menos el terreno junto a la bola: el modelo solo conoce la pendiente donde está. A la derecha, la curva de pérdida que se registra al entrenar: cae deprisa al principio y luego se aplana."
>
  <defs>
    <mask id="llm-gd-fog">
      <rect x="0" y="0" width="420" height="300" fill="white"></rect>
      <circle class="llm-gd__hole" cx="0" cy="0" r="46" fill="black"></circle>
    </mask>
  </defs>

  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    <text x="16" y="20">
      EL PAISAJE (CON NIEBLA)
    </text>
    <text x="440" y="20">
      LA CURVA QUE VES AL ENTRENAR
    </text>
    <text x="16" y="290">
      pesos del modelo →
    </text>
    <text x="450" y="290">
      pasos de entrenamiento →
    </text>
    <text x="440" y="46">
      pérdida
    </text>
  </g>

  <path d={hill} fill="none" stroke="var(--ink)" stroke-width="2"></path>
  <rect
    x="10"
    y="30"
    width="400"
    height="240"
    fill="var(--frame-bg)"
    fill-opacity="0.9"
    mask="url(#llm-gd-fog)"
  ></rect>

  {steps.map((s, i) => (
    <circle
      cx={s.x}
      cy={s.y + 8}
      r="2.5"
      fill="var(--accent-text-aa)"
      opacity={i === 0 ? 0.5 : 0.8}
    />
  ))}
  <circle
    class="llm-gd__ball"
    cx="0"
    cy="0"
    r="8"
    fill="var(--accent)"
    stroke="var(--ink)"
  ></circle>

  <line x1="440" y1="60" x2="440" y2="262" stroke="var(--diagram-stroke)"></line>
  <line x1="440" y1="262" x2="690" y2="262" stroke="var(--diagram-stroke)"></line>
  <polyline
    class="llm-gd__loss"
    points={loss}
    pathLength="1"
    fill="none"
    stroke="var(--accent-text-aa)"
    stroke-width="2"
  ></polyline>
</svg>

<style>
  /* Static frame: the ball and the clear patch rest in the valley (the last step). */
  .llm-gd__ball,
  .llm-gd__hole {
    transform: translate(212px, 250.3px);
  }

  .llm-gd__loss {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-gd__ball,
    .llm-gd__hole {
      animation: llm-gd-walk 9s ease-in-out infinite;
    }

    /* The ball fades out and back in, so the jump back to the top of the hill is not seen. */
    .llm-gd__ball {
      animation:
        llm-gd-walk 9s ease-in-out infinite,
        llm-gd-blink 9s linear infinite;
    }

    .llm-gd__loss {
      animation: llm-gd-draw 9s linear infinite;
    }
  }

  /* One keyframe per step of gradient descent (see the frontmatter), then a rest in the valley. */
  @keyframes llm-gd-walk {
    0% {
      transform: translate(36px, 82.6px);
    }
    9% {
      transform: translate(86px, 160.2px);
    }
    18% {
      transform: translate(121px, 190px);
    }
    27% {
      transform: translate(141px, 204.2px);
    }
    36% {
      transform: translate(165px, 224.7px);
    }
    45% {
      transform: translate(191px, 244.1px);
    }
    54% {
      transform: translate(207px, 249.7px);
    }
    63%,
    100% {
      transform: translate(212px, 250.3px);
    }
  }

  @keyframes llm-gd-blink {
    0% {
      opacity: 0;
    }
    3%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-gd-draw {
    0% {
      stroke-dashoffset: 1;
    }
    63%,
    100% {
      stroke-dashoffset: 0;
    }
  }
</style>
