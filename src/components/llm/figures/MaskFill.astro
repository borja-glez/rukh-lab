---
/**
 * Decoder and encoder side by side as attention masks. Each row is a position that looks, each
 * column a position looked at; a filled cell means "this read is allowed". The decoder can only
 * look back (lower triangle), the encoder reads everything. Same idea as MaskCompare in M3, drawn
 * with a sentence instead of moves.
 *
 * Animated: the rows fill one after another, as a writer and a proofreader would go through the
 * sentence. Without motion both masks are filled.
 */
const words = ['El', 'gato', 'se', 'subió', 'al', 'tejado'];
const cell = 26;
const top = 78;
const grids = [
  {
    x: 110,
    title: 'decoder · causal',
    sub: 'novelista: solo lo ya escrito',
    allowed: (i: number, j: number) => j <= i,
  },
  {
    x: 480,
    title: 'encoder · bidireccional',
    sub: 'corrector: la página entera',
    allowed: () => true,
  },
];
---

<svg
  class="llm-mf"
  viewBox="0 0 720 290"
  role="img"
  aria-label="Dos máscaras de atención para la frase «El gato se subió al tejado». Cada fila es una palabra que mira y cada columna una palabra mirada; una casilla rellena significa que esa lectura está permitida. En el decoder, causal, cada palabra solo puede mirar a las anteriores y a sí misma: se rellena el triángulo de abajo, como un novelista que solo conoce lo ya escrito. En el encoder, bidireccional, cada palabra mira a todas: se rellena el cuadrado entero, como un corrector con la página delante."
>
  <g font-family="var(--font-mono)" fill="var(--ink)">
    {grids.map((g) => (
      <g>
        <text x={g.x} y="26" font-size="13" font-family="var(--font-display)" font-weight="600">
          {g.title}
        </text>
        <text x={g.x} y="44" font-size="10" fill="var(--muted)">
          {g.sub}
        </text>
        {words.map((w, j) => (
          <text
            x={g.x + j * cell + cell / 2}
            y={top - 8}
            font-size="9"
            text-anchor="middle"
            fill="var(--muted)"
          >
            {j + 1}
          </text>
        ))}
        {words.map((w, i) => (
          <text x={g.x - 8} y={top + i * cell + 17} font-size="11" text-anchor="end">
            {i + 1} {w}
          </text>
        ))}
        {words.map((_, i) =>
          words.map((_, j) => (
            <rect
              x={g.x + j * cell}
              y={top + i * cell}
              width={cell}
              height={cell}
              fill="var(--box-fill)"
              stroke="var(--line)"
            />
          )),
        )}
        {words.map((_, i) => (
          <g class={`llm-mf__row llm-mf__row--${i}`}>
            {words.map((_, j) =>
              g.allowed(i, j) ? (
                <rect
                  x={g.x + j * cell + 2}
                  y={top + i * cell + 2}
                  width={cell - 4}
                  height={cell - 4}
                  fill={j === i ? 'var(--accent)' : 'var(--split-3)'}
                  fill-opacity={j === i ? 0.9 : 0.6}
                />
              ) : null,
            )}
          </g>
        ))}
      </g>
    ))}
    <text x="110" y="272" font-size="10" fill="var(--muted)">
      fila = la palabra que mira · columna = la palabra mirada · naranja = ella misma
    </text>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .llm-mf__row {
      animation: llm-mf-row 7s ease-out infinite backwards;
    }
    .llm-mf__row--1 {
      animation-delay: 0.5s;
    }
    .llm-mf__row--2 {
      animation-delay: 1s;
    }
    .llm-mf__row--3 {
      animation-delay: 1.5s;
    }
    .llm-mf__row--4 {
      animation-delay: 2s;
    }
    .llm-mf__row--5 {
      animation-delay: 2.5s;
    }
  }

  @keyframes llm-mf-row {
    0% {
      opacity: 0;
    }
    5%,
    80% {
      opacity: 1;
    }
    88%,
    100% {
      opacity: 0;
    }
  }
</style>
