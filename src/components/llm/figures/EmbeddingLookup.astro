---
/**
 * From a token to its vector: the tokenizer's id picks one row of the embedding table, and that
 * row is what enters the network. Sizes are rukh-small's (2 030 rows × 512 columns, M2 · el
 * decoder); the id and the numbers in the row are illustrative.
 *
 * Static on purpose: it is a lookup, nothing moves.
 */
const rows = [44, 45, 46, 47, 48, 49];
const hit = 47;
const cells = [0.8, -0.3, 0.1, 0.9, -0.7, 0.4, -0.1, 0.6];
const tableX = 250;
const rowH = 20;
const tableY = 40;
const shade = (v: number) =>
  v > 0.5
    ? 'var(--split-2)'
    : v > 0
      ? 'var(--split-4)'
      : v > -0.5
        ? 'var(--split-5)'
        : 'var(--box-fill)';
---

<svg
  class="llm-el"
  viewBox="0 0 700 220"
  role="img"
  aria-label="Del token al vector. El token e2e4 tiene el identificador 47. Ese número elige la fila 47 de la tabla de embeddings, que en rukh-small tiene 2 030 filas, una por token del vocabulario, y 512 columnas. La fila elegida, 512 números reales, es lo que entra en la red en lugar de la palabra."
>
  <g font-family="var(--font-mono)" fill="var(--ink)">
    <rect x="16" y="94" width="70" height="28" fill="var(--box-fill)" stroke="var(--line)"></rect>
    <text x="51" y="113" font-size="13" text-anchor="middle">
      e2e4
    </text>
    <text x="16" y="84" font-size="10" fill="var(--muted)">
      token
    </text>

    <line x1="90" y1="108" x2="130" y2="108" stroke="var(--diagram-stroke)"></line>
    <path d="M130 104 L138 108 L130 112 Z" fill="var(--diagram-stroke)"></path>

    <rect
      x="142"
      y="94"
      width="70"
      height="28"
      fill="color-mix(in srgb, var(--accent) 24%, var(--box-fill))"
      stroke="var(--accent-text-aa)"
    ></rect>
    <text x="177" y="113" font-size="13" text-anchor="middle">
      id 47
    </text>
    <text x="142" y="84" font-size="10" fill="var(--muted)">
      número
    </text>

    <line x1="214" y1="108" x2="240" y2="108" stroke="var(--diagram-stroke)"></line>

    <text x={tableX} y="28" font-size="10" fill="var(--muted)">
      tabla de embeddings · 2 030 filas × 512 columnas
    </text>
    <text x={tableX} y={tableY + 8} font-size="10" fill="var(--muted)">
      ⋮
    </text>
    {rows.map((r, i) => {
      const y = tableY + 14 + i * rowH;
      const on = r === hit;
      return (
        <g>
          <text
            x={tableX + 22}
            y={y + 14}
            font-size="10"
            text-anchor="end"
            fill={on ? 'var(--ink)' : 'var(--muted)'}
          >
            {r}
          </text>
          {Array.from({ length: 16 }, (_, c) => (
            <rect
              x={tableX + 30 + c * 12}
              y={y}
              width="12"
              height={rowH}
              fill={
                on ? 'color-mix(in srgb, var(--accent) 30%, var(--box-fill))' : 'var(--box-fill)'
              }
              stroke={on ? 'var(--accent-text-aa)' : 'var(--line)'}
            />
          ))}
        </g>
      );
    })}
    <text x={tableX} y={tableY + 14 + rows.length * rowH + 14} font-size="10" fill="var(--muted)">
      ⋮
    </text>

    <line x1="480" y1="124" x2="508" y2="124" stroke="var(--diagram-stroke)"></line>
    <path d="M508 120 L516 124 L508 128 Z" fill="var(--diagram-stroke)"></path>

    <text x="522" y="96" font-size="10" fill="var(--muted)">
      el vector de e2e4
    </text>
    {cells.map((v, i) => (
      <rect x={522 + i * 20} y="110" width="20" height="28" fill={shade(v)} stroke="var(--line)" />
    ))}
    <text x="522" y="156" font-size="10" fill="var(--muted)">
      512 números (se ven 8)
    </text>
    <text x="522" y="172" font-size="10" fill="var(--muted)">
      esto entra en la red
    </text>
  </g>
</svg>
