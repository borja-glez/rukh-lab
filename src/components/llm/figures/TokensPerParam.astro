---
/**
 * Unique training tokens per parameter for four Rukh runs, against the ≈ 20 of the Chinchilla
 * scaling result. All the numbers are the ones measured in M2 · «Más datos, no más red»
 * (tokens from each corpus's meta.json, parameters from the model). Static: the point is the
 * comparison, and nothing in it moves.
 */
const runs = [
  { name: 'medium v1', detail: '115 M par. · 240 M tokens', ratio: 2.1 },
  { name: 'small v1', detail: '39 M par. · 240 M tokens', ratio: 6.2 },
  { name: 'small v2', detail: '39 M par. · 471 M tokens', ratio: 12.1 },
  { name: 'medium-v4', detail: '115 M par. · 1 681 M tokens', ratio: 14.6 },
];
const x0 = 250;
const scale = 18;
const fmt = (n: number) => n.toLocaleString('es-ES');
---

<svg
  class="llm-tpp"
  viewBox="0 0 700 230"
  role="img"
  aria-label={`Tokens únicos de entrenamiento por parámetro en cuatro modelos de Rukh, frente a la referencia de unos 20 del estudio Chinchilla: ${runs.map((r) => `${r.name}, ${r.detail}, ${fmt(r.ratio)}`).join('; ')}. El medium v1, con el triple de red y los mismos datos, se queda en 2,1 y apenas mejora; devolver datos al small (v2) le hace ganar al medium v1.`}
>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
    <text x="16" y="20" font-size="10" fill="var(--muted)">
      TOKENS ÚNICOS POR PARÁMETRO
    </text>
    {runs.map((r, i) => {
      const y = 40 + i * 40;
      return (
        <g>
          <text x="16" y={y + 13} font-weight="600">
            {r.name}
          </text>
          <text x="16" y={y + 27} font-size="10" fill="var(--muted)">
            {r.detail}
          </text>
          <rect
            x={x0}
            y={y + 2}
            width={r.ratio * scale}
            height="20"
            fill="var(--split-4)"
            fill-opacity="0.75"
          />
          <text x={x0 + r.ratio * scale + 8} y={y + 16}>
            {fmt(r.ratio)}
          </text>
        </g>
      );
    })}
    <line
      x1={x0 + 20 * scale}
      y1="32"
      x2={x0 + 20 * scale}
      y2="206"
      stroke="var(--accent-text-aa)"
      stroke-dasharray="4 4"
    ></line>
    <text
      x={x0 + 20 * scale - 6}
      y="222"
      text-anchor="end"
      fill="var(--accent-text-aa)"
      font-size="10"
    >
      Chinchilla ≈ 20 (una sola pasada)
    </text>
  </g>
</svg>
