---
/**
 * A tiny neural network: three numbers in, two layers of four neurons, two numbers out. Every
 * line is a weight, a number the training adjusts: its thickness is the size of the weight and a
 * dashed line is a negative one. The weights are made up (seeded, so the drawing is stable); the
 * caption says so.
 *
 * Animated: the numbers travel layer by layer, a dash running along every line at once, and each
 * layer lights up when the signal reaches it. That is the whole of what a network does when it
 * runs: multiply, add, pass on. The dashes use `pathLength="100"` so one keyframe moves them the
 * same share of every line, whatever its length. Without motion the figure is the network itself,
 * no dashes, nothing lit.
 */
const layers = [
  { x: 110, n: 3, name: 'entrada' },
  { x: 310, n: 4, name: 'capa 1' },
  { x: 510, n: 4, name: 'capa 2' },
  { x: 700, n: 2, name: 'salida' },
];
const top = 56;
const bottom = 236;
const ys = (n: number) =>
  Array.from({ length: n }, (_, i) =>
    n === 1 ? (top + bottom) / 2 : top + ((bottom - top) * i) / (n - 1),
  );

/* A small deterministic generator, so the made-up weights never change between builds. */
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

const edges = layers.slice(0, -1).flatMap((layer, l) => {
  const next = layers[l + 1];
  return ys(layer.n).flatMap((y1) =>
    ys(next.n).map((y2) => {
      const w = rand() * 4 - 1.6;
      return { l, x1: layer.x + 16, y1, x2: next.x - 16, y2, w };
    }),
  );
});

const inputs = ['0,8', '0,3', '1,0'];
const outputs = ['0,9', '0,1'];
---

<svg
  class="llm-net"
  viewBox="0 0 800 290"
  role="img"
  aria-label="Una red neuronal diminuta: tres números de entrada, dos capas de cuatro neuronas y dos números de salida. Cada neurona está unida a todas las de la capa siguiente, y cada línea es un peso, un número que se aprende: más gruesa si el peso es grande, discontinua si es negativo. En la versión animada, los números viajan capa a capa y cada capa se enciende al recibirlos."
>
  <g font-family="var(--font-mono)">
    {layers.map((layer) => (
      <text x={layer.x} y="24" font-size="11" text-anchor="middle" fill="var(--muted)">
        {layer.name}
      </text>
    ))}

    {edges.map((e) => (
      <line
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        stroke={e.w < 0 ? 'var(--accent-text-aa)' : 'var(--split-4)'}
        stroke-opacity="0.75"
        stroke-width={0.6 + Math.abs(e.w) * 1.1}
        stroke-dasharray={e.w < 0 ? '5 4' : undefined}
      />
    ))}

    {edges.map((e) => (
      <line
        class={`llm-net__pulse llm-net__pulse--${e.l}`}
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        pathLength="100"
        stroke="var(--accent)"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-dasharray="6 200"
      />
    ))}

    {layers.map((layer, l) =>
      ys(layer.n).map((y, i) => (
        <g>
          <circle
            class={`llm-net__node llm-net__node--${l}`}
            cx={layer.x}
            cy={y}
            r="16"
            fill="var(--box-fill)"
            stroke="var(--ink)"
          />
          {l === 0 && (
            <text x={layer.x} y={y + 4} font-size="11" text-anchor="middle" fill="var(--ink)">
              {inputs[i]}
            </text>
          )}
          {l === layers.length - 1 && (
            <text x={layer.x} y={y + 4} font-size="11" text-anchor="middle" fill="var(--ink)">
              {outputs[i]}
            </text>
          )}
        </g>
      )),
    )}

    <g font-size="10.5" fill="var(--muted)">
      <line x1="110" y1="270" x2="140" y2="270" stroke="var(--split-4)" stroke-width="3"></line>
      <text x="148" y="274">
        peso positivo grande
      </text>
      <line
        x1="320"
        y1="270"
        x2="350"
        y2="270"
        stroke="var(--accent-text-aa)"
        stroke-width="1.5"
        stroke-dasharray="5 4"
      ></line>
      <text x="358" y="274">
        peso negativo pequeño
      </text>
      <text x="792" y="274" text-anchor="end">
        cada línea = un número que se aprende
      </text>
    </g>
  </g>
</svg>

<style>
  .llm-net__pulse {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-net__pulse--0 {
      animation: llm-net-pulse-0 6s linear infinite;
    }
    .llm-net__pulse--1 {
      animation: llm-net-pulse-1 6s linear infinite;
    }
    .llm-net__pulse--2 {
      animation: llm-net-pulse-2 6s linear infinite;
    }
    .llm-net__node--0 {
      animation: llm-net-node-0 6s linear infinite;
    }
    .llm-net__node--1 {
      animation: llm-net-node-1 6s linear infinite;
    }
    .llm-net__node--2 {
      animation: llm-net-node-2 6s linear infinite;
    }
    .llm-net__node--3 {
      animation: llm-net-node-3 6s linear infinite;
    }
  }

  /* Each hop takes 20 % of the loop: 6 → −100 moves the dash from the start of every line to
     past its end. */
  @keyframes llm-net-pulse-0 {
    0%,
    10% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
    11% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    30% {
      opacity: 1;
      stroke-dashoffset: -100;
    }
    31%,
    100% {
      opacity: 0;
      stroke-dashoffset: -100;
    }
  }

  @keyframes llm-net-pulse-1 {
    0%,
    34% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
    35% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    54% {
      opacity: 1;
      stroke-dashoffset: -100;
    }
    55%,
    100% {
      opacity: 0;
      stroke-dashoffset: -100;
    }
  }

  @keyframes llm-net-pulse-2 {
    0%,
    58% {
      opacity: 0;
      stroke-dashoffset: 6;
    }
    59% {
      opacity: 1;
      stroke-dashoffset: 6;
    }
    78% {
      opacity: 1;
      stroke-dashoffset: -100;
    }
    79%,
    100% {
      opacity: 0;
      stroke-dashoffset: -100;
    }
  }

  @keyframes llm-net-node-0 {
    0% {
      fill: var(--box-fill);
    }
    3%,
    30% {
      fill: color-mix(in srgb, var(--accent) 45%, var(--box-fill));
    }
    36%,
    100% {
      fill: var(--box-fill);
    }
  }

  @keyframes llm-net-node-1 {
    0%,
    29% {
      fill: var(--box-fill);
    }
    32%,
    54% {
      fill: color-mix(in srgb, var(--accent) 45%, var(--box-fill));
    }
    60%,
    100% {
      fill: var(--box-fill);
    }
  }

  @keyframes llm-net-node-2 {
    0%,
    53% {
      fill: var(--box-fill);
    }
    56%,
    78% {
      fill: color-mix(in srgb, var(--accent) 45%, var(--box-fill));
    }
    84%,
    100% {
      fill: var(--box-fill);
    }
  }

  @keyframes llm-net-node-3 {
    0%,
    77% {
      fill: var(--box-fill);
    }
    80%,
    96% {
      fill: color-mix(in srgb, var(--accent) 45%, var(--box-fill));
    }
    100% {
      fill: var(--box-fill);
    }
  }
</style>
