---
/**
 * RoPE as clocks. Each position turns its vectors by an angle proportional to where it sits, one
 * frequency per pair of dimensions: a fast hand (the first pair really turns 1 radian per
 * position, as in M2 · el decoder) and a slow one (faster here than any real pair, so the eye can
 * follow it). What attention compares is the angle *between* two positions, which depends only on
 * how far apart they are.
 *
 * Animated: a bracket hops from pair to pair of positions two apart (0-2, 1-3, 2-4, 3-5), and every
 * one shows the same relative turn. Without motion the first bracket stays, which is the point.
 */
const moves = ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'f1b5', 'a7a6'];
const fast = 1; // radians per position
const slow = 0.25;
const cy = 100;
const r = 36;
const cx = (i: number) => 70 + i * 112;
const hand = (i: number, rate: number, len: number) => {
  const a = i * rate;
  return { x: cx(i) + len * Math.sin(a), y: cy - len * Math.cos(a) };
};
const pairs = [0, 1, 2, 3];
const deg = ((2 * fast * 180) / Math.PI).toFixed(1).replace('.', ',');
---

<svg
  class="llm-rope"
  viewBox="0 0 700 230"
  role="img"
  aria-label={`RoPE como relojes. Seis jugadas seguidas, e2e4, e7e5, g1f3, b8c6, f1b5 y a7a6, en las posiciones 0 a 5. Cada posición gira sus vectores un ángulo proporcional a su número: una manecilla rápida gira un radián por posición y una lenta gira mucho menos. Entre dos posiciones separadas por dos, por ejemplo la 0 y la 2 o la 3 y la 5, la manecilla rápida siempre ha girado lo mismo, ${deg} grados: la atención ve la distancia entre jugadas, no el número de asiento.`}
>
  <g font-family="var(--font-mono)">
    {moves.map((m, i) => {
      const f = hand(i, fast, 30);
      const s = hand(i, slow, 20);
      return (
        <g>
          <text x={cx(i)} y="46" font-size="12" text-anchor="middle" fill="var(--ink)">
            {m}
          </text>
          <circle cx={cx(i)} cy={cy} r={r} fill="var(--box-fill)" stroke="var(--ink)" />
          <line x1={cx(i)} y1={cy - r} x2={cx(i)} y2={cy - r + 5} stroke="var(--muted)" />
          <line
            x1={cx(i)}
            y1={cy}
            x2={s.x}
            y2={s.y}
            stroke="var(--ink)"
            stroke-width="4"
            stroke-linecap="round"
          />
          <line
            x1={cx(i)}
            y1={cy}
            x2={f.x}
            y2={f.y}
            stroke="var(--accent-text-aa)"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <circle cx={cx(i)} cy={cy} r="3" fill="var(--ink)" />
          <text x={cx(i)} y="152" font-size="10" text-anchor="middle" fill="var(--muted)">
            posición {i}
          </text>
        </g>
      );
    })}
    {pairs.map((p) => (
      <g class={`llm-rope__pair llm-rope__pair--${p}`}>
        <path
          d={`M ${cx(p)} 162 Q ${(cx(p) + cx(p + 2)) / 2} 190 ${cx(p + 2)} 162`}
          fill="none"
          stroke="var(--accent-text-aa)"
          stroke-width="1.5"
        />
        <text
          x={(cx(p) + cx(p + 2)) / 2}
          y="214"
          font-size="11"
          text-anchor="middle"
          fill="var(--accent-text-aa)"
        >
          dos posiciones de distancia → la rápida giró {deg}°
        </text>
      </g>
    ))}
  </g>
</svg>

<style>
  .llm-rope__pair {
    opacity: 0;
  }

  .llm-rope__pair--0 {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-rope__pair {
      animation: llm-rope-pair 8s ease-in-out infinite backwards;
    }
    .llm-rope__pair--1 {
      animation-delay: 2s;
    }
    .llm-rope__pair--2 {
      animation-delay: 4s;
    }
    .llm-rope__pair--3 {
      animation-delay: 6s;
    }
  }

  /* Each bracket is lit for a quarter of the loop, one after another. */
  @keyframes llm-rope-pair {
    0% {
      opacity: 0;
    }
    4%,
    22% {
      opacity: 1;
    }
    26%,
    100% {
      opacity: 0;
    }
  }
</style>
