---
/**
 * Mixture of experts: inside a block, a small router sends each token to two of eight feed-forward
 * experts and the other six do not run. Which experts a token gets is learned, and it rarely maps
 * to a human topic; the words are only there to tell the three tokens apart.
 *
 * Animated: three tokens go through in turn, each lighting its own pair of experts. Without
 * motion the first token and its pair are shown.
 */
const tokens = [
  { word: '«jaque»', experts: [1, 5] },
  { word: '«receta»', experts: [2, 7] },
  { word: '«función»', experts: [0, 4] },
];
const slots = ['a', 'b', 'c'];
const ex = (i: number) => ({ x: 400 + (i % 4) * 58, y: i < 4 ? 40 : 128 });
const routerX = 260;
const routerY = 110;
---

<svg
  class="llm-moe"
  viewBox="0 0 660 210"
  role="img"
  aria-label="Mezcla de expertos. Un token entra en el bloque y un enrutador pequeño lo manda a dos de ocho expertos, las redes que procesan cada token por separado; los otros seis no se ejecutan. Cada token recibe su propia pareja: el modelo tiene los parámetros de ocho expertos pero cada token solo paga el cálculo de dos."
>
  <g font-family="var(--font-mono)" font-size="10.5">
    <rect
      x="20"
      y={routerY - 20}
      width="130"
      height="40"
      fill="var(--box-fill)"
      stroke="var(--ink)"
    />
    {tokens.map((t, i) => (
      <text
        class={`llm-moe__slot llm-moe__slot--${slots[i]}`}
        x="85"
        y={routerY + 5}
        text-anchor="middle"
        font-size="13"
        fill="var(--ink)"
      >
        {t.word}
      </text>
    ))}
    <text x="20" y={routerY - 30} fill="var(--muted)">
      token
    </text>
    <line x1="150" y1={routerY} x2={routerX - 22} y2={routerY} stroke="var(--diagram-stroke)" />
    <polygon
      points={`${routerX},${routerY - 22} ${routerX + 22},${routerY} ${routerX},${routerY + 22} ${routerX - 22},${routerY}`}
      fill="var(--box-fill)"
      stroke="var(--ink)"
    />
    <text x={routerX} y={routerY + 42} text-anchor="middle" fill="var(--muted)">
      enrutador
    </text>

    {Array.from({ length: 8 }, (_, i) => {
      const e = ex(i);
      return (
        <g>
          <line
            x1={routerX + 22}
            y1={routerY}
            x2={e.x}
            y2={e.y + 21}
            stroke="var(--line)"
            stroke-dasharray="2 4"
          />
          <rect
            x={e.x}
            y={e.y}
            width="46"
            height="42"
            fill="var(--box-fill)"
            stroke="var(--line)"
          />
        </g>
      );
    })}
    {tokens.map((t, i) =>
      t.experts.map((k) => {
        const e = ex(k);
        return (
          <g class={`llm-moe__slot llm-moe__slot--${slots[i]}`}>
            <line
              x1={routerX + 22}
              y1={routerY}
              x2={e.x}
              y2={e.y + 21}
              stroke="var(--accent-text-aa)"
              stroke-width="2"
            />
            <rect
              x={e.x}
              y={e.y}
              width="46"
              height="42"
              fill="color-mix(in srgb, var(--accent) 45%, var(--box-fill))"
              stroke="var(--accent-text-aa)"
              stroke-width="2"
            />
          </g>
        );
      }),
    )}
    {Array.from({ length: 8 }, (_, i) => {
      const e = ex(i);
      return (
        <text x={e.x + 23} y={e.y + 25} text-anchor="middle" fill="var(--ink)">
          E{i + 1}
        </text>
      );
    })}
    <text x="400" y="196" fill="var(--muted)">
      8 expertos · cada token usa 2
    </text>
  </g>
</svg>

<style>
  .llm-moe__slot--b,
  .llm-moe__slot--c {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-moe__slot--a {
      animation: llm-moe-a 9s steps(1) infinite;
    }
    .llm-moe__slot--b {
      animation: llm-moe-b 9s steps(1) infinite;
    }
    .llm-moe__slot--c {
      animation: llm-moe-c 9s steps(1) infinite;
    }
  }

  @keyframes llm-moe-a {
    0% {
      opacity: 1;
    }
    33.3%,
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-moe-b {
    0% {
      opacity: 0;
    }
    33.3% {
      opacity: 1;
    }
    66.6%,
    100% {
      opacity: 0;
    }
  }

  @keyframes llm-moe-c {
    0% {
      opacity: 0;
    }
    66.6%,
    100% {
      opacity: 1;
    }
  }
</style>
