---
/**
 * What M2 measured when it exported `rukh-small` to ONNX in three precisions: file size and
 * parity (how often the exported model picks the same move as the PyTorch one). Real numbers from
 * lesson m2/07; M6 then measured the Elo cost of int8 and found none it could tell from noise
 * with 160 games. Static: the numbers are the point.
 */
const rows = [
  { name: 'fp32', bits: '32 bits por peso', mb: 156.7, parity: '100 %' },
  { name: 'fp16', bits: '16 bits', mb: 78.8, parity: '99,80 %' },
  { name: 'int8', bits: '8 bits', mb: 43.5, parity: '95,40 %' },
];
const x0 = 150;
const scale = 2.2;
const fmt = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 1 });
---

<svg
  class="llm-sp"
  viewBox="0 0 640 170"
  role="img"
  aria-label="El modelo small de Rukh exportado a ONNX en tres precisiones, medido en la lección de exportación. En fp32, 32 bits por peso, ocupa 156,7 MB y coincide con PyTorch en el 100 % de las posiciones. En fp16 ocupa 78,8 MB y coincide en el 99,80 %. En int8 ocupa 43,5 MB y coincide en el 95,40 %: en una de cada veinte posiciones elige otra jugada."
>
  <g font-family="var(--font-mono)" font-size="11">
    <text x="16" y="20" fill="var(--muted)">
      precisión
    </text>
    <text x={x0} y="20" fill="var(--muted)">
      tamaño del fichero
    </text>
    <text x="624" y="20" text-anchor="end" fill="var(--muted)">
      misma jugada que PyTorch
    </text>
    {rows.map((r, i) => {
      const y = 36 + i * 44;
      return (
        <g>
          <text x="16" y={y + 15} font-size="13" fill="var(--ink)" font-weight="500">
            {r.name}
          </text>
          <text x="16" y={y + 30} font-size="9.5" fill="var(--muted)">
            {r.bits}
          </text>
          <rect
            x={x0}
            y={y}
            width={r.mb * scale}
            height="22"
            fill={i === 2 ? 'var(--accent)' : 'var(--split-3)'}
            fill-opacity={i === 2 ? 0.9 : 0.6}
          />
          <text x={x0 + r.mb * scale + 8} y={y + 15} fill="var(--ink)">
            {fmt(r.mb)} MB
          </text>
          <text x="624" y={y + 15} text-anchor="end" fill="var(--ink)" font-weight="500">
            {r.parity}
          </text>
        </g>
      );
    })}
  </g>
</svg>
