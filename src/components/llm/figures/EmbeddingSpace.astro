---
/**
 * Embeddings as places on a map, squashed to two dimensions (a real model has hundreds or
 * thousands, and no axis means anything by itself). Words used in similar contexts end up close:
 * animals with animals, fruit with fruit. And some directions carry meaning: the step from
 * "hombre" to "rey" is about the same as from "mujer" to "reina". Coordinates are illustrative,
 * drawn by hand to show the idea, not taken from a trained model; the caption says so.
 *
 * Animated: the words start scattered (a freshly initialised table is noise) and drift into their
 * neighbourhoods, as training does; then the groups and the king/queen parallelogram appear.
 * Without motion the figure is the trained map.
 */
type Pt = { word: string; x: number; y: number; from: 'd' | 'b' | 'c' | 'e' };

const points: Pt[] = [
  { word: 'gato', x: 120, y: 72, from: 'd' },
  { word: 'perro', x: 170, y: 100, from: 'b' },
  { word: 'pato', x: 96, y: 118, from: 'd' },
  { word: 'caballo', x: 160, y: 50, from: 'd' },
  { word: 'manzana', x: 560, y: 226, from: 'c' },
  { word: 'pera', x: 606, y: 252, from: 'e' },
  { word: 'naranja', x: 590, y: 196, from: 'e' },
  { word: 'hombre', x: 320, y: 232, from: 'b' },
  { word: 'mujer', x: 430, y: 232, from: 'e' },
  { word: 'rey', x: 320, y: 132, from: 'd' },
  { word: 'reina', x: 430, y: 132, from: 'b' },
];
const at = (w: string) => points.find((p) => p.word === w)!;
const hombre = at('hombre');
const mujer = at('mujer');
const rey = at('rey');
const reina = at('reina');
---

<svg
  class="llm-es"
  viewBox="0 0 700 300"
  role="img"
  aria-label="Un mapa de embeddings aplastado a dos dimensiones, con posiciones de ejemplo. Las palabras que se usan en contextos parecidos quedan cerca: gato, perro, pato y caballo forman un grupo; manzana, pera y naranja, otro; hombre, mujer, rey y reina, un tercero. Además, algunas direcciones significan algo: la flecha que va de hombre a rey es casi la misma que va de mujer a reina, así que rey menos hombre más mujer cae cerca de reina. En la versión animada las palabras empiezan desordenadas, como en una tabla recién inicializada, y el entrenamiento las lleva a su sitio."
>
  <defs>
    <marker
      id="llm-es-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--accent-text-aa)"></path>
    </marker>
    <marker
      id="llm-es-arrow-muted"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 L10 5 L0 10 Z" fill="var(--muted)"></path>
    </marker>
  </defs>

  <rect x="8" y="8" width="684" height="284" fill="none" stroke="var(--line)"></rect>

  <g class="llm-es__late" font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    <ellipse
      cx="140"
      cy="86"
      rx="96"
      ry="62"
      fill="none"
      stroke="var(--diagram-stroke)"
      stroke-dasharray="4 4"
    ></ellipse>
    <text x="52" y="164">
      animales
    </text>
    <ellipse
      cx="590"
      cy="226"
      rx="80"
      ry="52"
      fill="none"
      stroke="var(--diagram-stroke)"
      stroke-dasharray="4 4"
    ></ellipse>
    <text x="548" y="170">
      frutas
    </text>

    <line
      x1={hombre.x}
      y1={hombre.y - 8}
      x2={rey.x}
      y2={rey.y + 10}
      stroke="var(--muted)"
      stroke-dasharray="3 3"
      marker-end="url(#llm-es-arrow-muted)"
    ></line>
    <line
      x1={hombre.x + 8}
      y1={hombre.y}
      x2={mujer.x - 10}
      y2={mujer.y}
      stroke="var(--muted)"
      stroke-dasharray="3 3"
      marker-end="url(#llm-es-arrow-muted)"
    ></line>
    <line
      x1={mujer.x}
      y1={mujer.y - 8}
      x2={reina.x}
      y2={reina.y + 10}
      stroke="var(--accent-text-aa)"
      stroke-width="2"
      marker-end="url(#llm-es-arrow)"
    ></line>
    <text x={hombre.x - 70} y="186">
      «realeza»
    </text>
    <text x={hombre.x + 22} y={hombre.y + 20}>
      «femenino»
    </text>
    <text x={mujer.x + 12} y="186" fill="var(--accent-text-aa)">
      rey − hombre + mujer ≈ reina
    </text>
  </g>

  <g font-family="var(--font-display)" font-size="14" fill="var(--ink)">
    {points.map((p) => (
      <g class={`llm-es__pt llm-es__pt--${p.from}`}>
        <circle cx={p.x} cy={p.y} r="5" fill="var(--split-3)" stroke="var(--ink)" />
        <text x={p.x + 10} y={p.y + 5}>
          {p.word}
        </text>
      </g>
    ))}
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .llm-es__pt--b {
      animation: llm-es-from-b 9s ease-in-out infinite;
    }
    .llm-es__pt--c {
      animation: llm-es-from-c 9s ease-in-out infinite;
    }
    .llm-es__pt--d {
      animation: llm-es-from-d 9s ease-in-out infinite;
    }
    .llm-es__pt--e {
      animation: llm-es-from-e 9s ease-in-out infinite;
    }
    .llm-es__late {
      animation: llm-es-late 9s ease-out infinite;
    }
  }

  /* Four scatter directions, chosen so every word starts inside the frame. */
  @keyframes llm-es-from-b {
    0%,
    8% {
      transform: translate(150px, -30px);
    }
    45%,
    100% {
      transform: translate(0, 0);
    }
  }

  @keyframes llm-es-from-c {
    0%,
    8% {
      transform: translate(-60px, -80px);
    }
    45%,
    100% {
      transform: translate(0, 0);
    }
  }

  @keyframes llm-es-from-d {
    0%,
    8% {
      transform: translate(120px, 60px);
    }
    45%,
    100% {
      transform: translate(0, 0);
    }
  }

  @keyframes llm-es-from-e {
    0%,
    8% {
      transform: translate(-200px, -40px);
    }
    45%,
    100% {
      transform: translate(0, 0);
    }
  }

  @keyframes llm-es-late {
    0%,
    48% {
      opacity: 0;
    }
    58%,
    94% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
