---
/**
 * The whole machine in one picture: a sentence goes in, is cut into tokens and ids, becomes
 * vectors with their position, crosses the stack of blocks (attention, then MLP; the residual path
 * is chapter 6's figure and is left out here to keep the route readable), comes out as logits, softmax, a draw, and the new token goes back in at the start. Each
 * station names the chapter that explains it. The ids are made up; the caption says so.
 *
 * The route is a U: left to right along the top, down through the blocks, right to left along
 * the bottom, and up the left side back to the text (chapter 10's loop).
 *
 * Animated: the stations light up in the order the token visits them and the arrow between two
 * stations flashes as it crosses; the new token holds for a moment and the loop arrow takes it
 * back to the start. One keyframe per station because each has its own window in the 12 s loop.
 * Without motion the figure is the route itself, nothing lit.
 */
interface Station {
  x: number;
  y: number;
  w: number;
  h?: number;
  cap: string;
  title: string;
  detail: string;
}

const H = 66;
const stations: Station[] = [
  { x: 8, y: 34, w: 132, cap: 'entra', title: 'Texto', detail: '«me llevo el»' },
  { x: 168, y: 34, w: 132, cap: 'cap. 02', title: 'Tokens', detail: 'me·␣llevo·␣el' },
  { x: 328, y: 34, w: 112, cap: 'cap. 02', title: 'Ids', detail: '412 8830 97' },
  { x: 468, y: 34, w: 140, cap: 'cap. 03 · 04', title: 'Vectores', detail: '+ su posición' },
  { x: 666, y: 58, w: 132, h: 58, cap: 'cap. 05', title: 'Atención', detail: 'se miran' },
  { x: 666, y: 150, w: 132, h: 58, cap: 'cap. 06', title: 'MLP', detail: 'cada uno piensa' },
  { x: 468, y: 196, w: 140, cap: 'cap. 06 · 09', title: 'Logits', detail: 'una nota por token' },
  { x: 328, y: 196, w: 112, cap: 'cap. 09', title: 'Softmax', detail: 'probabilidades' },
  { x: 168, y: 196, w: 132, cap: 'cap. 09', title: 'Muestreo', detail: 'se tira el dado' },
  { x: 8, y: 196, w: 132, cap: 'sale', title: 'Token nuevo', detail: '«paraguas»' },
];

/* Arrow j goes from station j to station j + 1; the last one closes the loop. */
const head = (x: number, y: number, dir: 'r' | 'l' | 'd' | 'u') => {
  const s = 5;
  if (dir === 'r') return `M ${x - s} ${y - 4} L ${x} ${y} L ${x - s} ${y + 4}`;
  if (dir === 'l') return `M ${x + s} ${y - 4} L ${x} ${y} L ${x + s} ${y + 4}`;
  if (dir === 'd') return `M ${x - 4} ${y - s} L ${x} ${y} L ${x + 4} ${y - s}`;
  return `M ${x - 4} ${y + s} L ${x} ${y} L ${x + 4} ${y + s}`;
};
const arrows = [
  `M 144 67 H 164 ${head(164, 67, 'r')}`,
  `M 304 67 H 324 ${head(324, 67, 'r')}`,
  `M 444 67 H 464 ${head(464, 67, 'r')}`,
  `M 612 67 H 640 V 87 H 662 ${head(662, 87, 'r')}`,
  `M 732 120 V 146 ${head(732, 146, 'd')}`,
  `M 732 212 V 229 H 612 ${head(612, 229, 'l')}`,
  `M 464 229 H 444 ${head(444, 229, 'l')}`,
  `M 324 229 H 304 ${head(304, 229, 'l')}`,
  `M 164 229 H 144 ${head(144, 229, 'l')}`,
  `M 74 192 V 104 ${head(74, 104, 'u')}`,
];
---

<svg
  class="llm-tj"
  viewBox="0 0 820 290"
  role="img"
  aria-label="El viaje de un token por el modelo entero, en forma de U. Arriba, de izquierda a derecha: el texto «me llevo el» se corta en tokens y cada token se cambia por su número (capítulo 2); cada número se cambia por un vector y se le suma su posición (capítulos 3 y 4). A la derecha, los vectores atraviesan la pila de bloques, cada uno con atención (capítulo 5) y MLP (capítulo 6); en Rukh son doce. Abajo, de derecha a izquierda: la última capa da una nota por token, los logits; el softmax los convierte en probabilidades y el muestreo elige uno (capítulo 9). El token nuevo, «paraguas», vuelve a entrar por el principio junto al texto (capítulo 10). En la versión animada las estaciones se encienden en el orden en que el token las recorre."
>
  <g font-family="var(--font-mono)">
    <rect
      x="646"
      y="20"
      width="166"
      height="248"
      fill="none"
      stroke="var(--diagram-stroke)"
      stroke-dasharray="4 4"
    ></rect>
    <text x="656" y="40" font-size="10" fill="var(--ink)">
      bloque · se repite
    </text>
    <text x="656" y="258" font-size="10" fill="var(--accent-text-aa)">
      × 12 en rukh-small
    </text>

    {arrows.map((d, j) => (
      <path
        class={`llm-tj__arrow llm-tj__arrow--${j}`}
        d={d}
        fill="none"
        stroke="var(--diagram-stroke)"
        stroke-width="1.5"
      />
    ))}
    <text x="84" y="152" font-size="10" fill="var(--muted)">
      cap. 10 · vuelve
    </text>
    <text x="84" y="166" font-size="10" fill="var(--muted)">
      a entrar
    </text>

    {stations.map((s, i) => {
      const h = s.h ?? H;
      return (
        <g>
          <rect
            class={`llm-tj__box llm-tj__box--${i}`}
            x={s.x}
            y={s.y}
            width={s.w}
            height={h}
            fill="var(--box-fill)"
            stroke="var(--ink)"
          />
          <text x={s.x + 10} y={s.y + 15} font-size="9.5" fill="var(--muted)">
            {s.cap}
          </text>
          <text
            x={s.x + 10}
            y={s.y + (h > 60 ? 35 : 32)}
            font-size="13"
            font-weight="600"
            font-family="var(--font-display)"
            fill="var(--ink)"
          >
            {s.title}
          </text>
          <text x={s.x + 10} y={s.y + (h > 60 ? 54 : 49)} font-size="10.5" fill="var(--ink-2)">
            {s.detail}
          </text>
        </g>
      );
    })}
  </g>
</svg>

