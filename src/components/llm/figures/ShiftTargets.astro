---
/**
 * Teacher forcing in one picture: the same sentence twice, the second row shifted one token to
 * the left. Every column is a training example (read everything up to here, predict the token
 * below), and all of them are computed in one pass; the causal mask is what stops a column from
 * peeking at its own answer in the row above.
 *
 * Animated: a shaded window grows over the input row one token at a time while the matching
 * target lights up, which is what each position is allowed to read and what it must produce.
 * Without motion the figure is the two rows, the arrows and the count underneath; the window and
 * the highlights exist only to move and are not drawn.
 */
const tokens = ['el', 'gato', 'duerme', 'en', 'el', 'sofá'];
const inputs = tokens.slice(0, -1);
const targets = tokens.slice(1);
const x0 = 120;
const w = 88;
const gap = 10;
const inY = 44;
const outY = 124;
const h = 30;
const colX = (i: number) => x0 + i * (w + gap);
---

<svg
  class="llm-shift"
  viewBox="0 0 640 206"
  role="img"
  aria-label="La frase «el gato duerme en el sofá» escrita dos veces. Arriba, lo que entra: el, gato, duerme, en, el. Abajo, desplazado un token, lo que debe salir en cada posición: gato, duerme, en, el, sofá. Cada columna es un ejemplo de entrenamiento: lee todo hasta ahí y predice el token de abajo. Una frase de seis tokens da cinco ejemplos, y se calculan todos a la vez; la máscara causal impide que una columna mire la respuesta. En la versión animada una ventana crece sobre la fila de arriba, token a token, mientras se enciende el objetivo de esa columna."
>
  <g font-family="var(--font-mono)">
    <text x="8" y={inY + 20} font-size="11" fill="var(--ink)">
      entra
    </text>
    <text x="8" y={outY + 20} font-size="11" fill="var(--accent-text-aa)">
      debe salir
    </text>

    <rect
      class="llm-shift__window"
      x={colX(0) - 5}
      y={inY - 5}
      width={inputs.length * (w + gap) - gap + 10}
      height={h + 10}
      fill="color-mix(in srgb, var(--split-3) 22%, transparent)"
      stroke="var(--split-4)"
      stroke-dasharray="3 3"
    ></rect>

    {inputs.map((t, i) => (
      <g>
        <rect
          x={colX(i)}
          y={inY}
          width={w}
          height={h}
          fill="var(--box-fill)"
          stroke="var(--line)"
        />
        <text
          x={colX(i) + w / 2}
          y={inY + 20}
          font-size="13"
          text-anchor="middle"
          fill="var(--ink)"
        >
          {t}
        </text>
        <path
          d={`M ${colX(i) + w / 2} ${inY + h + 6} V ${outY - 8} M ${colX(i) + w / 2 - 4} ${outY - 13} L ${colX(i) + w / 2} ${outY - 8} L ${colX(i) + w / 2 + 4} ${outY - 13}`}
          fill="none"
          stroke="var(--diagram-stroke)"
        />
        <text
          x={colX(i) + w / 2 + 6}
          y={(inY + h + outY) / 2 + 4}
          font-size="9"
          fill="var(--muted)"
        >
          ej. {i + 1}
        </text>
      </g>
    ))}

    {targets.map((t, i) => (
      <g>
        <rect
          x={colX(i)}
          y={outY}
          width={w}
          height={h}
          fill="color-mix(in srgb, var(--accent) 18%, var(--box-fill))"
          stroke="var(--accent-text-aa)"
        />
        <rect
          class={`llm-shift__hit llm-shift__hit--${i}`}
          x={colX(i)}
          y={outY}
          width={w}
          height={h}
          fill="var(--accent)"
          fill-opacity="0.55"
        />
        <text
          x={colX(i) + w / 2}
          y={outY + 20}
          font-size="13"
          text-anchor="middle"
          fill="var(--ink)"
        >
          {t}
        </text>
      </g>
    ))}

    <text x={x0} y="186" font-size="10.5" fill="var(--ink-2)">
      una frase de 6 tokens = 5 ejemplos, calculados a la vez en una sola pasada
    </text>
    <text x={x0} y="200" font-size="10" fill="var(--muted)">
      la máscara causal (cap. 05) impide que cada columna vea su propia respuesta
    </text>
  </g>
</svg>

<style>
  .llm-shift__window,
  .llm-shift__hit {
    opacity: 0;
  }

  .llm-shift__window {
    transform-box: fill-box;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .llm-shift__window {
      animation: llm-shift-window 7.5s steps(1) infinite;
    }

    .llm-shift__hit {
      animation: llm-shift-hit 7.5s steps(1) infinite;
    }

    .llm-shift__hit--1 {
      animation-delay: 1.2s;
    }
    .llm-shift__hit--2 {
      animation-delay: 2.4s;
    }
    .llm-shift__hit--3 {
      animation-delay: 3.6s;
    }
    .llm-shift__hit--4 {
      animation-delay: 4.8s;
    }
  }

  /* The hits have no `backwards` fill on purpose: during its delay a hit must stay at its base
     opacity (hidden), not at its first keyframe (lit). */
  /* Five windows of 1.2 s (16 % of the loop each), then 1.5 s of rest with nothing lit. The scale
     is the share of the full row each window covers: one column, two, three... */
  @keyframes llm-shift-window {
    0% {
      opacity: 1;
      transform: scaleX(0.2);
    }
    16% {
      opacity: 1;
      transform: scaleX(0.4);
    }
    32% {
      opacity: 1;
      transform: scaleX(0.6);
    }
    48% {
      opacity: 1;
      transform: scaleX(0.8);
    }
    64% {
      opacity: 1;
      transform: scaleX(1);
    }
    80%,
    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }

  @keyframes llm-shift-hit {
    0% {
      opacity: 1;
    }
    16%,
    100% {
      opacity: 0;
    }
  }
</style>
