---
/**
 * "Más a fondo": detail that a reader new to the subject can skip without losing the thread of
 * /como-funciona-un-llm/ (how RoPE rotates, what PPO's critic does, what prefill is). Folded by
 * default, so the main line stays light; the text is in the page either way, for search and for
 * a reader who opens everything.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="llm-deeper">
  <summary class="llm-deeper__summary">
    <span class="label llm-deeper__kind">// Más a fondo</span>
    <span class="llm-deeper__title">{title}</span>
  </summary>
  <div class="llm-deeper__body">
    <slot />
  </div>
</details>
