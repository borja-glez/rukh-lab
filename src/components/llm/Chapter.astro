---
/**
 * One chapter of /como-funciona-un-llm/: a numbered heading, the chapter's own content (the
 * slot: prose, a Simile, one or more LlmFigure) and, closing it, where the course does this step
 * with Rukh. The links, the vocabulary and what the course leaves out come from
 * src/data/llm-chapters.ts, so the index and the chapter can never disagree.
 */
import { getEntry } from 'astro:content';
import Term from '../mdx/Term.astro';
import { chapterById } from '../../data/llm-chapters';

interface Props {
  id: string;
}

const chapter = chapterById(Astro.props.id);
const terms = await Promise.all(
  chapter.terms.map(async (id) => ({
    id,
    name: (await getEntry('glossary', id))?.data.term ?? id,
  })),
);
const titleId = `${chapter.id}-titulo`;
const hasCourse =
  chapter.links.length > 0 || chapter.terms.length > 0 || (chapter.outside?.length ?? 0) > 0;
const href = (lesson: string, anchor?: string) => `/curso/${lesson}/${anchor ? `#${anchor}` : ''}`;
---

<section class="llm-ch" id={chapter.id} aria-labelledby={titleId} data-llm-chapter>
  <header class="llm-ch__head">
    <p class="label label--accent">
      // {chapter.n} · {chapter.short}
    </p>
    <h2 class="llm-ch__title" id={titleId}>
      {chapter.title}
    </h2>
  </header>

  <div class="llm-ch__body prose">
    <slot />
  </div>

  {hasCourse && (
    <aside class="llm-course" role="note" aria-label={`En el curso: ${chapter.short}`}>
      <p class="label llm-course__kicker">// En el curso, con Rukh</p>
      {chapter.links.length > 0 && (
        <ul class="llm-course__links">
          {chapter.links.map((link) => (
            <li>
              <a href={href(link.lesson, link.anchor)}>{link.label}</a>
            </li>
          ))}
        </ul>
      )}
      {chapter.outside && chapter.outside.length > 0 && (
        <ul class="llm-course__outside">
          {chapter.outside.map((note) => (
            <li>
              {note.kind === 'planned' && note.module ? (
                <a class="chip chip--draft" href={`/curso/#${note.module}`}>
                  fase 2 · planificado
                </a>
              ) : (
                <span class="chip">fuera del curso</span>
              )}
              <span>{note.label}</span>
            </li>
          ))}
        </ul>
      )}
      {chapter.terms.length > 0 && (
        <p class="llm-course__terms">
          <span class="label">Vocabulario</span>
          {terms.map((t) => (
            <Term id={t.id}>{t.name}</Term>
          ))}
        </p>
      )}
    </aside>
  )}
</section>
