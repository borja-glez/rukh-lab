---
/**
 * A figure or a widget of /como-funciona-un-llm/, in the course's blueprint frame.
 *
 * `animated` adds a pause button and hands the figure to src/scripts/llm-page.ts, which holds
 * its animations until it scrolls into view (so a sequence starts from its first frame when the
 * reader gets there) and holds them again when it leaves. The animations themselves live in the
 * figure component, declared only under `prefers-reduced-motion: no-preference`: the drawing
 * without them is the static figure, so reduced motion and no JavaScript both get it.
 *
 * `widget` marks an interactive island: it is laid out by its own CSS instead of scrolling
 * sideways like an SVG.
 */
import FigureFrame from '../FigureFrame.astro';

interface Props {
  caption: string;
  animated?: boolean;
  widget?: boolean;
}

const { caption, animated = false, widget = false } = Astro.props;
---

<figure
  class:list={['llm-fig', { 'llm-fig--widget': widget }]}
  data-llm-fig
  data-animated={animated ? '' : undefined}
>
  <FigureFrame>
    <slot />
  </FigureFrame>
  <figcaption class="caption llm-fig__caption">
    {widget && <span class="label label--accent">pruébalo</span>}
    <span class="llm-fig__text">{caption}</span>
    {animated && (
      <button type="button" class="llm-fig__toggle mono" data-llm-toggle>
        pausar
      </button>
    )}
  </figcaption>
</figure>
