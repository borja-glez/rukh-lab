---
/** Blueprint frame with four corner tick marks (same as the portfolio). */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['frame', className]}>
  <span class="frame__corner frame__corner--tl" aria-hidden="true"></span>
  <span class="frame__corner frame__corner--tr" aria-hidden="true"></span>
  <span class="frame__corner frame__corner--bl" aria-hidden="true"></span>
  <span class="frame__corner frame__corner--br" aria-hidden="true"></span>
  <div
    class="frame__scroll"
    tabindex="0"
    role="region"
    aria-label="Figura; en pantallas estrechas se desplaza a los lados"
    data-figure-scroll
  >
    <slot />
  </div>
  <!--
    The hint is `hidden` in the markup and revealed only when the figure really overflows, so a
    figure that fits never claims otherwise and a reader with no JS never sees a lie. It is
    `aria-hidden` because the region above already announces the same thing to a screen reader.
  -->
  <span class="frame__hint" data-figure-hint hidden aria-hidden="true">
    desliza para verla entera →
  </span>
</div>

<style>
  .frame {
    position: relative;
    /* A grid or flex item: never wider than its track, whatever the figure inside asks for. */
    min-width: 0;
    border: 1px solid var(--line);
    background: var(--frame-bg);
    padding: clamp(16px, 2vw, 24px);
  }

  .frame :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Figures keep a legible size on phones and scroll sideways instead of shrinking; the corner
     ticks sit outside this box so `overflow` cannot clip them. */
  .frame__scroll {
    overflow-x: auto;
  }

  .frame__scroll > :global(svg) {
    min-width: 560px;
  }

  /* Horizontal scroll inside a bordered box is discoverable by mouse and by keyboard, and
     invisible on a touch screen: nothing moves until you try. The hint says to try, and gets out
     of the way the moment you do. */
  /* A span, not a paragraph: this is a control label, and a <p> in lowercase inside .prose is
     indistinguishable from a sentence that MDX broke in half (see e2e/m4.spec.ts). */
  .frame__hint {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    transition: opacity 160ms ease;
  }

  .frame__hint[hidden] {
    display: none;
  }

  .frame__hint[data-done] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .frame__hint {
      transition: none;
    }
  }

  .frame__corner {
    position: absolute;
    width: 10px;
    height: 10px;
  }

  .frame__corner--tl {
    top: -1px;
    left: -1px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .frame__corner--tr {
    top: -1px;
    right: -1px;
    border-top: 1px solid var(--ink);
    border-right: 1px solid var(--ink);
  }

  .frame__corner--bl {
    bottom: -1px;
    left: -1px;
    border-bottom: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .frame__corner--br {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid var(--ink);
    border-right: 1px solid var(--ink);
  }

  @media (max-width: 720px) {
    .frame {
      padding: 12px;
    }
  }
</style>

<script>
  /*
    One listener set per frame, wired on load and on resize: `scrollWidth > clientWidth` is the
    only honest test, and it changes with the viewport, with the font and with a figure that
    lazy-loads. ResizeObserver covers all three.
  */
  const frames = document.querySelectorAll<HTMLElement>('[data-figure-scroll]');

  for (const scroller of frames) {
    const hint = scroller.parentElement?.querySelector<HTMLElement>('[data-figure-hint]');
    if (!hint) continue;

    const sync = () => {
      const overflows = scroller.scrollWidth - scroller.clientWidth > 4;
      hint.hidden = !overflows;
      if (!overflows) delete hint.dataset.done;
    };

    scroller.addEventListener(
      'scroll',
      () => {
        if (scroller.scrollLeft > 8) hint.dataset.done = '';
      },
      { passive: true },
    );

    new ResizeObserver(sync).observe(scroller);
    sync();
  }
</script>
