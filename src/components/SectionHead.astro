---
interface Props {
  n: string;
  label: string;
  kind: string;
}

const { n, label, kind } = Astro.props;
---

<div class="shead">
  <span class="label label--ink shead__label">
    {n} / {label}
  </span>
  <span class="shead__rule" aria-hidden="true"></span>
  <span class="label label--plain shead__label">// {kind}</span>
</div>

<style>
  .shead {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
  }

  .shead__label {
    white-space: nowrap;
  }

  .shead__rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
</style>
