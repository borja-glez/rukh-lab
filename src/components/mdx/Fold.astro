---
/**
 * A folded block of plumbing: code (or prose) that makes the project run but does not teach the
 * ML idea of the lesson. Closed by default so the reader's path stays on the model, the loss or
 * the metric; one click (or find-in-page, or printing) opens it. Usage in MDX:
 *
 *   <Fold summary="the pydantic config and its validators">
 *
 *   ```python title="src/rukh/…"
 *   …
 *   ```
 *
 *   <Src file="src/rukh/…" tag="p5" lines="1-40" />
 *
 *   </Fold>
 *
 * The content goes unindented with blank lines around it, like any other Markdown inside a
 * component, so the code blocks and their `<Src>` stay exactly as `pnpm verify:code` reads them.
 * `label` changes the kicker ("Fontanería") when the fold holds something else, such as tests.
 */
interface Props {
  summary: string;
  label?: string;
}

const { summary, label = 'Fontanería' } = Astro.props;
---

<details class="fold" data-fold>
  <summary class="fold__summary">
    <span class="label fold__kind">// {label}</span>
    <span class="fold__text">{summary}</span>
    <span class="fold__hint mono" aria-hidden="true">
      <span class="fold__hint-closed">mostrar</span>
      <span class="fold__hint-open">ocultar</span>
    </span>
  </summary>
  <div class="fold__body">
    <slot />
  </div>
</details>

<script>
  /*
   * Printing a lesson prints all of it: open every fold before the print dialog and put back the
   * ones the reader had closed afterwards. (Find-in-page already opens a closed <details> in
   * Chromium and Firefox, so a search for a function name lands inside the fold.)
   */
  let reopened: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    reopened = Array.from(
      document.querySelectorAll<HTMLDetailsElement>('details[data-fold]'),
    ).filter((fold) => !fold.open);
    reopened.forEach((fold) => (fold.open = true));
  });
  window.addEventListener('afterprint', () => {
    reopened.forEach((fold) => (fold.open = false));
    reopened = [];
  });
</script>

<style>
  .fold {
    margin-top: 1.6em;
    border: 1px solid var(--line);
    border-left: 3px solid var(--line);
  }

  .fold__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    min-height: 44px;
    padding: 11px 18px;
    cursor: pointer;
    list-style: none;
  }

  .fold__summary::-webkit-details-marker {
    display: none;
  }

  .fold__summary::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .fold[open] > .fold__summary::before {
    content: '−';
  }

  .fold__summary:hover {
    background: var(--hover-soft);
  }

  .fold__summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .fold__kind {
    color: var(--muted);
  }

  .fold__text {
    flex: 1 1 18ch;
    color: var(--ink);
  }

  .fold__hint {
    margin-left: auto;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .fold__hint-open,
  .fold[open] > .fold__summary .fold__hint-closed {
    display: none;
  }

  .fold[open] > .fold__summary .fold__hint-open {
    display: inline;
  }

  .fold__body {
    padding: 4px 18px 18px;
    border-top: 1px solid var(--line-soft);
  }

  .fold__body > :global(* + *) {
    margin-top: 0.8em;
  }

  .fold__body > :global(.expressive-code:first-child) {
    margin-top: 0.8em;
  }

  @media print {
    .fold__hint {
      display: none;
    }
  }
</style>
