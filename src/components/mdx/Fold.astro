---
/**
 * A collapsed block for long verbatim material a lesson carries but does not walk through line by
 * line (a whole test file, a helper). Usage in MDX: `<Fold summary="…">…</Fold>`.
 */
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<details class="fold">
  <summary class="fold__summary">{summary}</summary>
  <div class="fold__body">
    <slot />
  </div>
</details>

<style>
  .fold {
    margin-top: 1em;
    border: 1px solid var(--line);
  }

  .fold__summary {
    min-height: 44px;
    padding: 10px 18px;
    cursor: pointer;
  }

  .fold__body {
    padding: 4px 18px 18px;
  }

  .fold__body > :global(* + *) {
    margin-top: 0.8em;
  }
</style>
