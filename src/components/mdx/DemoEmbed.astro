---
import { SITE } from '../../lib/site';

/**
 * Card linking to the demo with a query string (e.g. query="?mock=1" or
 * "?stage=dpo&elo=1500"). With `embed`, the demo is also inlined in an iframe
 * whose height is reserved to avoid layout shift. The demo sends
 * `frame-ancestors 'none'` in this milestone, so `embed` is off by default.
 */
interface Props {
  query?: string;
  title: string;
  note?: string;
  embed?: boolean;
}

const { query = '', title, note, embed = false } = Astro.props;
const href = `${SITE.demoUrl}/${query}`;
---

<div class="demo">
  {embed && <iframe
    class="demo__frame"
    src={href}
    title={title}
    loading="lazy"
    allow="cross-origin-isolated"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>}
  <div class="demo__bar">
    <div class="demo__text">
      <span class="label label--accent">// demo</span>
      <span class="demo__title">{title}</span>
      {note && <span class="caption demo__note">{note}</span>}
    </div>
    <a class="btn btn--primary btn--small" href={href} rel="noopener">
      Abrir la demo
      <span class="btn__aux">{query || '/'}</span>
    </a>
  </div>
</div>

<style>
  .demo {
    margin-top: 1.6em;
    border: 1px solid var(--line);
    background: var(--frame-bg);
  }

  .demo__frame {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 720px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .demo__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 16px 18px;
  }

  .demo__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .demo__title {
    font-weight: 600;
    color: var(--ink);
  }
</style>
