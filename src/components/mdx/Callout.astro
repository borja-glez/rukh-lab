---
/**
 * Lesson aside. Kinds (docs/04): teoria (just enough theory), mundo-real (in the
 * real world), entrevista (interview question), hoy (how it is done today), roto
 * (a real mistake and what it teaches; at most one per lesson), ejecuta (stop and run this now: the commands that prove what was just
 * written works, and what to look for in their output), guia (where to start from and how to
 * work through the lesson: the repo at a tag, what to have on disk, what to leave commented out).
 */
type Kind = 'teoria' | 'mundo-real' | 'entrevista' | 'hoy' | 'roto' | 'ejecuta' | 'guia';

interface Props {
  kind: Kind;
  title?: string;
}

const { kind, title } = Astro.props;

const labels: Record<Kind, string> = {
  teoria: 'Teoría justa',
  'mundo-real': 'En el mundo real',
  entrevista: 'Pregunta de entrevista',
  hoy: 'Así se hace hoy',
  roto: 'Error que enseña',
  ejecuta: 'Ejecútalo',
  guia: 'Para situarte',
};

/** The accessible name: the kind, plus the heading when there is one, so two notes differ. */
const label = title ? `${labels[kind]}: ${title}` : labels[kind];
---

<!--
  `role="note"` rather than the `<aside>` default of `complementary`. A landmark is for navigating
  *between* regions of a page, and a lesson with ten asides is ten landmarks with the same name --
  which axe flags as `landmark-unique` and which is, for a screen-reader user moving by landmark,
  exactly as useless as it sounds. A note is an inline remark about the text around it, which is
  what these are.
-->
<aside class:list={['callout', `callout--${kind}`]} role="note" aria-label={label}>
  <p class="callout__head">
    <span class="label callout__kind">// {labels[kind]}</span>
    {title && <span class="callout__title">{title}</span>}
  </p>
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    --callout-color: var(--brand);
    position: relative;
    margin-top: 1.6em;
    padding: 18px 20px 18px 24px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--callout-color);
    background: var(--frame-bg);
  }

  .callout--teoria {
    --callout-color: var(--brand);
  }

  .callout--mundo-real {
    --callout-color: var(--ok);
  }

  .callout--entrevista {
    --callout-color: var(--accent-text-aa);
  }

  .callout--hoy {
    --callout-color: var(--event-text-aa);
  }

  .callout--guia {
    --callout-color: var(--muted);
  }

  .callout--roto {
    --callout-color: var(--ink);
    border-style: dashed;
    border-left-style: solid;
  }

  .callout--ejecuta {
    --callout-color: var(--ok);
    border-left-width: 6px;
    border-left-style: double;
  }

  .callout__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-bottom: 8px;
  }

  .callout__kind {
    color: var(--callout-color);
  }

  .callout--roto .callout__kind {
    color: var(--ink);
  }

  .callout__title {
    font-weight: 600;
    color: var(--ink);
  }

  .callout__body {
    font-size: 0.95em;
  }

  .callout__body > :global(* + *) {
    margin-top: 0.8em;
  }
</style>
