---
/** Badge linking to a model or dataset card on the Hub, e.g. repo="chorcat/rukh-small". */
interface Props {
  repo: string;
  kind?: 'model' | 'dataset';
  label?: string;
}

const { repo, kind = 'model', label } = Astro.props;
const href = `https://huggingface.co/${kind === 'dataset' ? 'datasets/' : ''}${repo}`;
---

<a class="badge mono" href={href} rel="noopener">
  <span class="badge__kind">{kind === 'dataset' ? 'dataset' : 'model'}</span>
  <span class="badge__repo">{label ?? repo}</span>
</a>

<style>
  .badge {
    display: inline-flex;
    align-items: stretch;
    min-height: 32px;
    margin: 0.2em 0.2em 0 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 12px;
    text-decoration: none;
    overflow: hidden;
    vertical-align: middle;
  }

  .badge:hover {
    border-color: var(--ink);
  }

  .badge__kind {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    background: var(--ink);
    color: var(--paper);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 10px;
  }

  .badge__repo {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    background: var(--chip-bg);
    color: var(--ink);
  }
</style>
