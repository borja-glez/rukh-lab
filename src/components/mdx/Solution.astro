---
interface Props {
  label?: string;
}

const { label = 'Ver la solución' } = Astro.props;
---

<details class="solution">
  <summary class="solution__summary">
    <span class="label label--ink">// Solución</span>
    <span class="solution__label">{label}</span>
  </summary>
  <div class="solution__body">
    <slot />
  </div>
</details>

<style>
  .solution {
    margin-top: 1em;
    border: 1px solid var(--line);
  }

  .solution__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    min-height: 44px;
    padding: 10px 18px;
    cursor: pointer;
    list-style: none;
  }

  .solution__summary::-webkit-details-marker {
    display: none;
  }

  .solution__summary::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .solution[open] .solution__summary::before {
    content: '−';
  }

  .solution__summary:hover {
    background: var(--hover-soft);
  }

  .solution__label {
    color: var(--ink);
  }

  .solution__body {
    padding: 4px 18px 18px;
    border-top: 1px solid var(--line-soft);
  }

  .solution__body > :global(* + *) {
    margin-top: 0.8em;
  }
</style>
