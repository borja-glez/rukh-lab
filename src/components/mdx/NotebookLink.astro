---
import { SITE } from '../../lib/site';

/** Link to a lab notebook in the ML repo, e.g. path="labs/m1/01-explore.ipynb". */
interface Props {
  path: string;
  label?: string;
}

const { path, label } = Astro.props;
const href = `${SITE.githubUrl}/rukh/blob/main/${path.replace(/^\/+/, '')}`;
const name = path.split('/').pop() ?? path;
---

<a class="nb" href={href} rel="noopener">
  <span class="nb__icon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24">
      <path d="M6 3h9l5 5v13H6ZM14 3v6h6M9 13h6M9 17h6"></path>
    </svg>
  </span>
  <span class="nb__text">
    <span class="label label--plain">// notebook</span>
    <span class="nb__name mono">{label ?? name}</span>
  </span>
</a>

<style>
  .nb {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-top: 1em;
    padding: 8px 16px 8px 12px;
    border: 1px solid var(--line);
    background: var(--frame-bg);
    color: var(--ink);
    text-decoration: none;
  }

  .nb:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .nb__icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .nb__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nb__name {
    font-size: 13px;
  }
</style>
