---
interface Props {
  title: string;
  /** Exercise number within the lesson, e.g. "01". */
  n?: string;
}

const { title, n } = Astro.props;

/*
 * MDX does not type-check props, so `title: string` above was advice, not a rule: M5 and M6
 * shipped seventeen exercises with no title and rendered a bare `// Ejercicio` with an empty
 * span next to it. Fail the build instead.
 */
if (!title) throw new Error('Exercise: falta el título (y el número) del ejercicio');
---

<section class="exercise">
  <p class="exercise__head">
    <span class="label label--accent">// Ejercicio{n ? ` ${n}` : ''}</span>
    <span class="exercise__title">{title}</span>
  </p>
  <div class="exercise__body">
    <slot />
  </div>
</section>

<style>
  .exercise {
    margin-top: 1.8em;
    padding: 20px 22px;
    border: 1px solid var(--ink);
    background: var(--frame-bg);
  }

  .exercise__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-bottom: 10px;
  }

  .exercise__title {
    font-weight: 600;
    color: var(--ink);
  }

  .exercise__body > :global(* + *) {
    margin-top: 0.8em;
  }
</style>
