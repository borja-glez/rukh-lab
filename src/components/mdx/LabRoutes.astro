---
/**
 * The map of a lab lesson: every lab with its route, its clock, what it leaves and its shortcut.
 *
 * Goes once, at the top of the labs section, before the first lab. The point is comparison: a
 * reader with no GPU should be able to see in one glance which rows they can still do tonight
 * and which ones they will download instead. Data and rationale in `src/data/lab-routes.ts`.
 *
 * On phones the table becomes a list of cards, because five columns of prose at 360 px is not a
 * table any more, it is a puzzle.
 */
import { labRoutes, routeHelp, routeLabels } from '../../data/lab-routes';

interface Props {
  /** The lesson id, e.g. `m2/02-entrenar-y-medir`. */
  lesson: string;
}

const { lesson } = Astro.props;
const rows = labRoutes[lesson];
if (!rows) throw new Error(`LabRoutes: no hay rutas para la lección "${lesson}"`);

const used = [...new Set(rows.map((r) => r.route))];
---

<section class="routes" aria-labelledby={`routes-${lesson.replace('/', '-')}`}>
  <p class="routes__head">
    <span class="label label--accent">// Antes de empezar</span>
    <span id={`routes-${lesson.replace('/', '-')}`} class="routes__title">
      Qué cuesta cada lab, y cuál puedes saltarte
    </span>
  </p>

  <table class="routes__table">
    <thead>
      <tr>
        <th scope="col">Lab</th>
        <th scope="col">Ruta</th>
        <th scope="col">Reloj</th>
        <th scope="col">Deja</th>
        <th scope="col">Atajo</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row" data-th="Lab">
            <span class="mono routes__lab">{r.lab}</span>
            <span class="routes__what">{r.what}</span>
          </th>
          <td data-th="Ruta">
            <span class:list={['routes__route', `routes__route--${r.route}`]}>
              {routeLabels[r.route]}
            </span>
          </td>
          <td data-th="Reloj" class="routes__clock">
            {r.clock}
          </td>
          <td data-th="Deja" class="routes__gives">
            {r.gives}
          </td>
          <td data-th="Atajo">
            {r.skip ? <code>{r.skip}</code> : <span class="routes__none">no hay</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <dl class="routes__legend">
    {used.map((route) => (
      <div class="routes__legend-row">
        <dt class:list={['routes__route', `routes__route--${route}`]}>{routeLabels[route]}</dt>
        <dd>{routeHelp[route]}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .routes {
    margin-top: 1.8em;
    border: 1px solid var(--ink);
    background: var(--frame-bg);
  }

  .routes__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    padding: 18px 22px 12px;
  }

  .routes__title {
    font-weight: 600;
    color: var(--ink);
  }

  /* Fixed widths, because auto layout gives the room to whichever cell happens to hold the
     longest command and squeezes the lab title into two words per line. */
  .routes__table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  .routes__table thead th:nth-child(1) {
    width: 26%;
  }

  .routes__table thead th:nth-child(2) {
    width: 16%;
  }

  .routes__table thead th:nth-child(3) {
    width: 17%;
  }

  .routes__table thead th:nth-child(4) {
    width: 25%;
  }

  .routes__table thead th:nth-child(5) {
    width: 16%;
  }

  .routes__table th,
  .routes__table td {
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    vertical-align: top;
    font-weight: 400;
  }

  .routes__table thead th {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .routes__table th:first-child {
    padding-left: 22px;
  }

  .routes__table td:last-child {
    padding-right: 22px;
  }

  .routes__lab {
    display: block;
    font-size: 12px;
    color: var(--muted);
  }

  /* `.prose th` is uppercase 11px mono for a real table header; this row header is a lab title
     and has to read as prose. */
  .routes__what {
    display: block;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
  }

  /* Half of these are prose ("el desglose por bloque, que cuadra con el total") and half are
     paths; mono set the whole column four words to a line for no gain. The commands that must
     be typed exactly live in the Atajo column, where they keep their <code>. */
  .routes__gives {
    font-size: 13px;
    overflow-wrap: break-word;
  }

  .routes__clock {
    font-variant-numeric: tabular-nums;
  }

  .routes__route {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
  }

  .routes__route--imprescindible {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  /* --accent is the flat brand colour and fails AA as 11px text (2,02:1 on light paper);
     --accent-text-aa is the darkened pair the rest of the site already uses for the same job. */
  .routes__route--con-gpu {
    color: var(--accent-text-aa);
    border-color: currentColor;
  }

  .routes__route--observar {
    color: var(--muted);
  }

  .routes__table code {
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .routes__none {
    color: var(--muted);
  }

  .routes__legend {
    padding: 14px 22px 18px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }

  .routes__legend-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
  }

  .routes__legend-row + .routes__legend-row {
    margin-top: 8px;
  }

  .routes__legend dd {
    flex: 1 1 22ch;
    margin: 0;
  }

  /* Under 640 px five columns of prose stop being a table; each row becomes a card with its
     header inline, so nothing scrolls sideways and nothing shrinks to six characters wide. */
  @media (max-width: 640px) {
    .routes__table,
    .routes__table tbody,
    .routes__table tr,
    .routes__table th,
    .routes__table td {
      display: block;
    }

    .routes__table {
      table-layout: auto;
    }

    .routes__table thead {
      display: none;
    }

    .routes__table tr {
      border-top: 1px solid var(--line);
      padding: 6px 0;
    }

    .routes__table th,
    .routes__table td {
      border-top: 0;
      padding: 3px 16px;
    }

    .routes__table th:first-child {
      padding: 8px 16px 4px;
    }

    .routes__table td::before {
      content: attr(data-th) ' · ';
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
    }

    .routes__head,
    .routes__legend {
      padding-inline: 16px;
    }
  }
</style>
