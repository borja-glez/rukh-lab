---
import results from '../../data/results.json';

/**
 * The single results table (docs/02 §5), read from src/data/results.json which
 * `pnpm sync:data` copies from the ML repo. Renders an "empty" row until the
 * first model is evaluated.
 */
interface Props {
  lang?: 'es' | 'en';
  emptyText?: string;
}

const { lang = 'es', emptyText } = Astro.props;

type Row = Record<string, string | number | null | undefined>;
const columns = results.columns as { key: string; label: string }[];
const rows = results.rows as Row[];
const empty =
  emptyText ??
  (lang === 'en'
    ? 'No results yet: the first model is trained in module 2.'
    : 'Todavía no hay resultados: el primer modelo se entrena en el módulo 2.');
const updated = results.updated
  ? new Date(results.updated).toLocaleDateString(lang === 'en' ? 'en-GB' : 'es-ES')
  : null;
---

<div class="results">
  <div class="table-wrap">
    <table class="results__table">
      <thead>
        <tr>
          {columns.map((c) => (
            <th scope="col">{c.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 ? (
          <tr>
            <td class="results__empty" colspan={columns.length}>
              {empty}
            </td>
          </tr>
        ) : (
          rows.map((row) => (
            <tr>
              {columns.map((c) =>
                c.key === 'hub' && typeof row[c.key] === 'string' ? (
                  <td>
                    <a href={`https://huggingface.co/${row[c.key]}`} rel="noopener">
                      {row[c.key]}
                    </a>
                  </td>
                ) : (
                  <td>{row[c.key] ?? '—'}</td>
                ),
              )}
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
  <p class="caption results__meta">
    {lang === 'en' ? 'Source' : 'Fuente'}: <code>rukh eval nightly</code>
    {updated && ` · ${lang === 'en' ? 'updated' : 'actualizado'} ${updated}`}
  </p>
</div>

<style>
  .results {
    margin-top: 1.6em;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--frame-bg);
  }

  .results__table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .results__table th,
  .results__table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
    white-space: nowrap;
  }

  .results__table th {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--ink);
  }

  .results__empty {
    color: var(--muted);
    white-space: normal;
  }

  .results__meta {
    margin-top: 8px;
  }
</style>
