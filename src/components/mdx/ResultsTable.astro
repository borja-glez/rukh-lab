---
import results from '../../data/results.json';

/**
 * The single results table (docs/02 §5), read from src/data/results.json which
 * `pnpm sync:data` copies from `rukh/artifacts/web/results.json` (written by `rukh eval`).
 * Renders an "empty" row until the first model is evaluated.
 *
 * Two shapes are accepted, because the placeholder committed here and the file the ML repo
 * writes are not the same document:
 *
 * - placeholder: `{ updated, columns: [{key,label}], rows: [] }` — flat, already formatted.
 * - `rukh eval`: `{ updated_at, rows: [{ stage, params, legality, legality_sampled, top1, top3,
 *   puzzles: {"1000-1500": 0.347, …}, elo, elo_ci: [lo, hi], delta_cp, … }] }` — raw numbers as
 *   fractions, nested puzzle bands, no columns and no labels.
 *
 * Since M3 the file also carries rows with `kind: "encoder"`, which share not one measurement with
 * a decoder: no legality, no top-1, no Elo, and instead blunder F1 against the material baseline
 * (at a threshold chosen on a held-out `tune` half, plus the fixed 0.5 one), ROC AUC, average
 * precision, the base rate of the positive class, and the two value correlations. Squeezing them
 * into the decoder's columns would print a row of em dashes, so they get their own table below.
 *
 * The columns live here and not in the data: the ML repo publishes measurements, the site decides
 * how to name and order them.
 */
interface Props {
  emptyText?: string;
}

const { emptyText } = Astro.props;

type Json = Record<string, unknown>;
type Cell = string | null;

const LABELS: Record<'es', { key: string; label: string }[]> = {
  es: [
    { key: 'stage', label: 'Etapa' },
    { key: 'params', label: 'Parámetros' },
    { key: 'legal', label: 'Legalidad sin máscara (%)' },
    { key: 'top1', label: 'Top-1 (%)' },
    { key: 'top3', label: 'Top-3 (%)' },
    { key: 'puzzles_1000', label: 'Puzles 1000-1500 (%)' },
    { key: 'puzzles_1500', label: 'Puzles 1500-2000 (%)' },
    { key: 'puzzles_2000', label: 'Puzles 2000+ (%)' },
    { key: 'elo', label: 'Elo vs Stockfish (IC 95 %)' },
    { key: 'dcp', label: 'Δ medio (cp)' },
    { key: 'hub', label: 'Hugging Face' },
  ],
};

/** The encoder's own columns: nothing here is comparable with a decoder's row. */
const ENCODER_LABELS: Record<'es', { key: string; label: string }[]> = {
  es: [
    { key: 'stage', label: 'Etapa' },
    { key: 'params', label: 'Parámetros' },
    { key: 'f1', label: 'F1 de error, umbral ajustado (%)' },
    { key: 'threshold', label: 'Umbral (elegido en «tune»)' },
    { key: 'f1_fixed', label: 'F1 de error, umbral 0,5 (%)' },
    { key: 'f1_heuristic', label: 'F1 de la heurística (%)' },
    { key: 'margin', label: 'Margen (puntos de F1)' },
    { key: 'roc_auc', label: 'ROC AUC' },
    { key: 'ap', label: 'Precisión media' },
    { key: 'base_rate', label: 'Tasa base de error (%)' },
    { key: 'spearman', label: 'Valor: Spearman' },
    { key: 'pearson', label: 'Valor: Pearson' },
    { key: 'result_acc', label: 'Resultado (%)' },
  ],
};

const raw = results as Json;
const locale = 'es-ES';
const columns = LABELS.es;
const encoderColumns = ENCODER_LABELS.es;
const allRows = Array.isArray(raw.rows) ? (raw.rows as Json[]) : [];
const isEncoder = (row: Json) => row.kind === 'encoder';
const rawRows = allRows.filter((row) => !isEncoder(row));
const rawEncoderRows = allRows.filter(isEncoder);

const decimal = ',';

/**
 * `toFixed` and not `toLocaleString`: the ML repo's own report.md rounds with Python, which lands
 * on the binary value (21.15 prints as 21.1), and the two renderings of the same measurement must
 * not disagree by a tenth. Only the decimal separator is localised; no thousands grouping, because
 * every number here is a percentage or an Elo.
 */
function number(value: unknown, digits = 1): Cell {
  const n = toNumber(value);
  return Number.isFinite(n) ? n.toFixed(digits).replace('.', decimal) : null;
}

/** A fraction in [0, 1] as a percentage; `rukh eval` never writes these as percentages. */
const percent = (value: unknown, digits = 1): Cell => number(toNumber(value) * 100, digits);

/**
 * Three significant figures, for a number whose magnitude is not known in advance: the tuned
 * blunder threshold is 0.128 for one input scheme and 0.0446 for the other, and rounding both to
 * three decimals would print the second as 0.045, which is not the operating point that was used.
 */
function significant(value: unknown, digits = 3): Cell {
  const n = toNumber(value);
  if (!Number.isFinite(n)) return null;
  return Number(n.toPrecision(digits)).toString().replace('.', decimal);
}

function toNumber(value: unknown): number {
  return typeof value === 'number' && Number.isFinite(value) ? value : NaN;
}

function params(value: unknown): Cell {
  const n = toNumber(value);
  if (!Number.isFinite(n)) return null;
  return n >= 1e6 ? `${number(n / 1e6)} M` : String(Math.round(n));
}

function elo(row: Json): Cell {
  const point = toNumber(row.elo);
  if (!Number.isFinite(point)) return null;
  const ci = Array.isArray(row.elo_ci) ? (row.elo_ci as unknown[]) : [];
  const lo = toNumber(ci[0] ?? row.elo_lower);
  const hi = toNumber(ci[1] ?? row.elo_upper);
  const rounded = String(Math.round(point));
  if (!Number.isFinite(lo) || !Number.isFinite(hi)) return rounded;
  return `${rounded} (${Math.round(lo)} … ${Math.round(hi)})`;
}

function band(row: Json, key: string): Cell {
  const puzzles = row.puzzles;
  if (!puzzles || typeof puzzles !== 'object') return null;
  return percent((puzzles as Json)[key]);
}

/** A row already written for display (the committed placeholder) passes through untouched. */
const isMeasured = (row: Json) => 'legality' in row || 'elo_ci' in row || 'top1_by_band' in row;

const rows: Record<string, Cell>[] = rawRows.map((row) => {
  if (!isMeasured(row)) {
    const cells: Record<string, Cell> = {};
    for (const { key } of columns) {
      const value = row[key];
      cells[key] = value === undefined || value === null ? null : String(value);
    }
    return cells;
  }
  return {
    stage: typeof row.stage === 'string' ? row.stage : null,
    params: params(row.params),
    legal: percent(row.legality),
    top1: percent(row.top1),
    top3: percent(row.top3),
    puzzles_1000: band(row, '1000-1500'),
    puzzles_1500: band(row, '1500-2000'),
    puzzles_2000: band(row, '2000+'),
    elo: elo(row),
    dcp: number(row.delta_cp),
    hub: typeof row.hub === 'string' ? row.hub : null,
  };
});

const encoderRows: Record<string, Cell>[] = rawEncoderRows.map((row) => ({
  stage: typeof row.stage === 'string' ? row.stage : null,
  params: params(row.params),
  f1: percent(row.blunder_f1),
  threshold: significant(row.blunder_threshold),
  f1_fixed: percent(row.blunder_f1_fixed),
  f1_heuristic: percent(row.blunder_f1_heuristic),
  /* `blunder_f1_margin` already comes in F1 points, not as a fraction. */
  margin: (() => {
    const cell = number(row.blunder_f1_margin);
    return cell === null || cell.startsWith('−') || cell.startsWith('-') ? cell : `+${cell}`;
  })(),
  roc_auc: number(row.blunder_roc_auc, 3),
  ap: number(row.blunder_average_precision, 3),
  base_rate: percent(row.blunder_base_rate),
  spearman: number(row.value_spearman, 3),
  pearson: number(row.value_pearson, 3),
  result_acc: percent(row.result_accuracy),
}));

const encoderCaption =
  'Encoder: un detector de errores y una cabeza de valor no se miden como un jugador. El umbral se elige en una mitad «tune» y el F1 se publica sobre la mitad «score»; la columna del umbral fijo 0,5 está ahí porque con una clase positiva del 3,7 % ese valor de fábrica no significa nada.';

const empty = emptyText ?? 'Todavía no hay resultados: el primer modelo se entrena en el módulo 2.';
const updatedAt = raw.updated_at ?? raw.updated;
const updated =
  typeof updatedAt === 'string' ? new Date(updatedAt).toLocaleDateString(locale) : null;
---

<div class="results">
  <div
    class="table-wrap"
    tabindex="0"
    role="region"
    aria-label="Tabla con desplazamiento horizontal"
  >
    <table class="results__table">
      <thead>
        <tr>
          {columns.map((c) => (
            <th scope="col">{c.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 ? (
          <tr>
            <td class="results__empty" colspan={columns.length}>
              {empty}
            </td>
          </tr>
        ) : (
          rows.map((row) => (
            <tr>
              {columns.map((c) =>
                c.key === 'hub' && row.hub ? (
                  <td>
                    <a href={`https://huggingface.co/${row.hub}`} rel="noopener">
                      {row.hub}
                    </a>
                  </td>
                ) : (
                  <td>{row[c.key] ?? '—'}</td>
                ),
              )}
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
  {encoderRows.length > 0 && (
    <div class="table-wrap results__encoder">
      <table class="results__table">
        <caption class="caption results__caption">{encoderCaption}</caption>
        <thead>
          <tr>
            {encoderColumns.map((c) => (
              <th scope="col">{c.label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {encoderRows.map((row) => (
            <tr>
              {encoderColumns.map((c) => (
                <td>{row[c.key] ?? '—'}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="caption results__meta">
    Fuente: <code>rukh eval nightly</code>
    {updated && ` · actualizado ${updated}`}
  </p>
</div>

<style>
  .results {
    margin-top: 1.6em;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--frame-bg);
  }

  .results__table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .results__table th,
  .results__table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
    white-space: nowrap;
  }

  .results__table th {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--ink);
  }

  .results__empty {
    color: var(--muted);
    white-space: normal;
  }

  .results__encoder {
    margin-top: 12px;
  }

  .results__caption {
    padding: 10px 12px;
    text-align: left;
    white-space: normal;
    border-bottom: 1px solid var(--line-soft);
  }

  .results__meta {
    margin-top: 8px;
  }
</style>
