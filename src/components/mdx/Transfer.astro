---
/**
 * "Fuera del ajedrez": the general concept a chess-specific passage just taught, and where it
 * shows up in a project that has nothing to do with chess.
 *
 * The course already did this in about eight places -- the legality mask as constrained decoding,
 * BPE merges as why an LLM has a token for `ing`, a confidence interval as why a benchmark that
 * celebrates half a point on 200 examples is noise -- and every one of them is among the most
 * useful paragraphs in it. It happened by accident. This makes it a component so it happens on
 * purpose, and so the reader learns to expect it: chess is the vehicle, the concept is the cargo.
 *
 * `concept` is the name to remember. `where` is a one-liner of where it reappears, which is what
 * turns a nice observation into something retrievable months later on a different project.
 */
interface Props {
  /** The general idea, named as it is named in the field. */
  concept: string;
  /** Where it shows up outside this project: "en un RAG", "en un agente de soporte"... */
  where?: string;
}

const { concept, where } = Astro.props;
---

<aside class="transfer" aria-label={`Fuera del ajedrez: ${concept}`}>
  <p class="transfer__head">
    <span class="label transfer__kind">// Fuera del ajedrez</span>
    <span class="transfer__concept">{concept}</span>
  </p>
  <div class="transfer__body">
    <slot />
  </div>
  {where && <p class="caption transfer__where">{where}</p>}
</aside>

<style>
  .transfer {
    position: relative;
    margin-top: 1.6em;
    padding: 18px 20px 18px 24px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--event-text-aa);
    border-radius: 0 8px 8px 0;
    background: var(--frame-bg);
  }

  .transfer__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-bottom: 8px;
  }

  .transfer__kind {
    color: var(--event-text-aa);
  }

  .transfer__concept {
    font-weight: 600;
    color: var(--ink);
  }

  .transfer__body {
    font-size: 0.95em;
  }

  .transfer__body > :global(* + *) {
    margin-top: 0.8em;
  }

  .transfer__where {
    margin-top: 10px;
    color: var(--ink-2);
  }
</style>
