---
/**
 * Accessible tabs. Usage in MDX:
 *   <Tabs labels={['Windows', 'Linux']}>
 *     <div slot="tab-0">…</div>
 *     <div slot="tab-1">…</div>
 *   </Tabs>
 * Without JavaScript every panel is visible, stacked; the script turns them into tabs.
 */
import { pageId } from '../../lib/ids';

interface Props {
  labels: string[];
  id?: string;
}

const { labels, id = pageId(Astro.locals, 'tabs') } = Astro.props;
const slots = labels.map((_, i) => `tab-${i}`);
---

<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist">
    {labels.map((label, i) => (
      <button
        class="tabs__tab mono"
        type="button"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-controls={`${id}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        {label}
      </button>
    ))}
  </div>
  {slots.map((name, i) => (
    <div
      class="tabs__panel"
      role="tabpanel"
      id={`${id}-panel-${i}`}
      aria-labelledby={`${id}-tab-${i}`}
      tabindex="0"
    >
      <slot name={name} />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    root.classList.add('is-enhanced');

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (delta === 0) return;
        event.preventDefault();
        select((i + delta + tabs.length) % tabs.length, true);
      });
    });

    select(0);
  });
</script>

<style>
  .tabs {
    margin-top: 1.6em;
    border: 1px solid var(--line);
  }

  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    background: var(--frame-bg);
  }

  .tabs__tab {
    min-height: 44px;
    padding: 10px 18px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
    cursor: pointer;
  }

  .tabs__tab:hover {
    color: var(--ink);
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .tabs__panel {
    padding: 16px 18px;
  }

  .tabs:not(.is-enhanced) .tabs__panel + .tabs__panel {
    border-top: 1px solid var(--line-soft);
  }

  .tabs__panel > :global(* + *) {
    margin-top: 0.8em;
  }

  .tabs__panel > :global(.expressive-code:first-child) {
    margin-top: 0;
  }
</style>
