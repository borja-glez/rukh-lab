---
/**
 * The way back from a lab to the lesson that built what it runs: one line under the lab heading
 * of a labs lesson. The pair of `LessonLabs`. Usage in MDX:
 *
 *   <LabOrigin lessons={['m1/02-de-pgn-a-uci']} />
 *
 * Titles come from the collection, and an unknown id fails the build.
 */
import { getEntry } from 'astro:content';

interface Props {
  /** Lesson ids, e.g. `['m5/02-el-reward-model']`. */
  lessons: string[];
}

const { lessons } = Astro.props;
const entries = await Promise.all(
  lessons.map(async (id) => {
    const entry = await getEntry('lessons', id);
    if (!entry) throw new Error(`LabOrigin: no existe la lección "${id}"`);
    return { id, title: entry.data.title, order: entry.data.order };
  }),
);
---

<p class="lab-origin">
  <span class="label">// Viene de</span>
  {entries.map((e, i) => (
    <>
      {i > 0 && (i === entries.length - 1 ? ' y ' : ', ')}
      <a href={`/curso/${e.id}/`}>
        lección {e.order} · {e.title}
      </a>
    </>
  ))}
</p>

<style>
  .lab-origin {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    font-size: 0.92em;
    color: var(--muted);
  }
</style>
