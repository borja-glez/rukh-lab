---
/**
 * The citation under a code block: where that code lives, at which commit, on which lines.
 *
 * It exists because a course that shows code has to be checkable. Every block of this course is a
 * file of a sibling repo, verbatim, at the tag the module closed with — never a paraphrase written
 * for the lesson — and this component is both the link the reader follows and the claim
 * `pnpm verify:code` checks (`scripts/course-code.mjs`). If the block and the file ever drift, the
 * script fails and names the line.
 *
 * `tag` defaults to the tag of the module the lesson belongs to (`m2` → `p2`) for `rukh`, and to
 * `main` for the web repos, which are not tagged per milestone.
 */
interface Props {
  /** Path inside the repo, identical to the `title=` of the block above. */
  file: string;
  /** Tag or branch: `p0`…`p6` for `rukh`, `main` for the web repos. */
  tag?: string;
  /** The lines this block covers in that file, `30-39` or `12`. */
  lines?: string;
  /** Which sibling repo. `rukh` is the ML engine and the default. */
  repo?: 'rukh' | 'rukh-web' | 'rukh-lab';
  /** One short clause, e.g. "sin cambios desde M2". */
  note?: string;
}

const { file, tag, lines, repo = 'rukh', note } = Astro.props;
const ref = tag ?? 'main';
const span = lines?.includes('-') ? lines.split('-') : lines ? [lines, lines] : null;
const anchor = span ? `#L${span[0]}-L${span[1]}` : '';
const href = `https://github.com/borja-glez/${repo}/blob/${ref}/${file}${anchor}`;
const label = lines ? `líneas ${lines}` : 'fichero completo';
---

<p class="src">
  <a class="src__link mono" href={href} rel="noopener">
    <span class="src__arrow" aria-hidden="true">↗</span>
    <span class="src__path">{repo === 'rukh' ? file : `${repo}/${file}`}</span>
    <span class="src__meta">{label} · {ref}</span>
  </a>
  {note && <span class="src__note">{note}</span>}
</p>

<style>
  .src {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: -0.6em 0 1.6em;
    font-size: 12px;
  }

  .src__link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .src__link:hover,
  .src__link:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--line);
  }

  .src__arrow {
    font-size: 11px;
  }

  .src__meta {
    color: var(--muted);
    opacity: 0.8;
  }

  .src__note {
    color: var(--muted);
    font-style: italic;
  }
</style>
