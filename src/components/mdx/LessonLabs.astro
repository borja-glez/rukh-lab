---
/**
 * «Lab de esta lección»: at the end of a code lesson, the labs of the module's labs lesson that
 * exercise what the lesson just built, each with its route and clock from `src/data/lab-routes.ts`
 * and a link to its heading. The labs stay where they are (one lesson per module, one route table
 * at its top); this box is the forward reference, and `LabOrigin` in the labs lesson is the way
 * back. Usage in MDX:
 *
 *   <LessonLabs from="m1/10-labs-del-pipeline" labs={['Lab 2']} />
 *
 * Both the lab row and its heading are looked up at build time, and a missing one fails the
 * build: a pointer to a lab that was renamed is exactly the drift this is meant to prevent.
 */
import { getEntry, render } from 'astro:content';
import Callout from './Callout.astro';
import { labRoutes, routeLabels } from '../../data/lab-routes';

interface Props {
  /** The labs lesson id, e.g. `m1/10-labs-del-pipeline`. */
  from: string;
  /** The lab names as in `lab-routes.ts` and in the headings, e.g. `['Lab 2', 'Lab 3b']`. */
  labs: string[];
  /** Optional half line after the list (an order, a dependency). */
  note?: string;
}

const { from, labs, note } = Astro.props;
const rows = labRoutes[from];
if (!rows) throw new Error(`LessonLabs: no hay rutas para "${from}"`);
const entry = await getEntry('lessons', from);
if (!entry) throw new Error(`LessonLabs: no existe la lección "${from}"`);
const { headings } = await render(entry);
const href = `/curso/${from}/`;

const items = labs.map((lab) => {
  const row = rows.find((r) => r.lab === lab);
  if (!row) throw new Error(`LessonLabs: "${lab}" no está en lab-routes.ts de "${from}"`);
  const heading = headings.find((h) => h.text === lab || h.text.startsWith(`${lab} `));
  if (!heading) throw new Error(`LessonLabs: "${from}" no tiene un encabezado "${lab} · …"`);
  return { row, heading };
});
const title = labs.length === 1 ? 'Lab de esta lección' : 'Labs de esta lección';
---

<Callout kind="guia" title={title}>
  <ul class="lesson-labs">
    {items.map(({ row, heading }) => (
      <li>
        <a href={`${href}#${heading.slug}`}>{heading.text}</a>
        <span class="lesson-labs__meta mono">
          {' '}
          · {routeLabels[row.route]}
          {row.clock !== '—' && ` · ${row.clock}`}
        </span>
      </li>
    ))}
  </ul>
  {note && <p>{note}</p>}
  <p class="lesson-labs__foot">
    Todos los labs del módulo están juntos en <a href={href}>{entry.data.title}</a>, con su tabla de
    rutas; hazlos al terminar esta lección o al final, como prefieras.
  </p>
</Callout>

<style>
  .lesson-labs {
    padding-left: 1.2em;
  }

  .lesson-labs__meta {
    font-size: 0.85em;
    color: var(--muted);
  }

  .lesson-labs__foot {
    font-size: 0.92em;
    color: var(--muted);
  }
</style>
