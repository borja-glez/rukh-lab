---
import { getEntry } from 'astro:content';
import { pageId } from '../../lib/ids';

/**
 * Inline glossary term: links to /glosario/#id and shows the definition in a
 * CSS-only popover on hover/focus (also read by screen readers via aria-describedby).
 * The popover exists only under `(hover: hover)`; on touch the term is a plain link.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = await getEntry('glossary', id);
if (!entry)
  throw new Error(`Term: glossary entry "${id}" not found in src/content/glossary/terms.json`);
const popId = pageId(Astro.locals, `term-${id}`);
---

<span class="term" data-term>
  <a class="term__link" href={`/glosario/#${id}`} aria-describedby={popId}>
    <slot />
  </a>
  <span class="term__pop" role="tooltip" id={popId} data-term-pop>
    <span class="label label--ink">{entry.data.term}</span>
    {entry.data.definition}
  </span>
</span>

<style>
  .term {
    position: relative;
    display: inline;
  }

  .term__link {
    color: inherit;
    text-decoration: underline dotted var(--brand);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .term__link:hover,
  .term__link:focus-visible {
    color: var(--brand);
    text-decoration-style: solid;
  }

  .term__pop {
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    z-index: 20;
    display: none;
    width: min(38ch, calc(100vw - 32px));
    /* Set by `scripts/term-popover.ts` when the popover would run off the right edge. */
    transform: translateX(var(--term-shift, 0px));
    padding: 12px 14px;
    border: 1px solid var(--line);
    background: var(--box-fill);
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .term__pop .label {
    display: block;
    margin-bottom: 4px;
  }

  @media (hover: hover) {
    .term:hover .term__pop,
    .term__link:focus-visible + .term__pop {
      display: block;
    }
  }
</style>
