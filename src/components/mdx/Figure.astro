---
import FigureFrame from '../FigureFrame.astro';

interface Props {
  caption: string;
  /** Figure number shown in the label, e.g. "01". */
  n?: string;
}

const { caption, n } = Astro.props;
---

<figure class="figure">
  <FigureFrame>
    <slot />
  </FigureFrame>
  <figcaption class="caption figure__caption">
    {n && <span class="label label--ink">fig. {n}</span>}
    {caption}
  </figcaption>
</figure>

<style>
  .figure {
    margin: 1.8em 0 0;
  }

  .figure__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 10px;
  }
</style>
