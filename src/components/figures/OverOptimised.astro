---
/**
 * GRPO's inverted U: the reward that matters peaks and comes back down while the collapse keeps
 * climbing.
 *
 * Three runs of 400 steps from the same checkpoint with the same seed, and nothing changing but
 * the learning rate. Two lines, both measured on 300 held-out positions.
 *
 * The bars are the reward with `cp_best` taken from the **engine's own best move** -- the one that
 * cannot be raised by making the policy more deterministic. It rises, peaks at 5e-6, and falls
 * back at 2e-5.
 *
 * The line is the share of validation groups whose eight candidates were all the same move. It
 * climbs monotonically: 0.370, 0.453, 0.490. So the fall in the bars is not noise, it has a
 * mechanism sitting right next to it -- the policy is buying reward with determinism, and past a
 * point the purchase stops paying.
 *
 * The leftmost run is the one that got published: it is the only one where the collapse indicator
 * goes *down* (from 0.387 before training) while the reward goes up.
 */
interface Run {
  lr: string;
  absolute: number;
  group: number;
  flat: number;
}

const BEFORE = { absolute: 0.8325, flat: 0.387 };

const runs: Run[] = [
  { lr: '1e-6', absolute: 0.8413, group: 0.8741, flat: 0.37 },
  { lr: '5e-6', absolute: 0.8592, group: 0.8928, flat: 0.453 },
  { lr: '2e-5', absolute: 0.8402, group: 0.8929, flat: 0.49 },
];

const FLOOR = 0.82;
const TOP = 0.87;
const barHeight = (value: number) => ((value - FLOOR) / (TOP - FLOOR)) * 110;
const flatY = (share: number) => 180 - ((share - 0.34) / (0.52 - 0.34)) * 110;
const x = (index: number) => 150 + index * 150;
const points = runs.map((run, index) => `${x(index) + 32},${flatY(run.flat)}`).join(' ');
---

<figure class="fig fig--overopt">
  <svg
    viewBox="0 0 640 250"
    role="img"
    aria-label="Tres corridas de GRPO que solo se diferencian en la tasa de aprendizaje. Las barras son la recompensa medida contra el mejor movimiento disponible: 0,8413 con tasa 1e-6, sube a 0,8592 con 5e-6 y vuelve a bajar a 0,8402 con 2e-5. La línea es la proporción de grupos de validación donde las ocho candidatas eran la misma jugada: 0,370, luego 0,453, luego 0,490, subiendo siempre. La ganancia se dobla y cae mientras el colapso sigue creciendo."
  >
    <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
      <line x1="120" y1="180" x2="620" y2="180" stroke="var(--line)" stroke-width="0.8"></line>
      <line
        x1="120"
        y1={180 - barHeight(BEFORE.absolute)}
        x2="620"
        y2={180 - barHeight(BEFORE.absolute)}
        stroke="var(--line)"
        stroke-width="0.8"
        stroke-dasharray="4 3"></line>
      <text x="10" y={180 - barHeight(BEFORE.absolute) + 3} font-size="9">
        antes: {BEFORE.absolute.toFixed(4)}
      </text>
      <text x="10" y="30" font-size="9" fill="var(--accent-text-aa)">
        barras · recompensa contra el motor
      </text>
      <text x="10" y="44" font-size="9">línea · grupos planos</text>

      {runs.map((run, index) => (
        <g>
          <rect
            x={x(index)}
            y={180 - barHeight(run.absolute)}
            width="64"
            height={barHeight(run.absolute)}
            rx="2"
            fill="var(--accent)"
            fill-opacity="0.28"
            stroke="var(--accent)"
            stroke-width="0.9"
          />
          <text
            x={x(index) + 32}
            y={180 - barHeight(run.absolute) - 7}
            text-anchor="middle"
            font-size="10"
            fill="var(--accent-text-aa)"
          >
            {run.absolute.toFixed(4)}
          </text>
          <text x={x(index) + 32} y="196" text-anchor="middle" font-size="10" fill="var(--ink)">
            lr {run.lr}
          </text>
          <circle cx={x(index) + 32} cy={flatY(run.flat)} r="3.5" fill="var(--ink)"></circle>
          <text
            x={x(index) + 32}
            y={flatY(run.flat) - 9}
            text-anchor="middle"
            font-size="9"
            fill="var(--ink)"
          >
            {run.flat.toFixed(3)}
          </text>
        </g>
      ))}
      <polyline
        points={points}
        fill="none"
        stroke="var(--ink)"
        stroke-width="1.2"
        stroke-dasharray="3 2"></polyline>

      <text x="120" y="222" font-size="9">
        la ganancia se dobla y cae; el colapso sube en las tres, monótono
      </text>
      <text x="120" y="238" font-size="9">
        antes de entrenar, los grupos planos eran 0,387: solo la corrida de la izquierda los baja
      </text>
    </g>
  </svg>
  <figcaption class="caption">
    La recompensa que no se puede falsear sube, se dobla y baja. El indicador de colapso sube en las
    tres. La forma de la curva es lo que distingue mejorar de sobreoptimizar.
  </figcaption>
</figure>
