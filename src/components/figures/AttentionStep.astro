---
/**
 * One attention step, drawn with the very numbers the lesson works through by hand, so the
 * picture and the arithmetic are the same example rather than two explanations of one idea.
 *
 * The lesson had the metaphor (a filing cabinet) and the arithmetic (four numbered steps) and
 * nothing in between: the central idea of the whole course had no picture of its mechanism.
 */
const columns = [
  {
    token: 'e2e4',
    k: '(1, 0)',
    v: '(2, 0)',
    dot: '1',
    scaled: '0,7071',
    weight: 0.2483,
    out: '(0,50 · 0,00)',
  },
  {
    token: 'e7e5',
    k: '(1, 1)',
    v: '(0, 2)',
    dot: '2',
    scaled: '1,4142',
    weight: 0.5035,
    out: '(0,00 · 1,01)',
  },
  {
    token: 'g1f3',
    k: '(0, 1)',
    v: '(1, 1)',
    dot: '1',
    scaled: '0,7071',
    weight: 0.2483,
    out: '(0,25 · 0,25)',
  },
];
const x = (i: number) => 70 + i * 180;
const barTop = (w: number) => 232 - w * 110;
---

<svg
  viewBox="0 0 620 330"
  role="img"
  aria-label="La consulta de la tercera jugada se compara con las tres claves, los parecidos pasan por un softmax que da pesos de 0,25, 0,50 y 0,25, y la salida es la media de los valores ponderada por esos pesos."
>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)" text-anchor="middle">
    <text x="310" y="16" fill="var(--muted)">
      q₃ = (1, 1) · la consulta de la tercera jugada
    </text>

    {columns.map((c, i) => (
      <>
        <rect
          x={x(i) - 55}
          y="30"
          width="110"
          height="52"
          fill="var(--box-fill)"
          stroke="var(--line)"
          stroke-width="1.25"
        />
        <text x={x(i)} y="48" font-size="12">
          {c.token}
        </text>
        <text x={x(i)} y="64" font-size="10" fill="var(--muted)">
          k {c.k}
        </text>
        <text x={x(i)} y="76" font-size="10" fill="var(--muted)">
          v {c.v}
        </text>

        <path
          d={`M310 24 L${x(i)} 28`}
          fill="none"
          stroke="var(--diagram-stroke)"
          stroke-width="1"
        />
        <text x={x(i)} y="100" font-size="10" fill="var(--muted)">
          q₃·k = {c.dot}
        </text>
        <text x={x(i)} y="114" font-size="10" fill="var(--muted)">
          ÷√d → {c.scaled}
        </text>

        <rect
          x={x(i) - 26}
          y={barTop(c.weight)}
          width="52"
          height={c.weight * 110}
          fill="var(--accent)"
          fill-opacity="0.85"
        />
        <text x={x(i)} y={barTop(c.weight) - 6} font-size="11">
          {c.weight.toFixed(4).replace('.', ',')}
        </text>
        <text x={x(i)} y="250" font-size="10" fill="var(--muted)">
          {c.out}
        </text>
      </>
    ))}

    <text x="310" y="140" font-size="10" fill="var(--muted)">
      softmax reparte 1 entre las tres
    </text>
    <line x1="40" y1="232" x2="580" y2="232" stroke="var(--line)" stroke-width="1" />
    <text x="310" y="272" font-size="10" fill="var(--muted)">
      se suman las tres contribuciones
    </text>
    <rect
      x="220"
      y="284"
      width="180"
      height="34"
      fill="var(--box-fill)"
      stroke="var(--accent-text)"
      stroke-width="1.25"
    />
    <text x="310" y="305" font-size="12">
      salida = (0,7449 · 1,2553)
    </text>
  </g>
</svg>
