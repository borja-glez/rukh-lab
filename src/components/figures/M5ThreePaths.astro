---
/**
 * The three ways M5 aligns a model, side by side, and how many networks each one has to train.
 *
 * Row one is the classic RLHF recipe (a reward model, then PPO with a value network), row two is
 * DPO (the pairs straight into the policy, held to a frozen copy of itself), row three is GRPO (a
 * group of candidates scored by a function, each one judged against the group's own mean). Under
 * each row, one line says what the same step is in a chat LLM, because the three recipes are the
 * ones that turn a base language model into an assistant and the chess is only the example.
 *
 * Filled boxes are networks that have to be trained; outlined ones are data, a computation or a
 * frozen copy. Counting the filled boxes per row is the cost argument of lesson 1 in one glance.
 * The legend uses swatches, not colour names, because the fills are theme tokens.
 */
type Box = { main: string; sub?: string; trained?: boolean; frozen?: boolean };

const rows: { title: string; llm: string; boxes: Box[] }[] = [
  {
    title: 'RLHF clásico · reward model + PPO',
    llm: 'en un chat: una persona elige entre dos respuestas y un modelo aprende a puntuar como ella',
    boxes: [
      { main: 'pares', sub: 'ya juzgados' },
      { main: 'reward model', sub: 'Bradley-Terry', trained: true },
      { main: 'PPO', sub: '+ red de valor', trained: true },
      { main: 'política', sub: '+ KL (β)', trained: true },
    ],
  },
  {
    title: 'DPO · los pares, directos a la política',
    llm: 'los mismos pares, sin reward model ni red de valor: una sola red que entrenar',
    boxes: [
      { main: 'pares', sub: 'ya juzgados' },
      { main: 'pérdida DPO', sub: 'sobre el par' },
      { main: 'política', sub: 'la que aprende', trained: true },
      { main: 'referencia', sub: 'copia congelada', frozen: true },
    ],
  },
  {
    title: 'GRPO · un grupo y una función',
    llm: 'en un LLM: ocho respuestas al mismo problema, corregidas por tests o por la solución',
    boxes: [
      { main: 'posiciones', sub: 'sin etiqueta' },
      { main: 'grupo de 8', sub: 'candidatas' },
      { main: 'recompensa', sub: 'verificable' },
      { main: 'política', sub: 'ventaja + KL', trained: true },
    ],
  },
];

const BOX_W = 128;
const GAP = 32;
const BOX_H = 38;
const ROW_H = 100;
const TOP = 16;
const x0 = (index: number) => 16 + index * (BOX_W + GAP);
---

<svg
  viewBox="0 0 640 340"
  role="img"
  aria-label="Tres caminos para alinear un modelo, en tres filas. RLHF clásico: pares ya juzgados, un reward model entrenado con Bradley-Terry, PPO con una red de valor y la política con su penalización KL; tres redes que entrenar. DPO: los mismos pares entran en la pérdida DPO y de ahí a la política, atada con una correa a una copia congelada de sí misma; una sola red que entrenar. GRPO: posiciones sin etiqueta, un grupo de ocho candidatas, una recompensa verificable que las puntúa y la política, que se mueve según la ventaja de cada candidata frente a la media del grupo y una KL; una sola red que entrenar. Debajo de cada fila, qué es lo mismo en un modelo de lenguaje de chat."
>
  <defs>
    <marker
      id="m5-paths-head"
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="7"
      markerHeight="7"
      orient="auto"
    >
      <path d="M 0 0 L 8 4 L 0 8 z" fill="var(--muted)"></path>
    </marker>
  </defs>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--ink)">
    {rows.map((row, r) => {
      const y = TOP + r * ROW_H;
      const boxY = y + 10;
      return (
        <g>
          <text x="16" y={y + 2} font-size="11" fill="var(--ink)">
            {row.title}
          </text>
          {row.boxes.map((box, i) => {
            const x = x0(i);
            const last = i === row.boxes.length - 1;
            return (
              <g>
                <rect
                  x={x}
                  y={boxY}
                  width={BOX_W}
                  height={BOX_H}
                  rx="4"
                  fill={box.trained ? 'var(--accent)' : 'var(--box-fill)'}
                  fill-opacity={box.trained ? 0.22 : 1}
                  stroke={box.trained ? 'var(--accent)' : 'var(--line)'}
                  stroke-width={box.trained ? 1.3 : 1}
                  stroke-dasharray={box.frozen ? '4 3' : undefined}
                />
                <text x={x + BOX_W / 2} y={boxY + 16} text-anchor="middle" font-size="11">
                  {box.main}
                </text>
                {box.sub && (
                  <text
                    x={x + BOX_W / 2}
                    y={boxY + 30}
                    text-anchor="middle"
                    font-size="10"
                    fill="var(--muted)"
                  >
                    {box.sub}
                  </text>
                )}
                {!last && !row.boxes[i + 1].frozen && (
                  <line
                    x1={x + BOX_W + 3}
                    y1={boxY + BOX_H / 2}
                    x2={x + BOX_W + GAP - 4}
                    y2={boxY + BOX_H / 2}
                    stroke="var(--muted)"
                    stroke-width="1.2"
                    marker-end="url(#m5-paths-head)"
                  />
                )}
                {!last && row.boxes[i + 1].frozen && (
                  <g>
                    <line
                      x1={x + BOX_W + 2}
                      y1={boxY + BOX_H / 2}
                      x2={x + BOX_W + GAP - 2}
                      y2={boxY + BOX_H / 2}
                      stroke="var(--ink)"
                      stroke-width="1.2"
                      stroke-dasharray="2 3"
                    />
                    <text
                      x={x + BOX_W + GAP / 2}
                      y={boxY - 3}
                      text-anchor="middle"
                      font-size="10"
                      fill="var(--muted)"
                    >
                      β
                    </text>
                  </g>
                )}
              </g>
            );
          })}
          <text x="16" y={boxY + BOX_H + 20} font-size="10" fill="var(--muted)">
            {row.llm}
          </text>
        </g>
      );
    })}
    <rect
      x="16"
      y="316"
      width="14"
      height="12"
      rx="2"
      fill="var(--accent)"
      fill-opacity="0.22"
      stroke="var(--accent)"
    />
    <text x="36" y="326" font-size="10" fill="var(--muted)">
      red que hay que entrenar
    </text>
    <rect
      x="232"
      y="316"
      width="14"
      height="12"
      rx="2"
      fill="var(--box-fill)"
      stroke="var(--line)"
    />
    <text x="252" y="326" font-size="10" fill="var(--muted)">
      datos o cálculo
    </text>
    <rect
      x="388"
      y="316"
      width="14"
      height="12"
      rx="2"
      fill="var(--box-fill)"
      stroke="var(--line)"
      stroke-dasharray="4 3"
    />
    <text x="408" y="326" font-size="10" fill="var(--muted)">
      copia congelada (la correa)
    </text>
  </g>
</svg>
