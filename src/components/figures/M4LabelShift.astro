---
/**
 * The label shift that `transformers` does for you, and why doing it twice trains the wrong thing.
 *
 * Top: the packed stream of this project already stores `y` one step ahead of `x`, so every input
 * position is paired with the token that follows it. That is next-token prediction.
 *
 * Bottom: most causal models in `transformers` shift `labels` again inside `forward`. Fed `y` as
 * `labels`, they pair every position with the *next* label, which is the token two ahead, and
 * the last position loses its target. The label row is the same in both halves; only the arrows
 * move. Nothing raises; the loss still goes down, because predicting two ahead is learnable too.
 * The wrapper in `models/hf.py` does not shift, and `test_hf_wrapper.py` checks it against a shift
 * done by hand.
 *
 * The two rows are told apart by their titles and by the arrows (straight against diagonal), not
 * only by colour. Static: the point is the angle of the arrows.
 */
const tokens = ['<bos>', '<w1800>', '<b1900>', 'e2e4', 'e7e5', 'g1f3', 'b8c6'];
const CELL = 74;
const GAP = 6;
const X0 = 96;
const cx = (i: number) => X0 + i * (CELL + GAP) + CELL / 2;
const positions = [0, 1, 2, 3, 4, 5];

interface Row {
  title: string;
  top: number;
  offset: number;
  stroke: string;
  marker: string;
}

const rows: Row[] = [
  {
    title: 'lo correcto: y ya va un paso por delante de x',
    top: 30,
    offset: 1,
    stroke: 'var(--ok)',
    marker: 'url(#m4-shift-ok)',
  },
  {
    title: 'desplazado otra vez en forward: cada x apunta al de después del siguiente',
    top: 150,
    offset: 2,
    stroke: 'var(--event)',
    marker: 'url(#m4-shift-bad)',
  },
];
---

<svg
  viewBox="0 0 640 270"
  role="img"
  aria-label="Dos filas de la misma partida en tokens. Arriba, cada posición de la entrada x está emparejada con el token que la sigue en y: bos con w1800, w1800 con b1900, y así hasta g1f3 con b8c6. Abajo, las etiquetas se han desplazado una segunda vez: las etiquetas son las mismas, pero cada posición apunta a la etiqueta siguiente, que es el token de dos pasos más allá: bos con b1900, w1800 con e2e4, y la última posición se queda sin etiqueta."
>
  <defs>
    <marker
      id="m4-shift-ok"
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L8,4 L0,8 z" fill="var(--ok)"></path>
    </marker>
    <marker
      id="m4-shift-bad"
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L8,4 L0,8 z" fill="var(--event)"></path>
    </marker>
  </defs>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    {rows.map((row) => (
      <g>
        <text x="10" y={row.top} font-size="11" fill="var(--ink)">
          {row.title}
        </text>
        <text x="10" y={row.top + 29}>
          x (entrada)
        </text>
        <text x="10" y={row.top + 93}>
          y (etiqueta)
        </text>
        {positions.map((i) => (
          <g>
            <rect
              x={cx(i) - CELL / 2}
              y={row.top + 12}
              width={CELL}
              height="26"
              fill="var(--box-fill)"
              stroke="var(--line)"
              stroke-width="1"
            />
            <text x={cx(i)} y={row.top + 29} text-anchor="middle" fill="var(--ink)">
              {tokens[i]}
            </text>
            <rect
              x={cx(i) - CELL / 2}
              y={row.top + 76}
              width={CELL}
              height="26"
              fill="var(--paper)"
              stroke={row.stroke}
              stroke-width="1"
              stroke-opacity={row.offset === 2 && i === 0 ? 0.35 : 1}
            />
            <text x={cx(i)} y={row.top + 93} text-anchor="middle" fill="var(--ink)">
              {tokens[i + 1]}
            </text>
            {i + row.offset < tokens.length ? (
              <line
                x1={cx(i)}
                y1={row.top + 40}
                x2={cx(i + row.offset - 1) - (row.offset === 1 ? 0 : 8)}
                y2={row.top + 73}
                stroke={row.stroke}
                stroke-width="1.4"
                marker-end={row.marker}
              />
            ) : (
              <text x={cx(i)} y={row.top + 58} text-anchor="middle">
                sin etiqueta
              </text>
            )}
          </g>
        ))}
      </g>
    ))}
  </g>
</svg>
