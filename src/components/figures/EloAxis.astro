---
/**
 * The figure that explains the whole milestone: the corpus had a floor, and the floor was the
 * reason "play like 1500" did nothing.
 *
 * Three rows, one axis of Elo header tokens from `<w0600>` to `<w3200>`. The top one is what the
 * vocabulary always offered; the middle one is what any of it had ever been trained on before
 * M4 (`min_elo: 1800`, both players); the bottom one is what has a gradient after M4's flat
 * corpus (1000-2600) went on top. The gap in the middle row is not a rounding error, it is
 * twelve tokens whose embeddings were still at their initialisation, and it is exactly the half
 * of the dial a human player would reach for. The bottom row closes eight of them and leaves
 * four -- `<w0600>` to `<w0900>` -- untouched, because nothing below 1000 was ever downloaded.
 *
 * The animation walks a marker along the axis and lights up the token under it. Over the
 * trained band the marker is solid; over the untrained one it goes hollow, because there is
 * nothing there to land on. That is the only motion in the figure and it is the whole point.
 */
const STEP = 100;
const MIN = 600;
const MAX = 3200;
const bins = Array.from({ length: (MAX - MIN) / STEP + 1 }, (_, i) => MIN + i * STEP);
const x = (elo: number) => 40 + ((elo - MIN) / (MAX - MIN)) * 560;
const pretrained = (elo: number) => elo >= 1800;
const finetuned = (elo: number) => elo >= 1000;
const labels = [600, 1000, 1400, 1800, 2200, 2600, 3000];
---

<figure class="fig fig--axis" tabindex="0">
  <svg
    viewBox="0 0 640 262"
    role="img"
    aria-label="El eje de tokens de Elo, de 600 a 3200 en pasos de 100, en tres filas. El vocabulario tiene los veintisiete. El corpus de preentrenamiento solo cubre de 1800 en adelante: los doce tokens por debajo de 1800 nunca recibieron un gradiente. Tras el afinado de M4, con un corpus plano de 1000 a 2600, quedan cuatro sin gradiente: de 600 a 900."
  >
    <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
      <text x="40" y="20" fill="var(--ink)">
        el vocabulario · 27 tokens por bando, desde P1
      </text>
      {bins.map((elo) => (
        <rect
          x={x(elo) - 8}
          y="30"
          width="16"
          height="18"
          fill="var(--diagram-stroke)"
          fill-opacity="0.3"
          stroke="var(--line)"
          stroke-width="0.8"
        />
      ))}

      <text x="40" y="82" fill="var(--ink)">
        el corpus de preentrenamiento · min_elo 1800, los dos jugadores
      </text>
      {bins.map((elo) => (
        <rect
          x={x(elo) - 8}
          y="92"
          width="16"
          height="18"
          fill={pretrained(elo) ? 'var(--ok)' : 'none'}
          fill-opacity={pretrained(elo) ? 0.55 : 0}
          stroke={pretrained(elo) ? 'var(--line)' : 'var(--accent)'}
          stroke-width="0.8"
          stroke-dasharray={pretrained(elo) ? undefined : '2 2'}
        />
      ))}

      <!-- the gap, named -->
      <line
        x1={x(600) - 8}
        y1="118"
        x2={x(1700) + 8}
        y2="118"
        stroke="var(--accent)"
        stroke-width="1.5"
      ></line>
      <text x={x(1100)} y="134" text-anchor="middle" fill="var(--accent-text-aa)">
        doce tokens sin un solo gradiente
      </text>
      <!-- Left-anchored, not centred: centred on x(1100) the string is wider than the space to
           its left and the first words fall outside the viewBox. -->
      <text x="32" y="148" font-size="9">
        pedirle «juega como 1500» le enseña un vector de la inicialización
      </text>

      <!-- the third row: what has a gradient after M4 -->
      <text x="40" y="172" fill="var(--ink)">
        tras el afinado de M4 · corpus plano de 1000 a 2600, encima del anterior
      </text>
      {bins.map((elo) => (
        <rect
          x={x(elo) - 8}
          y="182"
          width="16"
          height="18"
          fill={finetuned(elo) ? (pretrained(elo) ? 'var(--ok)' : 'var(--accent)') : 'none'}
          fill-opacity={finetuned(elo) ? 0.55 : 0}
          stroke={finetuned(elo) ? 'var(--line)' : 'var(--accent)'}
          stroke-width="0.8"
          stroke-dasharray={finetuned(elo) ? undefined : '2 2'}
        />
      ))}
      <line
        x1={x(600) - 8}
        y1="208"
        x2={x(900) + 8}
        y2="208"
        stroke="var(--accent)"
        stroke-width="1.5"
      ></line>
      <text x="32" y="222" font-size="9" fill="var(--accent-text-aa)">
        cuatro siguen sin gradiente: por debajo de 1000 no se descargó nada
      </text>

      <!-- the axis labels -->
      {labels.map((elo) => (
        <text x={x(elo)} y="250" text-anchor="middle" font-size="9">
          {elo}
        </text>
      ))}
      <line x1="32" y1="236" x2="608" y2="236" stroke="var(--line)" stroke-width="0.8"></line>

      <!-- the marker that walks the axis, across the three rows -->
      <g class="fig-axis__marker">
        <rect
          x="-9"
          y="28"
          width="18"
          height="174"
          fill="var(--accent)"
          fill-opacity="0.12"
          stroke="var(--accent)"
          stroke-width="1"
        ></rect>
      </g>
    </g>
  </svg>
  <figcaption class="caption">
    El eje existía en el vocabulario desde el primer día. Lo que no existía eran los datos con los
    que aprender qué significa la mitad izquierda; el afinado de M4 rellena de 1000 en adelante y
    deja cuatro tokens, de 600 a 900, tal y como estaban.
  </figcaption>
</figure>
