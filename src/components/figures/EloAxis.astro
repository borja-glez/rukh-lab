---
/**
 * The figure that explains the whole milestone: the corpus had a floor, and the floor was the
 * reason "play like 1500" did nothing.
 *
 * Both rows are the same axis of Elo header tokens, from `<w0600>` to `<w3200>`. The top one is
 * what the vocabulary always offered; the bottom one is what any of it had ever been trained on.
 * The gap between them is not a rounding error, it is eight tokens whose embeddings were still at
 * their initialisation, and it is exactly the half of the dial a human player would reach for.
 *
 * The animation walks a marker along the axis and lights up the token under it. Over the trained
 * band the marker is solid; over the untrained one it goes hollow, because there is nothing
 * there to land on. That is the only motion in the figure and it is the whole point of it.
 */
const STEP = 100;
const MIN = 600;
const MAX = 3200;
const bins = Array.from({ length: (MAX - MIN) / STEP + 1 }, (_, i) => MIN + i * STEP);
const x = (elo: number) => 40 + ((elo - MIN) / (MAX - MIN)) * 560;
const trained = (elo: number) => elo >= 1800;
const labels = [600, 1000, 1400, 1800, 2200, 2600, 3000];
---

<figure class="fig fig--axis">
  <svg
    viewBox="0 0 640 210"
    role="img"
    aria-label="El eje de tokens de Elo, de 600 a 3200 en pasos de 100. El vocabulario tiene los veintisiete. El corpus solo cubre de 1800 en adelante: los doce tokens por debajo de 1800 nunca recibieron un gradiente."
  >
    <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
      <text x="40" y="20" fill="var(--ink)">
        el vocabulario · 27 tokens por bando, desde P1
      </text>
      {bins.map((elo) => (
        <rect
          x={x(elo) - 8}
          y="30"
          width="16"
          height="18"
          fill="var(--diagram-stroke)"
          fill-opacity="0.3"
          stroke="var(--line)"
          stroke-width="0.8"
        />
      ))}

      <text x="40" y="82" fill="var(--ink)">
        el corpus · min_elo 1800, los dos jugadores
      </text>
      {bins.map((elo) => (
        <rect
          x={x(elo) - 8}
          y="92"
          width="16"
          height="18"
          fill={trained(elo) ? 'var(--ok)' : 'none'}
          fill-opacity={trained(elo) ? 0.55 : 0}
          stroke={trained(elo) ? 'var(--line)' : 'var(--accent)'}
          stroke-width="0.8"
          stroke-dasharray={trained(elo) ? undefined : '2 2'}
        />
      ))}

      <!-- the gap, named -->
      <line
        x1={x(600) - 8}
        y1="118"
        x2={x(1700) + 8}
        y2="118"
        stroke="var(--accent)"
        stroke-width="1.5"
      ></line>
      <text x={x(1100)} y="134" text-anchor="middle" fill="var(--accent-text-aa)">
        doce tokens sin un solo gradiente
      </text>
      <!-- Left-anchored, not centred: centred on x(1100) the string is wider than the space to
           its left and the first words fall outside the viewBox. -->
      <text x="32" y="148" font-size="9">
        pedirle «juega como 1500» le enseña un vector de la inicialización
      </text>

      <!-- the axis labels -->
      {labels.map((elo) => (
        <text x={x(elo)} y="172" text-anchor="middle" font-size="9">
          {elo}
        </text>
      ))}
      <line x1="32" y1="158" x2="608" y2="158" stroke="var(--line)" stroke-width="0.8"></line>

      <!-- the marker that walks the axis -->
      <g class="fig-axis__marker">
        <rect
          x="-9"
          y="28"
          width="18"
          height="84"
          fill="var(--accent)"
          fill-opacity="0.12"
          stroke="var(--accent)"
          stroke-width="1"
        ></rect>
      </g>
    </g>
  </svg>
  <figcaption class="caption">
    El eje existía en el vocabulario desde el primer día. Lo que no existía eran los datos con los
    que aprender qué significa la mitad izquierda.
  </figcaption>
</figure>
