---
/**
 * Who decides what in the demo: the model proposes, the browser filters with the rules and samples.
 *
 * Two renderings of the same four boxes: a single row for wide viewports and a two-by-two loop
 * for narrow ones (below 600px four boxes in a 640-unit viewBox render their labels at 5-6 px on
 * a phone). Only one of the two SVGs is displayed at a time, so assistive technology reads one.
 *
 * In a component rather than inline in the MDX: Prettier breaks every JSX element's children
 * onto their own line, MDX reads a multi-line body as markdown and wraps it in a `<p>`, and a
 * `<p>` inside SVG makes the parser close the `<svg>`. This figure shipped broken from P0 for
 * exactly that reason. An `.astro` template is HTML, so formatting it is safe.
 */
interface Box {
  title: string;
  sub: string;
  /** 'model' is the dark box; 'mask' gets the accent stroke. */
  kind: 'plain' | 'model' | 'mask';
}

const boxes: Box[] = [
  { title: 'historial', sub: 'e2e4 e7e5 g1f3 …', kind: 'plain' },
  { title: 'modelo', sub: 'logits por token', kind: 'model' },
  { title: 'máscara legal', sub: 'chess.js · moves()', kind: 'mask' },
  { title: 'muestreo', sub: 'temperatura, top-k', kind: 'plain' },
];

const label =
  'Flujo: historial de jugadas, modelo, logits, máscara de legalidad con chess.js, muestreo, jugada en el tablero';

const fill = (b: Box) => (b.kind === 'model' ? 'var(--ink)' : 'var(--box-fill)');
const stroke = (b: Box) => (b.kind === 'mask' ? 'var(--accent-text)' : 'var(--ink)');
const ink = (b: Box) => (b.kind === 'model' ? 'var(--paper)' : 'var(--ink)');
const sub = (b: Box) => (b.kind === 'model' ? 'var(--paper)' : 'var(--muted)');

// Wide layout: four boxes in a row, 640 × 200.
const wide = [
  { x: 10, w: 120 },
  { x: 170, w: 120 },
  { x: 330, w: 140 },
  { x: 510, w: 120 },
];

// Narrow layout: a two-by-two loop, 320 × 300. Reading order follows the arrows:
// top-left → top-right → bottom-right → bottom-left → (dashed) back to top-left.
const narrow = [
  { x: 10, y: 20 },
  { x: 170, y: 20 },
  { x: 170, y: 160 },
  { x: 10, y: 160 },
];
const NW = 140;
const NH = 60;
---

<svg class="flow flow--wide" viewBox="0 0 640 200" role="img" aria-label={label}>
  <g
    font-family="var(--font-mono)"
    font-size="12"
    fill="var(--ink)"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    {boxes.map((b, i) => (
      <>
        <rect
          x={wide[i].x}
          y="70"
          width={wide[i].w}
          height="60"
          fill={fill(b)}
          stroke={stroke(b)}
          stroke-width="1.25"
        />
        <text x={wide[i].x + wide[i].w / 2} y="94" fill={ink(b)}>
          {b.title}
        </text>
        <text x={wide[i].x + wide[i].w / 2} y="112" font-size="10" fill={sub(b)}>
          {b.sub}
        </text>
      </>
    ))}
  </g>
  <g fill="none" stroke="var(--diagram-stroke)" stroke-width="1.25">
    <path d="M130 100h40" />
    <path d="M290 100h40" />
    <path d="M470 100h40" />
    <path d="M570 130v30H70v-30" stroke-dasharray="3 3" />
  </g>
  <text
    x="320"
    y="180"
    font-family="var(--font-mono)"
    font-size="10"
    fill="var(--diagram-stroke)"
    text-anchor="middle"
  >
    la jugada elegida vuelve al historial y al tablero
  </text>
</svg>

<svg class="flow flow--narrow" viewBox="0 0 320 300" role="img" aria-label={label}>
  <g
    font-family="var(--font-mono)"
    font-size="12"
    fill="var(--ink)"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    {boxes.map((b, i) => (
      <>
        <rect
          x={narrow[i].x}
          y={narrow[i].y}
          width={NW}
          height={NH}
          fill={fill(b)}
          stroke={stroke(b)}
          stroke-width="1.25"
        />
        <text x={narrow[i].x + NW / 2} y={narrow[i].y + 24} fill={ink(b)}>
          {b.title}
        </text>
        <text x={narrow[i].x + NW / 2} y={narrow[i].y + 42} font-size="10" fill={sub(b)}>
          {b.sub}
        </text>
      </>
    ))}
  </g>
  <g fill="none" stroke="var(--diagram-stroke)" stroke-width="1.25">
    <path d="M150 50h20" />
    <path d="M240 80v80" />
    <path d="M170 190h-20" />
    <path d="M80 160v-80" stroke-dasharray="3 3" />
  </g>
  <text
    x="160"
    y="260"
    font-family="var(--font-mono)"
    font-size="10"
    fill="var(--diagram-stroke)"
    text-anchor="middle"
  >
    la jugada elegida vuelve al historial
  </text>
  <text
    x="160"
    y="276"
    font-family="var(--font-mono)"
    font-size="10"
    fill="var(--diagram-stroke)"
    text-anchor="middle"
  >
    y al tablero
  </text>
</svg>
