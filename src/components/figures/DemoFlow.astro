---
/**
 * Who decides what in the demo: the model proposes, the browser filters with the rules and samples.
 *
 * In a component rather than inline in the MDX: Prettier breaks every JSX element's children
 * onto their own line, MDX reads a multi-line body as markdown and wraps it in a `<p>`, and a
 * `<p>` inside SVG makes the parser close the `<svg>`. This figure shipped broken from P0 for
 * exactly that reason. An `.astro` template is HTML, so formatting it is safe.
 */
---

<svg
  viewBox="0 0 640 200"
  role="img"
  aria-label="Flujo: historial de jugadas, modelo, logits, máscara de legalidad con chess.js, muestreo, jugada en el tablero"
>
  <g
    font-family="var(--font-mono)"
    font-size="12"
    fill="var(--ink)"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    <rect
      x="10"
      y="70"
      width="120"
      height="60"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="70" y="94">
      historial
    </text>
    <text x="70" y="112" font-size="10" fill="var(--muted)">
      e2e4 e7e5 g1f3 …
    </text>
    <rect
      x="170"
      y="70"
      width="120"
      height="60"
      fill="var(--ink)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="230" y="94" fill="var(--paper)">
      modelo
    </text>
    <text x="230" y="112" font-size="10" fill="var(--paper)">
      logits por token
    </text>
    <rect
      x="330"
      y="70"
      width="140"
      height="60"
      fill="var(--box-fill)"
      stroke="var(--accent-text)"
      stroke-width="1.25"
    />
    <text x="400" y="94">
      máscara legal
    </text>
    <text x="400" y="112" font-size="10" fill="var(--muted)">
      chess.js · moves()
    </text>
    <rect
      x="510"
      y="70"
      width="120"
      height="60"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="570" y="94">
      muestreo
    </text>
    <text x="570" y="112" font-size="10" fill="var(--muted)">
      temperatura, top-k
    </text>
  </g>
  <g fill="none" stroke="var(--diagram-stroke)" stroke-width="1.25">
    <path d="M130 100h40" />
    <path d="M290 100h40" />
    <path d="M470 100h40" />
    <path d="M570 130v30H70v-30" stroke-dasharray="3 3" />
  </g>
  <text
    x="320"
    y="180"
    font-family="var(--font-mono)"
    font-size="10"
    fill="var(--diagram-stroke)"
    text-anchor="middle"
  >
    la jugada elegida vuelve al historial y al tablero
  </text>
</svg>
