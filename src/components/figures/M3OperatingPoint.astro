---
/**
 * Why the blunder head scores an F1 of zero at 0.5 and 0.180 at 0.0663: where its probabilities
 * live on the 0..1 axis, and where each threshold falls.
 *
 * Every number is from the M3 evaluation report of the published checkpoint (the `last-n` moves
 * run, `score` half, 3 660 positions): the probability span 0.0020 to 0.3102, its mean 0.0353, the
 * base rate 0.037, the tuned threshold 0.0663 that flags 488 positions and the fixed 0.5 that
 * flags none. Nothing here is illustrative.
 *
 * The span is drawn as a filled band and the thresholds as vertical rules, so the figure reads
 * the same in both themes and without telling colours apart.
 *
 * Animated: a third rule starts on the factory 0.5 and slides down to the tuned 0.0663, holds, and
 * slides back. For the first four tenths of its trip it crosses empty axis and nothing happens;
 * the band only lights up once the rule is inside it, because only from there on is any
 * probability above the threshold. That dead stretch is what the motion teaches: a threshold
 * outside the span is not a strict threshold, it is no threshold at all. The glow is on or off,
 * never proportional, since the band is a span and not a density (the 488 flagged positions are
 * 13 % of the 3 660, not the share of the band to the right of the rule). The rule's trip,
 * `--travel`, comes from the same `x()` as the static rules; the moment it enters the band is
 * written in `global.css` as keyframe percentages derived there from these numbers. With motion
 * reduced, the moving rule and the glow are not drawn and the two fixed rules say it all.
 */
const left = 40;
const width = 560;
const x = (p: number) => left + p * width;

const axisY = 122;
const bandTop = 72;
const bandHeight = 30;
const ticks = Array.from({ length: 11 }, (_, i) => i / 10);

const spanLow = 0.002;
const spanHigh = 0.3102;
const mean = 0.0353;
const tuned = 0.0663;
const fixed = 0.5;
---

<svg
  class="fig--operating"
  viewBox="0 0 640 196"
  role="img"
  aria-label="Un eje de probabilidad de 0 a 1; en la versión animada, una tercera línea baja del umbral de fábrica al elegido y la franja solo se ilumina cuando la línea entra en ella. Una franja rellena va de 0,002 a 0,310: ahí caen todas las probabilidades que la cabeza de errores da a las 3 660 posiciones puntuadas, con media 0,035. Una línea vertical en 0,0663, el umbral elegido en la mitad tune, cae dentro de la franja y marca 488 posiciones con F1 0,180. Otra línea vertical en 0,5, el umbral de fábrica, queda fuera de la franja y no marca ninguna: F1 0,000."
>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    <rect
      x={x(spanLow)}
      y={bandTop}
      width={x(spanHigh) - x(spanLow)}
      height={bandHeight}
      rx="2"
      fill="var(--accent)"
      fill-opacity="0.28"
      stroke="var(--accent)"
      stroke-width="1"
    ></rect>
    <rect
      class="fig-operating__glow"
      x={x(spanLow)}
      y={bandTop}
      width={x(spanHigh) - x(spanLow)}
      height={bandHeight}
      rx="2"
      fill="var(--accent)"
      opacity="0"
    ></rect>
    <line
      x1={x(mean)}
      y1={bandTop + bandHeight}
      x2={x(mean)}
      y2={bandTop + bandHeight - 10}
      stroke="var(--ink)"
      stroke-width="1.5"
    ></line>

    <line
      x1={left}
      y1={axisY}
      x2={left + width}
      y2={axisY}
      stroke="var(--line)"
      stroke-width="1"
    ></line>
    {ticks.map((t) => (
      <g>
        <line x1={x(t)} y1={axisY} x2={x(t)} y2={axisY + 5} stroke="var(--line)" stroke-width="1" />
        <text x={x(t)} y={axisY + 18} text-anchor="middle">
          {t === 0 ? '0' : t === 1 ? '1' : `0,${Math.round(t * 10)}`}
        </text>
      </g>
    ))}

    <line
      x1={x(tuned)}
      y1="54"
      x2={x(tuned)}
      y2={axisY}
      stroke="var(--ink)"
      stroke-width="1.5"
    ></line>
    <text x={x(tuned) + 6} y="28" fill="var(--ink)" font-size="11">
      umbral elegido en tune, 0,0663
    </text>
    <text x={x(tuned) + 6} y="44" fill="var(--accent-text)" font-size="11">
      marca 488 de 3 660 · F1 0,180
    </text>

    <line
      x1={x(fixed)}
      y1="54"
      x2={x(fixed)}
      y2={axisY}
      stroke="var(--ink)"
      stroke-width="1.5"
      stroke-dasharray="4 3"
    ></line>
    <text x={x(fixed) + 6} y="28" fill="var(--ink)" font-size="11">
      umbral de fábrica, 0,5
    </text>
    <text x={x(fixed) + 6} y="44" font-size="11">
      marca 0 · F1 0,000
    </text>

    <line
      class="fig-operating__sweep"
      style={`--travel:${(x(tuned) - x(fixed)).toFixed(2)}px`}
      x1={x(fixed)}
      y1="54"
      x2={x(fixed)}
      y2={axisY}
      stroke="var(--accent-text)"
      stroke-width="3"
    ></line>

    <text x={left} y="168">
      franja rellena: todas las probabilidades, de 0,002 a 0,310
    </text>
    <text x={left} y="184">
      marca corta dentro de la franja: su media, 0,035, casi la tasa base (0,037)
    </text>
  </g>
</svg>
