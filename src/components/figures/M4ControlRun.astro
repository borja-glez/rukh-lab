---
/**
 * The control run, drawn: the untuned model walks most of the same axis.
 *
 * Two headers, two models, the same sweep suite (160 games per point against the eight Stockfish
 * rungs). `medium-elo` goes from 1425 to 1606 between `<w1200>` and `<w2100>`; `medium-v4`, whose
 * `<w1200>` never received a gradient, goes from 1419 to 1580. The fine-tune adds twenty points to a
 * slope that was already there, and every interval of one model overlaps the matching interval of
 * the other. That is why the Elo column alone is not evidence of conditioning.
 *
 * Numbers are the measured ones from lesson 9. The two lines are told apart by dash pattern and by
 * the labels at their right end, not only by colour. Static: the comparison is the two slopes.
 */
interface Point {
  header: number;
  elo: number;
  lo: number;
  hi: number;
}

interface Series {
  label: string;
  gain: string;
  stroke: string;
  dash?: string;
  offset: number;
  points: [Point, Point];
}

const series: Series[] = [
  {
    label: 'medium-v4 (base)',
    gain: '+161',
    stroke: 'var(--muted)',
    dash: '5 4',
    offset: -9,
    points: [
      { header: 1200, elo: 1419, lo: 1358, hi: 1479 },
      { header: 2100, elo: 1580, lo: 1512, hi: 1649 },
    ],
  },
  {
    label: 'medium-elo',
    gain: '+181',
    stroke: 'var(--accent)',
    offset: 9,
    points: [
      { header: 1200, elo: 1425, lo: 1361, hi: 1479 },
      { header: 2100, elo: 1606, lo: 1543, hi: 1670 },
    ],
  },
];

const LOW = 1340;
const HIGH = 1690;
const y = (elo: number) => 236 - ((elo - LOW) / (HIGH - LOW)) * 200;
const colX = { 1200: 190, 2100: 400 } as Record<number, number>;
const ticks = [1400, 1500, 1600];
---

<svg
  viewBox="0 0 640 280"
  role="img"
  aria-label="Elo medido con dos cabeceras, w1200 y w2100, para dos modelos. El modelo sin afinar pasa de 1419 a 1580, ciento sesenta y un puntos, aunque su cabecera w1200 nunca se entrenó. El modelo afinado pasa de 1425 a 1606, ciento ochenta y un puntos. Los intervalos de los dos modelos se solapan en las dos cabeceras."
>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    {ticks.map((tick) => (
      <g>
        <line
          x1="80"
          y1={y(tick)}
          x2="470"
          y2={y(tick)}
          stroke="var(--line)"
          stroke-width="0.8"
          stroke-dasharray="2 4"
        />
        <text x="72" y={y(tick) + 4} text-anchor="end">
          {tick}
        </text>
      </g>
    ))}
    <text x="10" y="20" fill="var(--ink)" font-size="11">
      Elo medido (IC 95 %)
    </text>

    {series.map((s) => (
      <g>
        <line
          x1={colX[s.points[0].header] + s.offset}
          y1={y(s.points[0].elo)}
          x2={colX[s.points[1].header] + s.offset}
          y2={y(s.points[1].elo)}
          stroke={s.stroke}
          stroke-width="1.8"
          stroke-dasharray={s.dash}
        />
        {s.points.map((p) => (
          <g>
            <line
              x1={colX[p.header] + s.offset}
              y1={y(p.lo)}
              x2={colX[p.header] + s.offset}
              y2={y(p.hi)}
              stroke={s.stroke}
              stroke-width="5"
              stroke-opacity="0.35"
            />
            <circle
              cx={colX[p.header] + s.offset}
              cy={y(p.elo)}
              r="4"
              fill="var(--paper)"
              stroke={s.stroke}
              stroke-width="1.6"
            />
          </g>
        ))}
        <text x="488" y={y(s.points[1].elo) + 4} fill="var(--ink)">
          {s.gain} · {s.label}
        </text>
      </g>
    ))}

    <text x={colX[1200]} y="262" text-anchor="middle" fill="var(--ink)">
      &lt;w1200&gt;
    </text>
    <text x={colX[2100]} y="262" text-anchor="middle" fill="var(--ink)">
      &lt;w2100&gt;
    </text>
    <text x="295" y="276" text-anchor="middle">
      cabecera pedida
    </text>
  </g>
</svg>
