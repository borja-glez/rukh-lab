---
/**
 * Why subtracting two ladder ratings is a worse instrument than playing a match, with the two
 * measurements the project actually has for the same pair of models.
 *
 * Top: the Stockfish ladder. `medium-v4` reads 1504 (1446-1558) and the same model after DPO reads
 * 1529 (1470-1583). Subtract them and the difference is +25 with a half-width of
 * sqrt(56^2 + 56.5^2) = 80, so the interval runs from -55 to +105 and sails straight through zero.
 * Each absolute brings its whole noise to the subtraction, and the difference ends up wider than
 * either measurement that went into it.
 *
 * Bottom: the same two checkpoints playing each other. +40 Elo, interval 11 to 69, separated from
 * zero, in four minutes of machine. Same models, same conclusion, and one instrument can state it
 * while the other cannot.
 *
 * Worth keeping straight, because the first version of this figure got it wrong: D-107's famous
 * 1498 and 1558 are two readings of the **same** model by two paths, which is where the ladder's
 * 40-Elo reproducibility floor comes from. That floor is the reason the intervals above are as
 * wide as they are; it is not the base-versus-DPO comparison.
 */
const LOW = 1420;
const HIGH = 1620;
const x = (elo: number) => 150 + ((elo - LOW) / (HIGH - LOW)) * 460;

const ladder = [
  { label: 'base', elo: 1504, lo: 1446, hi: 1558, y: 62 },
  { label: '+ DPO', elo: 1529, lo: 1470, hi: 1583, y: 92 },
];

const ticks = [1450, 1500, 1550, 1600];

// The difference axis of the bottom half, in Elo, drawn over the same pixel span.
const DIFF_LOW = -80;
const DIFF_HIGH = 120;
const dx = (elo: number) => 150 + ((elo - DIFF_LOW) / (DIFF_HIGH - DIFF_LOW)) * 460;
const diffTicks = [-50, 0, 50, 100];
---

<figure class="fig fig--noise">
  <svg
    viewBox="0 0 640 268"
    role="img"
    aria-label="Arriba, dos medidas absolutas contra la escalera de Stockfish: el modelo base en 1504 con intervalo de 1446 a 1558, y el mismo modelo tras DPO en 1529 con intervalo de 1470 a 1583. Su diferencia es de veinticinco puntos con un intervalo de menos cincuenta y cinco a más ciento cinco, que atraviesa el cero. Abajo, los mismos dos modelos enfrentados entre sí: más cuarenta puntos de Elo con intervalo de once a sesenta y nueve, que no toca el cero."
  >
    <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
      <text x="10" y="34" fill="var(--ink)">
        restar dos absolutos
      </text>
      {ladder.map((row, index) => (
        <g>
          <text x="10" y={row.y + 4}>
            {row.label}
          </text>
          <rect
            x={x(row.lo)}
            y={row.y - 7}
            width={x(row.hi) - x(row.lo)}
            height="11"
            rx="2"
            fill={index === 0 ? 'var(--diagram-stroke)' : 'var(--accent)'}
            fill-opacity="0.22"
            stroke={index === 0 ? 'var(--line)' : 'var(--accent)'}
            stroke-width="0.8"
          />
          <line
            x1={x(row.elo)}
            y1={row.y - 9}
            x2={x(row.elo)}
            y2={row.y + 6}
            stroke={index === 0 ? 'var(--ink)' : 'var(--accent)'}
            stroke-width="1.4"
          ></line>
          <text x={x(row.elo)} y={row.y - 13} text-anchor="middle" font-size="9">
            {row.elo}
          </text>
        </g>
      ))}
      {ticks.map((elo) => (
        <text x={x(elo)} y="122" text-anchor="middle" font-size="9">
          {elo}
        </text>
      ))}
      <text x="10" y="140" font-size="9" fill="var(--ink)">
        diferencia: +25, pero ±80 de intervalo — de −55 a +105, atraviesa el cero
      </text>

      <line x1="10" y1="158" x2="630" y2="158" stroke="var(--line)" stroke-width="0.6"></line>

      <text x="10" y="184" fill="var(--ink)">
        medir la diferencia
      </text>
      <text x="10" y="216" font-size="10">
        DPO − base
      </text>
      <rect
        x={dx(11)}
        y="205"
        width={dx(69) - dx(11)}
        height="11"
        rx="2"
        fill="var(--accent)"
        fill-opacity="0.3"
        stroke="var(--accent)"
        stroke-width="0.8"
      ></rect>
      <line
        x1={dx(40)}
        y1="203"
        x2={dx(40)}
        y2="218"
        stroke="var(--accent)"
        stroke-width="1.4"
      ></line>
      <text x={dx(40)} y="200" text-anchor="middle" font-size="9" fill="var(--accent-text-aa)">
        +40
      </text>
      <line
        x1={dx(0)}
        y1="196"
        x2={dx(0)}
        y2="226"
        stroke="var(--ink)"
        stroke-width="1"
        stroke-dasharray="2 2"
      ></line>
      {diffTicks.map((elo) => (
        <text x={dx(elo)} y="240" text-anchor="middle" font-size="9">
          {elo}
        </text>
      ))}
      <text x="10" y="258" font-size="9" fill="var(--accent-text-aa)">
        400 partidas, cuatro minutos: de +11 a +69, no toca el cero
      </text>
    </g>
  </svg>
  <figcaption class="caption">
    Los mismos dos modelos. Arriba, dos medidas de ±56 cuya resta sale de ±80 y atraviesa el cero.
    Abajo, la diferencia medida de frente.
  </figcaption>
</figure>
