---
/**
 * The data pipeline of M1, from the Lichess PGN to the packed token stream.
 *
 * In a component rather than inline in the MDX: Prettier breaks every JSX element's children
 * onto their own line, MDX reads a multi-line body as markdown and wraps it in a `<p>`, and a
 * `<p>` inside SVG makes the parser close the `<svg>`. This figure shipped broken from P0 for
 * exactly that reason. An `.astro` template is HTML, so formatting it is safe.
 */
---

<svg
  viewBox="0 0 640 240"
  role="img"
  aria-label="Pipeline de datos: fetch, uci, tokenize; positions, evals, pairs; puzzles, elite, elo-bins; publish"
>
  <g
    font-family="var(--font-mono)"
    font-size="11"
    fill="var(--ink)"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    <rect
      x="10"
      y="20"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="55" y="42">
      fetch
    </text>
    <rect
      x="130"
      y="20"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="175" y="42">
      uci
    </text>
    <rect
      x="250"
      y="20"
      width="90"
      height="44"
      fill="var(--ink)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="295" y="42" fill="var(--paper)">
      tokenize
    </text>
    <rect
      x="370"
      y="20"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="415" y="42">
      positions
    </text>
    <rect
      x="490"
      y="20"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--accent-text)"
      stroke-width="1.25"
    />
    <text x="535" y="42">
      evals
    </text>
    <rect
      x="130"
      y="110"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="175" y="132">
      elite
    </text>
    <rect
      x="250"
      y="110"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="295" y="132">
      elo-bins
    </text>
    <rect
      x="370"
      y="110"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="415" y="132">
      puzzles
    </text>
    <rect
      x="490"
      y="110"
      width="90"
      height="44"
      fill="var(--box-fill)"
      stroke="var(--accent-text)"
      stroke-width="1.25"
    />
    <text x="535" y="132">
      pairs
    </text>
    <rect
      x="250"
      y="190"
      width="140"
      height="36"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="320" y="208">
      publish → chorcat/
    </text>
  </g>
  <g fill="none" stroke="var(--diagram-stroke)" stroke-width="1.25">
    <path d="M100 42h30" />
    <path d="M220 42h30" />
    <path d="M340 42h30" />
    <path d="M460 42h30" />
    <path d="M535 64v46" />
    <path d="M175 64v46" stroke-dasharray="3 3" />
    <path d="M295 64v46" stroke-dasharray="3 3" />
    <path d="M415 64v46" stroke-dasharray="3 3" />
    <path d="M320 154v36" />
  </g>
  <g font-family="var(--font-mono)" font-size="9" fill="var(--diagram-stroke)" text-anchor="middle">
    <text x="120" y="98">
      mismo uci.py
    </text>
    <text x="580" y="98">
      multi-PV
    </text>
  </g>
</svg>
