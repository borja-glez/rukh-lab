---
/**
 * The data pipeline of M1, from the Lichess PGN to the packed token stream and the published
 * datasets.
 *
 * Arrows are real inputs, read from each step's config in `rukh/src/rukh/data/`: `uci` reads
 * `fetch`; `tokenize`, `positions` and `elo-bins` read `uci`; `evals` reads `positions`; `pairs`
 * reads `evals` and, for the prompts, `uci`. `puzzles` and `elite` download from Lichess on their
 * own (`elite` converts with the same `uci.py`). `publish` uploads the seven steps drawn with the
 * accent stroke (the `DATASETS` registry in `publish.py`); `fetch` and `positions` stay local.
 * The line at the top is the order the commands run in.
 *
 * In a component rather than inline in the MDX: Prettier breaks every JSX element's children
 * onto their own line, MDX reads a multi-line body as markdown and wraps it in a `<p>`, and a
 * `<p>` inside SVG makes the parser close the `<svg>`. This figure shipped broken from P0 for
 * exactly that reason. An `.astro` template is HTML, so formatting it is safe.
 */
interface Step {
  name: string;
  x: number;
  y: number;
  published: boolean;
  dark?: boolean;
}

const W = 90;
const H = 44;

const steps: Step[] = [
  { name: 'fetch', x: 10, y: 110, published: false },
  { name: 'uci', x: 130, y: 110, published: true },
  { name: 'tokenize', x: 260, y: 30, published: true, dark: true },
  { name: 'positions', x: 260, y: 110, published: false },
  { name: 'evals', x: 380, y: 110, published: true },
  { name: 'pairs', x: 500, y: 110, published: true },
  { name: 'elo-bins', x: 130, y: 190, published: true },
  { name: 'puzzles', x: 380, y: 190, published: true },
  { name: 'elite', x: 500, y: 190, published: true },
];
---

<svg
  viewBox="0 0 640 300"
  role="img"
  aria-label="Pipeline de datos de M1. Orden de ejecución: fetch, uci, tokenize, positions, evals, puzzles, pairs, elite, elo-bins, publish. Dependencias: uci lee fetch; tokenize, positions y elo-bins leen uci; evals lee positions; pairs lee evals y los prefijos de uci; puzzles y elite descargan de Lichess por su cuenta. publish sube a chorcat/ los siete pasos marcados: uci, tokenize, evals, pairs, elo-bins, puzzles y elite."
>
  <text
    x="320"
    y="14"
    font-family="var(--font-mono)"
    font-size="9"
    fill="var(--muted)"
    text-anchor="middle"
  >
    orden: fetch → uci → tokenize → positions → evals → puzzles → pairs → elite → elo-bins → publish
  </text>

  <g
    font-family="var(--font-mono)"
    font-size="11"
    fill="var(--ink)"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    {steps.map((s) => (
      <>
        <rect
          x={s.x}
          y={s.y}
          width={W}
          height={H}
          fill={s.dark ? 'var(--ink)' : 'var(--box-fill)'}
          stroke={s.published ? 'var(--accent-text)' : 'var(--ink)'}
          stroke-width={s.published ? 2 : 1.25}
        />
        <text x={s.x + W / 2} y={s.y + H / 2} fill={s.dark ? 'var(--paper)' : 'var(--ink)'}>
          {s.name}
        </text>
      </>
    ))}

    <rect
      x="130"
      y="258"
      width="460"
      height="32"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
    />
    <text x="250" y="274">
      publish → chorcat/
    </text>
    <rect
      x="346"
      y="267"
      width="14"
      height="14"
      fill="var(--box-fill)"
      stroke="var(--accent-text)"
      stroke-width="2"
    />
    <text x="470" y="274" font-size="9" fill="var(--muted)">
      = los siete que publish sube
    </text>
  </g>

  <g fill="none" stroke="var(--diagram-stroke)" stroke-width="1.25">
    <path d="M100 132h30" />
    <path d="M220 124h20V52h20" />
    <path d="M220 132h40" />
    <path d="M175 154v36" />
    <path d="M350 132h30" />
    <path d="M470 132h30" />
    <path d="M220 148h20v28h305v-22" stroke-dasharray="3 3" />
  </g>

  <g font-family="var(--font-mono)" font-size="9" fill="var(--diagram-stroke)" text-anchor="middle">
    <text x="425" y="102">
      multi-PV
    </text>
    <text x="545" y="102">
      + prefijos de uci
    </text>
    <text x="425" y="246">
      descarga propia
    </text>
    <text x="545" y="246">
      descarga propia · uci.py
    </text>
  </g>
</svg>
