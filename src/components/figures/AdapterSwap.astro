---
/**
 * What "swappable" costs, drawn honestly.
 *
 * The left column is what LoRA promises: one copy of the weights, and a style is 1.6 MB that
 * clips onto it. The right column is what a browser actually gets, because ONNX has no notion of
 * an adapter: every style is a whole model, and the 1.6 MB becomes the size of the export.
 *
 * Both columns are the same measurement -- the same two adapters over the same base -- so the
 * figure is not an argument against LoRA. It is the reason the lesson spends a section on the
 * deployment format: the method is cheap and the format is where the saving is thrown away,
 * unless somebody designs for it.
 *
 * The animation swaps the adapter on the left column and leaves the right one alone, which is
 * the difference in one gesture: on one side a clip moves, on the other a download happens.
 */
const MB_BASE = 221;
const MB_ADAPTER = 1.6;
const styles = [
  { id: 'e4', label: '1. e4' },
  { id: 'd4', label: '1. d4' },
];
---

<figure class="swap">
  <svg
    viewBox="0 0 640 260"
    role="img"
    aria-label="A la izquierda, un modelo base de 221 megabytes con dos adaptadores de 1,6 megabytes que se intercambian sobre él. A la derecha, el mismo par de estilos como dos modelos ONNX completos de 221 megabytes cada uno."
  >
    <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
      <text x="16" y="18" fill="var(--ink)">
        en PyTorch · una base, dos clips
      </text>

      <rect
        x="16"
        y="30"
        width="230"
        height="96"
        fill="var(--diagram-stroke)"
        fill-opacity="0.22"
        stroke="var(--line)"
        stroke-width="1"
      ></rect>
      <text x="131" y="72" text-anchor="middle" font-size="11" fill="var(--ink)">
        `medium` · congelada
      </text>
      <text x="131" y="88" text-anchor="middle">
        {MB_BASE} MB, una sola vez
      </text>

      {styles.map((style, index) => (
        <g class={`clip clip--${index}`}>
          <rect
            x={16 + index * 122}
            y="140"
            width="108"
            height="42"
            fill="var(--accent)"
            fill-opacity="0.3"
            stroke="var(--accent)"
            stroke-width="1"
          />
          <text x={70 + index * 122} y="158" text-anchor="middle" font-size="10" fill="var(--ink)">
            {style.label}
          </text>
          <text x={70 + index * 122} y="172" text-anchor="middle" font-size="9">
            {MB_ADAPTER} MB
          </text>
        </g>
      ))}
      <text x="16" y="204" font-size="9.5">
        {MB_BASE + MB_ADAPTER * styles.length} MB en total · cambiar de estilo no descarga nada
      </text>

      <line
        x1="300"
        y1="24"
        x2="300"
        y2="236"
        stroke="var(--line)"
        stroke-width="1"
        stroke-dasharray="3 3"
      ></line>

      <text x="330" y="18" fill="var(--ink)">
        en ONNX · dos modelos enteros
      </text>
      {styles.map((style, index) => (
        <g>
          <rect
            x={330 + index * 150}
            y="30"
            width="134"
            height="152"
            fill="var(--event)"
            fill-opacity="0.18"
            stroke="var(--line)"
            stroke-width="1"
          />
          <text x={397 + index * 150} y="100" text-anchor="middle" font-size="11" fill="var(--ink)">
            {style.label}
          </text>
          <text x={397 + index * 150} y="116" text-anchor="middle">
            {MB_BASE} MB
          </text>
        </g>
      ))}
      <text x="330" y="204" font-size="9.5">
        {MB_BASE * styles.length} MB en total · el ahorro de LoRA se pierde al exportar
      </text>
      <text x="330" y="222" font-size="9.5" fill="var(--accent-text-aa)">
        salvo que el adaptador entre en el grafo como una entrada más
      </text>
    </g>
  </svg>
  <figcaption class="caption">
    La técnica es barata; el formato de despliegue es donde se tira el ahorro. Las dos mitades de la
    figura son la misma pareja de adaptadores sobre la misma base.
  </figcaption>
</figure>

<style>
  .swap svg {
    width: 100%;
    height: auto;
  }

  /*
   * Only the left column moves: that is the whole comparison. One clip is on the base at a time
   * and they take turns, while the two ONNX files on the right just sit there being two files.
   */
  @keyframes swap-in {
    0%,
    45% {
      opacity: 1;
      transform: translateY(0);
    }
    50%,
    95% {
      opacity: 0.18;
      transform: translateY(14px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .clip {
    animation: swap-in 6s ease-in-out infinite;
  }

  /* Position comes from the SVG coordinates, never from a transform: the animation owns
     `transform`, and a second declaration here would simply win and put both clips on top of
     each other. */
  .clip--1 {
    animation-delay: -3s;
  }

  @media (prefers-reduced-motion: reduce) {
    .clip {
      animation: none;
    }
    .clip--1 {
      opacity: 0.35;
    }
  }
</style>
