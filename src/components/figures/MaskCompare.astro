---
/**
 * The only difference between the decoder and the encoder, drawn: which positions each one is
 * allowed to read.
 *
 * Lives in a component rather than inline in the MDX because Prettier formats MDX by breaking
 * every JSX element's children onto their own line, and MDX then treats a multi-line body as
 * markdown and wraps it in a `<p>`. A `<p>` inside SVG makes the HTML parser close the `<svg>`
 * and spill the rest into the page -- which is how the M0 and M1 figures shipped broken from P0.
 * In an `.astro` file the template is HTML, so the formatter and the compiler agree.
 *
 * Both grids use the same colour: a painted cell means the same thing ("this read is allowed")
 * on either side, and the figure is about the shape of the painted area, not about two models.
 */
const n = 8;
const cell = 24;
const gap = 2;
const step = cell + gap;
/* Left edge and top edge of each grid, leaving room for the axis labels and the indices. */
const originX = 58;
const originY = 46;
const indices = Array.from({ length: n }, (_, i) => i + 1);
const cells = indices.flatMap((row) => indices.map((col) => ({ row, col })));
const gridSize = n * step - gap;

const panels = [
  {
    dx: 0,
    title: 'causal · el decoder de M2',
    allowed: (row: number, col: number) => col <= row,
    caption: 'cada fila solo lee su pasado',
    count: '36 de 64 lecturas permitidas',
  },
  {
    dx: 300,
    title: 'bidireccional · el encoder de M3',
    allowed: () => true,
    caption: 'cada fila lee la secuencia entera',
    count: '64 de 64 lecturas permitidas',
  },
];
---

<svg
  viewBox="0 0 600 310"
  role="img"
  aria-label="Dos rejillas de 8 por 8 con el mismo color. Las filas son la posición que mira y las columnas la posición mirada. En la causal solo está pintado el triángulo inferior izquierdo, 36 celdas: cada posición lee su pasado. En la bidireccional están pintadas las 64 celdas: cada posición lee la secuencia entera."
>
  {panels.map((panel) => (
    <g
      font-family="var(--font-mono)"
      font-size="12"
      fill="var(--muted)"
      transform={`translate(${panel.dx} 0)`}
    >
      <text x={originX} y="16" fill="var(--ink)">
        {panel.title}
      </text>
      <text x={originX + gridSize / 2} y="36" text-anchor="middle" font-size="11">
        posición mirada (columna) →
      </text>
      <text
        x={-(originY + gridSize / 2)}
        y="14"
        text-anchor="middle"
        font-size="11"
        transform="rotate(-90)"
      >
        ← posición que mira (fila)
      </text>
      {indices.map((i) => (
        <text
          x={originX - 8}
          y={originY + (i - 1) * step + cell / 2 + 4}
          text-anchor="end"
          font-size="10"
        >
          {i}
        </text>
      ))}
      {indices.map((i) => (
        <text
          x={originX + (i - 1) * step + cell / 2}
          y={originY + gridSize + 14}
          text-anchor="middle"
          font-size="10"
        >
          {i}
        </text>
      ))}
      {cells.map(({ row, col }) => (
        <rect
          x={originX + (col - 1) * step}
          y={originY + (row - 1) * step}
          width={cell}
          height={cell}
          fill={panel.allowed(row, col) ? 'var(--accent)' : 'none'}
          fill-opacity="0.85"
          stroke="var(--line)"
          stroke-width="1"
        />
      ))}
      <text x={originX} y="284" fill="var(--ink)">
        {panel.caption}
      </text>
      <text x={originX} y="302">
        {panel.count}
      </text>
    </g>
  ))}
</svg>
