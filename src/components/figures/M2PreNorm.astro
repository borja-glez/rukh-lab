---
/**
 * Where the LayerNorm goes, drawn: post-norm puts it on the residual path after every sum, so
 * the gradient coming down from the loss crosses a normalisation per sublayer; pre-norm moves it
 * into the branch, before the sublayer, and the straight path from the loss to the embedding
 * touches nothing but additions (plus a single `ln_f` at the very top).
 *
 * One block of each kind is drawn (attention and MLP); the "x 12" label stands for the rest.
 * The residual path is the same colour in both panels on purpose: the figure is about what sits
 * on that path, not about two different streams.
 *
 * Animated: a pulse runs down the residual path of both panels at the same speed, from the loss
 * to the embedding, and every normalisation it has to cross lights up as it goes through. In
 * post-norm that is one per sublayer; in pre-norm it is `ln_f` at the top and then nothing, because
 * the branch norms sit off the path the pulse travels. The motion turns "what sits on the path"
 * into something you count as it happens. Each halo gets the height it sits at as `--hit` (0 at
 * the loss, 1 at the embedding), and `global.css` turns it into a delay, so the flash cannot drift
 * from the box. With motion reduced, the pulse and the halos are simply not there.
 */
interface Branch {
  /** Label of the sublayer box. */
  name: string;
  /** Height where the branch leaves the residual path. */
  from: number;
  /** Height of the sum (the `x +`) where it comes back. */
  sum: number;
  /** Height of the LayerNorm that post-norm puts on the path after the sum. */
  norm: number;
}

const branches: Branch[] = [
  { name: 'atención', from: 262, sum: 222, norm: 196 },
  { name: 'MLP', from: 164, sum: 124, norm: 98 },
];

const panels = [
  { x0: 16, title: 'post-norm · el artículo original', pre: false },
  { x0: 330, title: 'pre-norm · GPT-2, Llama, Rukh', pre: true },
];

/* The residual path runs at this offset inside each panel. */
const lane = 74;
const top = 52;
const bottom = 304;
const hit = (y: number) => `--hit:${((y - top) / (bottom - top)).toFixed(3)}`;
---

<svg
  class="fig--prenorm"
  viewBox="0 0 640 346"
  role="img"
  aria-label="Dos bloques de Transformer lado a lado; en la versión animada un pulso baja por el camino residual de los dos y se iluminan las normalizaciones que atraviesa. En post-norm, la normalización está sobre el camino residual después de cada suma, así que el gradiente que baja desde la pérdida atraviesa una normalización por subcapa. En pre-norm, la normalización está dentro de cada rama, antes de la atención y del MLP, y el camino recto desde la pérdida hasta el embedding solo tiene sumas y una normalización final."
>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
    {panels.map((p) => {
      const sx = p.x0 + lane;
      return (
        <>
          <text x={p.x0} y="18" fill="var(--muted)">
            {p.title}
          </text>
          <text x={sx} y="40" text-anchor="middle">
            pérdida
          </text>
          <text x={sx} y="330" text-anchor="middle">
            embedding
          </text>
          <text x={sx - 14} y="150" text-anchor="end" font-size="10" fill="var(--muted)">
            gradiente ↓
          </text>

          <line x1={sx} y1={top} x2={sx} y2={bottom} stroke="var(--accent)" stroke-width="3" />
          <circle
            class="fig-prenorm__pulse"
            style={`--run:${bottom - top}px`}
            cx={sx}
            cy={top}
            r="5"
            fill="var(--ink)"
            stroke="var(--paper)"
            stroke-width="1.5"
          />

          {branches.map((b) => {
            const boxLeft = p.x0 + 158;
            const boxRight = p.x0 + 238;
            const exit = p.x0 + 254;
            return (
              <>
                <path
                  d={`M${sx} ${b.from} H${boxLeft}`}
                  fill="none"
                  stroke="var(--diagram-stroke)"
                  stroke-width="1.25"
                />
                <path
                  d={`M${boxRight} ${b.from} H${exit} V${b.sum} H${sx + 9}`}
                  fill="none"
                  stroke="var(--diagram-stroke)"
                  stroke-width="1.25"
                />
                {p.pre && (
                  <>
                    <rect
                      x={p.x0 + 100}
                      y={b.from - 10}
                      width="44"
                      height="20"
                      fill="var(--box-fill)"
                      stroke="var(--accent-text)"
                      stroke-width="1.25"
                    />
                    <text x={p.x0 + 122} y={b.from + 4} text-anchor="middle" font-size="10">
                      LN
                    </text>
                  </>
                )}
                <rect
                  x={boxLeft}
                  y={b.from - 13}
                  width={boxRight - boxLeft}
                  height="26"
                  fill="var(--box-fill)"
                  stroke="var(--line)"
                  stroke-width="1.25"
                />
                <text x={(boxLeft + boxRight) / 2} y={b.from + 4} text-anchor="middle">
                  {b.name}
                </text>
                <circle
                  cx={sx}
                  cy={b.sum}
                  r="9"
                  fill="var(--paper)"
                  stroke="var(--ink)"
                  stroke-width="1.25"
                />
                <text x={sx} y={b.sum + 4} text-anchor="middle">
                  +
                </text>
                {!p.pre && (
                  <>
                    <rect
                      class="fig-prenorm__halo"
                      style={hit(b.norm)}
                      x={sx - 27}
                      y={b.norm - 15}
                      width="54"
                      height="30"
                      rx="3"
                      fill="var(--accent)"
                      opacity="0"
                    />
                    <rect
                      x={sx - 22}
                      y={b.norm - 10}
                      width="44"
                      height="20"
                      fill="var(--box-fill)"
                      stroke="var(--accent-text)"
                      stroke-width="1.25"
                    />
                    <text x={sx} y={b.norm + 4} text-anchor="middle" font-size="10">
                      LN
                    </text>
                  </>
                )}
              </>
            );
          })}

          {p.pre && (
            <>
              <rect
                class="fig-prenorm__halo"
                style={hit(72)}
                x={sx - 27}
                y="57"
                width="54"
                height="30"
                rx="3"
                fill="var(--accent)"
                opacity="0"
              />
              <rect
                x={sx - 22}
                y="62"
                width="44"
                height="20"
                fill="var(--box-fill)"
                stroke="var(--accent-text)"
                stroke-width="1.25"
              />
              <text x={sx} y="76" text-anchor="middle" font-size="10">
                ln_f
              </text>
              <text x={sx + 30} y="76" font-size="10" fill="var(--muted)">
                una sola, al final
              </text>
            </>
          )}

          <text x={p.x0 + 254} y="300" text-anchor="end" font-size="10" fill="var(--muted)">
            × 12 bloques
          </text>
        </>
      );
    })}
  </g>
</svg>
