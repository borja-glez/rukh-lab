---
/**
 * How a trained BPE encodes a word: start from characters and, round after round, apply the
 * merge that was learned earliest among the adjacent pairs present.
 *
 * The ranks are the real ones of `artifacts/tokenizer/bpe.json` (the first ten merges printed by
 * lab 5 of M1: d+4, f+3, f+6, e+4, d+5, e+5, e+7, d+7, e+2, c+3), counted from one. No other pair
 * of `e2e4e7e5` is among those ten, so the four rounds drawn are exactly what the encoder does
 * first. What happens after them (e2 + e4 into a move, moves into opening chunks) depends on
 * later ranks the lab does not print, so the figure only names it.
 *
 * Animated: the rounds arrive one at a time, each row sliding down from the one above it, and the
 * closing line comes last. What the motion teaches is the order: the encoder does not sweep the
 * text from left to right, it jumps to wherever the earliest-learned merge applies (the second
 * pair first, then the last, then the third, and the first pair only at the end). The finished
 * stack is the static figure, which is what `prefers-reduced-motion` keeps.
 */
type Sym = { t: string; fresh?: boolean };

const rounds: { label: string; syms: Sym[] }[] = [
  {
    label: 'texto: e2e4e7e5',
    syms: ['e', '2', 'e', '4', 'e', '7', 'e', '5'].map((t) => ({ t })),
  },
  {
    label: 'fusión n.º 4 · e + 4',
    syms: [
      { t: 'e' },
      { t: '2' },
      { t: 'e4', fresh: true },
      { t: 'e' },
      { t: '7' },
      { t: 'e' },
      { t: '5' },
    ],
  },
  {
    label: 'fusión n.º 6 · e + 5',
    syms: [{ t: 'e' }, { t: '2' }, { t: 'e4' }, { t: 'e' }, { t: '7' }, { t: 'e5', fresh: true }],
  },
  {
    label: 'fusión n.º 7 · e + 7',
    syms: [{ t: 'e' }, { t: '2' }, { t: 'e4' }, { t: 'e7', fresh: true }, { t: 'e5' }],
  },
  {
    label: 'fusión n.º 9 · e + 2',
    syms: [{ t: 'e2', fresh: true }, { t: 'e4' }, { t: 'e7' }, { t: 'e5' }],
  },
];

const labelX = 16;
const boxX = 236;
const gap = 6;
const boxH = 26;
const rowStep = 42;
const widthOf = (t: string) => (t.length === 1 ? 30 : 46);

const placed = rounds.map((round, i) => {
  let x = boxX;
  const boxes = round.syms.map((s) => {
    const w = widthOf(s.t);
    const box = { ...s, x, w };
    x += w + gap;
    return box;
  });
  return { ...round, y: 20 + i * rowStep, boxes };
});

const legend = [
  { fill: 'var(--accent)', opacity: 0.85, text: 'fusión aplicada en esa vuelta', x: 16 },
  { fill: 'var(--box-fill)', opacity: 1, text: 'símbolo que ya estaba', x: 300 },
];
---

<svg
  class="fig--bpe"
  viewBox="0 0 640 300"
  role="img"
  aria-label="El BPE codificando e2e4e7e5, vuelta a vuelta; en la versión animada las vueltas aparecen una tras otra. Parte de ocho caracteres. En cada vuelta aplica, de los pares adyacentes presentes, la fusión que aprendió antes: primero e más 4, la cuarta de su lista; después e más 5, la sexta; después e más 7, la séptima; y por último e más 2, la novena. Quedan cuatro casillas, e2 e4 e7 e5. Fusiones más tardías unen casillas en jugadas y jugadas en trozos de apertura."
>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
    {placed.map((row, i) => (
      <g class={`fig-bpe__round fig-bpe__round--${i}`}>
        <text x={labelX} y={row.y + 17} fill="var(--muted)">
          {row.label}
        </text>
        {row.boxes.map((b) => (
          <>
            <rect
              x={b.x}
              y={row.y}
              width={b.w}
              height={boxH}
              fill={b.fresh ? 'var(--accent)' : 'var(--box-fill)'}
              fill-opacity={b.fresh ? 0.85 : 1}
              stroke="var(--line)"
            />
            <text x={b.x + b.w / 2} y={row.y + 17} text-anchor="middle" font-size="12">
              {b.t}
            </text>
          </>
        ))}
      </g>
    ))}
    <text class="fig-bpe__tail" x={labelX} y="240" fill="var(--muted)">
      después, fusiones más tardías: e2 + e4 → e2e4, y jugadas en trozos de apertura
    </text>
    {legend.map((item) => (
      <>
        <rect
          x={item.x}
          y="268"
          width="14"
          height="12"
          fill={item.fill}
          fill-opacity={item.opacity}
          stroke="var(--line)"
        />
        <text x={item.x + 20} y="278" font-size="10" fill="var(--muted)">
          {item.text}
        </text>
      </>
    ))}
  </g>
</svg>
