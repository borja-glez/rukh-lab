---
/**
 * The path of `rukh data fetch` (rukh/src/rukh/data/fetch.py at p0).
 *
 * Top row: the config is validated, `plan()` builds the query and the output paths, and a dry run
 * returns that plan and stops (accent stroke). Bottom row: the real run executes the same plan,
 * one `COPY` per month against the remote parquet (dashed, it never comes down whole), counts and
 * hashes each file it wrote, and writes the manifest last (dark box), so a directory without one
 * is an interrupted download.
 *
 * In a component rather than inline in the MDX: Prettier breaks every JSX element's children onto
 * their own line, MDX wraps a multi-line body in a `<p>`, and a `<p>` inside SVG closes the `<svg>`.
 */
interface Box {
  lines: [string, string, string];
  x: number;
  y: number;
  w: number;
  kind: 'plain' | 'stop' | 'remote' | 'proof';
}

const H = 62;

const boxes: Box[] = [
  {
    lines: ['FetchConfig', 'valida el YAML', 'clave rara = error'],
    x: 10,
    y: 20,
    w: 130,
    kind: 'plain',
  },
  { lines: ['plan()', 'la SQL y las rutas', ''], x: 170, y: 20, w: 135, kind: 'plain' },
  { lines: ['--dry-run', 'imprime el plan', 'y para aquí'], x: 500, y: 20, w: 130, kind: 'stop' },
  {
    lines: ['hf:// remoto', '~73 GB por mes', 'nunca baja entero'],
    x: 10,
    y: 150,
    w: 130,
    kind: 'remote',
  },
  {
    lines: ['COPY por mes', 'filtra en remoto', 'baja lo que pasa'],
    x: 170,
    y: 150,
    w: 135,
    kind: 'plain',
  },
  {
    lines: ['games.parquet', 'cuenta las filas', 'y su sha256'],
    x: 335,
    y: 150,
    w: 135,
    kind: 'plain',
  },
  {
    lines: ['manifest.json', 'filtros, conteos', 'y hashes, al final'],
    x: 500,
    y: 150,
    w: 130,
    kind: 'proof',
  },
];

const fill = (b: Box) => (b.kind === 'proof' ? 'var(--ink)' : 'var(--box-fill)');
const stroke = (b: Box) => (b.kind === 'stop' ? 'var(--accent-text)' : 'var(--ink)');
const ink = (b: Box) => (b.kind === 'proof' ? 'var(--paper)' : 'var(--ink)');
const sub = (b: Box) => (b.kind === 'proof' ? 'var(--paper)' : 'var(--muted)');

const label =
  'El camino de rukh data fetch. Arriba: FetchConfig valida el YAML y rechaza claves desconocidas; plan() construye la consulta SQL y las rutas de salida; con --dry-run se imprime ese plan y se para ahí, sin tocar la red ni el disco. Abajo, la descarga de verdad ejecuta el mismo plan: un COPY por mes contra el parquet remoto de Hugging Face, unos 73 GB por mes que nunca bajan enteros, porque el filtro se aplica en remoto y solo baja lo que pasa; después cuenta las filas y calcula el sha256 de cada fichero escrito; y al final escribe manifest.json con filtros, conteos y hashes.';
---

<svg viewBox="0 0 640 230" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" text-anchor="middle" dominant-baseline="middle">
    {boxes.map((b) => (
      <>
        <rect
          x={b.x}
          y={b.y}
          width={b.w}
          height={H}
          fill={fill(b)}
          stroke={stroke(b)}
          stroke-width={b.kind === 'stop' ? 2 : 1.25}
          stroke-dasharray={b.kind === 'remote' ? '5 4' : undefined}
        />
        <text x={b.x + b.w / 2} y={b.y + 17} font-size="12" fill={ink(b)}>
          {b.lines[0]}
        </text>
        <text x={b.x + b.w / 2} y={b.y + 34} font-size="10" fill={sub(b)}>
          {b.lines[1]}
        </text>
        <text x={b.x + b.w / 2} y={b.y + 49} font-size="10" fill={sub(b)}>
          {b.lines[2]}
        </text>
      </>
    ))}
  </g>

  <g fill="none" stroke="var(--diagram-stroke)" stroke-width="1.25">
    <path d="M140 51h24" />
    <path d="M305 51h189" />
    <path d="M237 82v62" />
    <path d="M140 181h24" stroke-dasharray="3 3" />
    <path d="M305 181h24" />
    <path d="M470 181h24" />
  </g>
  <g fill="var(--diagram-stroke)">
    <path d="M170 51l-7 -4v8z" />
    <path d="M500 51l-7 -4v8z" />
    <path d="M237 150l-4 -7h8z" />
    <path d="M170 181l-7 -4v8z" />
    <path d="M335 181l-7 -4v8z" />
    <path d="M500 181l-7 -4v8z" />
  </g>

  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    <text x="402" y="42" text-anchor="middle">
      si es un ensayo
    </text>
    <text x="245" y="116">
      si no, el mismo plan
    </text>
  </g>
</svg>
