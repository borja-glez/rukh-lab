---
/**
 * The spectrum of verifiability: how cheap and how trustworthy the signal is that tells you
 * whether an output was any good, across domains.
 *
 * Chess sits at the free-and-perfect end, which is why this project can measure everything. Most
 * projects do not, and what the reader has to take away is where their own domain falls and what
 * they will be paying for the signal.
 */
const rows = [
  { domain: 'ajedrez, go', oracle: 'el motor', cost: 5, trust: 100, note: 'gratis y perfecto' },
  {
    domain: 'código',
    oracle: 'los tests',
    cost: 25,
    trust: 85,
    note: 'barato; solo ve lo que cubre',
  },
  {
    domain: 'matemáticas',
    oracle: 'el comprobador',
    cost: 30,
    trust: 95,
    note: 'si la respuesta es formalizable',
  },
  {
    domain: 'extracción de datos',
    oracle: 'el esquema',
    cost: 20,
    trust: 60,
    note: 'valida la forma, no el contenido',
  },
  {
    domain: 'resumen, redacción',
    oracle: 'un LLM juez',
    cost: 60,
    trust: 40,
    note: 'barato y sesgado',
  },
  {
    domain: 'soporte, diagnóstico',
    oracle: 'una persona',
    cost: 100,
    trust: 75,
    note: 'caro, lento, el que más vale',
  },
];
const y = (i: number) => 46 + i * 34;
---

<svg
  viewBox="0 0 640 260"
  role="img"
  aria-label="Tabla comparativa: en ajedrez el oráculo es el motor, gratis y perfecto; en código son los tests; en resumen un LLM juez, barato y sesgado; en soporte una persona, cara pero la más fiable."
>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
    <text x="12" y="20" font-size="10" fill="var(--muted)">
      dominio
    </text>
    <text x="180" y="20" font-size="10" fill="var(--muted)">
      quién dice si estuvo bien
    </text>
    <text x="372" y="20" font-size="10" fill="var(--muted)">
      coste
    </text>
    <text x="500" y="20" font-size="10" fill="var(--muted)">
      cuánto te puedes fiar
    </text>
    <line x1="12" y1="28" x2="628" y2="28" stroke="var(--line)" stroke-width="1" />

    {rows.map((r, i) => (
      <>
        <text x="12" y={y(i)} font-size="11">
          {r.domain}
        </text>
        <text x="180" y={y(i)} font-size="11" fill="var(--muted)">
          {r.oracle}
        </text>
        <rect
          x="372"
          y={y(i) - 9}
          width={r.cost}
          height="10"
          fill="var(--accent)"
          fill-opacity="0.8"
        />
        <rect
          x="500"
          y={y(i) - 9}
          width={r.trust * 1.2}
          height="10"
          fill="var(--event)"
          fill-opacity="0.8"
        />
        <text x="180" y={y(i) + 13} font-size="9" fill="var(--muted)">
          {r.note}
        </text>
      </>
    ))}
  </g>
</svg>
