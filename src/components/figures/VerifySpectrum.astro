---
/**
 * The spectrum of verifiability: how cheap and how trustworthy the signal is that tells you
 * whether an output was any good, across domains.
 *
 * A scatter plot, cost on x and trust on y, because that is what the caption describes: chess
 * sits at the free-and-perfect corner, which is why this project can measure everything. Most
 * projects do not, and what the reader has to take away is where their own domain falls and what
 * they will be paying for the signal. The positions are a judgement, not a measurement, and the
 * axes say so (no numbers, only "gratis"/"caro" and "baja"/"alta").
 */
interface Point {
  domain: string;
  oracle: string;
  cost: number;
  trust: number;
  note: string;
  /** Where the label goes relative to the dot. */
  side: 'right' | 'left';
}

const points: Point[] = [
  {
    domain: 'ajedrez, go',
    oracle: 'el motor',
    cost: 5,
    trust: 100,
    note: 'gratis y perfecto',
    side: 'right',
  },
  {
    domain: 'matemáticas',
    oracle: 'el comprobador',
    cost: 30,
    trust: 95,
    note: 'si la respuesta es formalizable',
    side: 'right',
  },
  {
    domain: 'código',
    oracle: 'los tests',
    cost: 25,
    trust: 85,
    note: 'barato; solo ve lo que cubre',
    side: 'right',
  },
  {
    domain: 'extracción de datos',
    oracle: 'el esquema',
    cost: 20,
    trust: 60,
    note: 'valida la forma, no el contenido',
    side: 'right',
  },
  {
    domain: 'resumen, redacción',
    oracle: 'un LLM juez',
    cost: 60,
    trust: 40,
    note: 'barato y sesgado',
    side: 'right',
  },
  {
    domain: 'soporte, diagnóstico',
    oracle: 'una persona',
    cost: 100,
    trust: 75,
    note: 'caro, lento, el que más vale',
    side: 'left',
  },
];

// Plot area: x from 70 (cost 0) to 610 (cost 100); y from 250 (trust 0) to 30 (trust 100).
const X0 = 70;
const X1 = 610;
const Y0 = 250;
const Y1 = 30;
const px = (cost: number) => X0 + (cost / 100) * (X1 - X0);
const py = (trust: number) => Y0 - (trust / 100) * (Y0 - Y1);
---

<svg
  viewBox="0 0 640 300"
  role="img"
  aria-label="Diagrama de dispersión: coste de cada juicio en horizontal, fiabilidad en vertical. Ajedrez y go están en la esquina de gratis y perfecto (el motor); matemáticas y código cerca, con el comprobador y los tests; extracción de datos a medio camino con el esquema; resumen y redacción con un LLM juez, barato y poco fiable; soporte y diagnóstico con una persona, lo más caro y bastante fiable."
>
  <g font-family="var(--font-mono)" fill="var(--ink)">
    <rect
      x={X0}
      y={Y1}
      width={px(35) - X0}
      height={py(78) - Y1}
      fill="var(--ok)"
      fill-opacity="0.08"
      stroke="var(--ok)"
      stroke-opacity="0.35"
      stroke-dasharray="3 3"
    />
    <text x={X0 + 6} y={py(78) - 6} font-size="9" fill="var(--ok)">
      la esquina buena
    </text>

    <line x1={X0} y1={Y0} x2={X1 + 12} y2={Y0} stroke="var(--line)" stroke-width="1" />
    <line x1={X0} y1={Y0} x2={X0} y2={Y1 - 12} stroke="var(--line)" stroke-width="1" />
    <text x={X0} y={Y0 + 16} font-size="10" fill="var(--muted)">
      gratis
    </text>
    <text x={X1} y={Y0 + 16} font-size="10" fill="var(--muted)" text-anchor="end">
      caro
    </text>
    <text x={(X0 + X1) / 2} y={Y0 + 32} font-size="10" fill="var(--muted)" text-anchor="middle">
      coste de cada juicio →
    </text>
    <text x={X0 - 8} y={Y0} font-size="10" fill="var(--muted)" text-anchor="end">
      baja
    </text>
    <text x={X0 - 8} y={Y1 + 4} font-size="10" fill="var(--muted)" text-anchor="end">
      alta
    </text>
    <text
      x={X0 - 40}
      y={(Y0 + Y1) / 2}
      font-size="10"
      fill="var(--muted)"
      text-anchor="middle"
      transform={`rotate(-90 ${X0 - 40} ${(Y0 + Y1) / 2})`}
    >
      fiabilidad del juicio →
    </text>

    {points.map((p) => {
      const cx = px(p.cost);
      const cy = py(p.trust);
      const anchor = p.side === 'right' ? 'start' : 'end';
      const lx = p.side === 'right' ? cx + 10 : cx - 10;
      return (
        <>
          <circle cx={cx} cy={cy} r="5" fill="var(--accent)" stroke="var(--ink)" stroke-width="1" />
          <text x={lx} y={cy - 1} font-size="11" text-anchor={anchor}>
            {p.domain} · {p.oracle}
          </text>
          <text x={lx} y={cy + 11} font-size="9" fill="var(--muted)" text-anchor={anchor}>
            {p.note}
          </text>
        </>
      );
    })}
  </g>
</svg>
