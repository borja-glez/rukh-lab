---
/**
 * The workshop M0 builds, and who uses each piece later.
 *
 * Four pieces are built in M0 (accent stroke): the data slice (lesson 3), the board with its
 * legality check (lesson 4), the judge and the run log (lesson 2). They all sit on the repository
 * of lesson 1, drawn as the base bar. The model (dashed) does not exist yet: it arrives in M2 and
 * slots between pieces that already work, which is the point of building them first.
 *
 * In a component rather than inline in the MDX: Prettier breaks every JSX element's children onto
 * their own line, MDX wraps a multi-line body in a `<p>`, and a `<p>` inside SVG closes the `<svg>`.
 */
interface Box {
  title: string;
  sub: string;
  lesson: string;
  x: number;
  y: number;
  /** Not built in M0: dashed stroke. */
  future?: boolean;
}

const W = 170;
const H = 64;

const boxes: Box[] = [
  { title: 'biblioteca', sub: 'Lichess → recorte', lesson: 'lección 3', x: 10, y: 20 },
  { title: 'el aprendiz', sub: 'el modelo', lesson: 'llega en M2', x: 235, y: 20, future: true },
  { title: 'tablero', sub: 'chess.js filtra', lesson: 'lección 4', x: 460, y: 20 },
  { title: 'árbitro', sub: 'Stockfish', lesson: 'lección 2', x: 235, y: 150 },
  { title: 'cuaderno', sub: 'MLflow', lesson: 'lección 2', x: 460, y: 150 },
];

const label =
  'El taller de M0. La biblioteca de partidas (lección 3) entrena al aprendiz, el modelo, que todavía no existe y llega en M2. El aprendiz propone jugadas al tablero, donde chess.js filtra las ilegales (lección 4), y juega contra el árbitro, Stockfish (lección 2). Las métricas del árbitro se apuntan en el cuaderno, MLflow (lección 2), de donde salen la tabla única y las model cards. Todo corre sobre el repositorio de la lección 1: uv, torch fijado, configuraciones estrictas y la CLI rukh.';
---

<svg viewBox="0 0 640 300" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" text-anchor="middle" dominant-baseline="middle">
    {boxes.map((b) => (
      <>
        <rect
          x={b.x}
          y={b.y}
          width={W}
          height={H}
          fill="var(--box-fill)"
          stroke={b.future ? 'var(--ink)' : 'var(--accent-text)'}
          stroke-width={b.future ? 1.25 : 2}
          stroke-dasharray={b.future ? '5 4' : undefined}
        />
        <text x={b.x + W / 2} y={b.y + 18} font-size="13" fill="var(--ink)">
          {b.title}
        </text>
        <text x={b.x + W / 2} y={b.y + 36} font-size="11" fill="var(--ink)">
          {b.sub}
        </text>
        <text x={b.x + W / 2} y={b.y + 52} font-size="10" fill="var(--muted)">
          {b.lesson}
        </text>
      </>
    ))}
  </g>

  <g fill="none" stroke="var(--diagram-stroke)" stroke-width="1.25">
    <path d="M180 52h49" />
    <path d="M405 52h49" />
    <path d="M320 84v60" />
    <path d="M405 182h49" />
  </g>
  <g fill="var(--diagram-stroke)">
    <path d="M235 52l-7 -4v8z" />
    <path d="M460 52l-7 -4v8z" />
    <path d="M320 150l-4 -7h8z" />
    <path d="M460 182l-7 -4v8z" />
  </g>

  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)" text-anchor="middle">
    <text x="207" y="42">
      entrena
    </text>
    <text x="432" y="42">
      propone
    </text>
    <text x="432" y="172">
      métricas
    </text>
    <text x="328" y="117" text-anchor="start">
      juega contra
    </text>
    <text x="545" y="232">
      → tabla única, model cards
    </text>
  </g>

  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)" dominant-baseline="middle">
    <rect
      x="10"
      y="163"
      width="24"
      height="14"
      fill="var(--box-fill)"
      stroke="var(--accent-text)"
      stroke-width="2"
    />
    <text x="42" y="170">
      lo construye M0
    </text>
    <rect
      x="10"
      y="191"
      width="24"
      height="14"
      fill="var(--box-fill)"
      stroke="var(--ink)"
      stroke-width="1.25"
      stroke-dasharray="5 4"
    />
    <text x="42" y="198">
      aún no existe
    </text>
  </g>

  <rect
    x="10"
    y="250"
    width="620"
    height="40"
    fill="var(--ink)"
    stroke="var(--ink)"
    stroke-width="1.25"
  />
  <text
    x="320"
    y="270"
    font-family="var(--font-mono)"
    font-size="11"
    fill="var(--paper)"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    el local · lección 1: uv, torch fijado, configs estrictas, CLI rukh
  </text>
</svg>
