---
/**
 * Why DPO reports the margin and the accuracy separately, and why `nll_weight` exists.
 *
 * The DPO margin is a difference of two differences: how much the policy moved the chosen move
 * away from the frozen reference, minus how much it moved the rejected one. Both panels start from
 * the same reference probabilities. On the left the policy does what everybody pictures: the good
 * move goes up and the bad one goes down. On the right both go down, the bad one faster -- and the
 * margin comes out slightly *larger*. The loss cannot tell the two apart, which is the whole case
 * for watching the accuracy and for anchoring the chosen move with a little next-token loss.
 *
 * The probabilities are an illustrative example, not a measurement, and the caption says so. The
 * margins are computed from them: ln(0.45/0.30) - ln(0.08/0.20) = 1.32 and
 * ln(0.18/0.30) - ln(0.03/0.20) = 1.39.
 */
const panels = [
  {
    title: 'lo que se busca',
    x: 16,
    chosen: { ref: 0.3, pol: 0.45, factor: '×1,5' },
    rejected: { ref: 0.2, pol: 0.08, factor: '×0,4' },
    margin: 'margen = ln 1,5 − ln 0,4 = +1,32',
  },
  {
    title: 'lo que el margen también premia',
    x: 328,
    chosen: { ref: 0.3, pol: 0.18, factor: '×0,6' },
    rejected: { ref: 0.2, pol: 0.03, factor: '×0,15' },
    margin: 'margen = ln 0,6 − ln 0,15 = +1,39',
  },
];

const BASE = 200;
const SCALE = 300;
const BAR = 36;
const fmt = (p: number) => p.toFixed(2).replace('.', ',');
const groups = (x: number) => [
  { key: 'chosen' as const, label: 'chosen (la buena)', gx: x + 30 },
  { key: 'rejected' as const, label: 'rejected (la mala)', gx: x + 170 },
];
---

<svg
  viewBox="0 0 640 300"
  role="img"
  aria-label="Dos paneles con la probabilidad de la jugada buena y de la mala, antes (la referencia congelada) y después de DPO (la política). A la izquierda, lo que se busca: la buena pasa de 0,30 a 0,45 y la mala de 0,20 a 0,08, margen más 1,32. A la derecha, las dos bajan: la buena de 0,30 a 0,18 y la mala de 0,20 a 0,03, y el margen sale más 1,39, algo mayor. La pérdida de DPO no distingue los dos casos."
>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--ink)">
    {panels.map((panel) => (
      <g>
        <text x={panel.x} y="20" font-size="11">
          {panel.title}
        </text>
        <text x={panel.x} y="36" font-size="10" fill="var(--muted)">
          probabilidad de cada jugada
        </text>
        <line
          x1={panel.x}
          y1={BASE}
          x2={panel.x + 296}
          y2={BASE}
          stroke="var(--line)"
          stroke-width="1"
        />
        {groups(panel.x).map((group) => {
          const values = panel[group.key];
          const refH = values.ref * SCALE;
          const polH = values.pol * SCALE;
          const polX = group.gx + BAR + 8;
          return (
            <g>
              <rect
                x={group.gx}
                y={BASE - refH}
                width={BAR}
                height={refH}
                fill="none"
                stroke="var(--muted)"
                stroke-width="1.2"
                stroke-dasharray="4 3"
              />
              <text
                x={group.gx + BAR / 2}
                y={BASE - refH - 5}
                text-anchor="middle"
                fill="var(--muted)"
              >
                {fmt(values.ref)}
              </text>
              <rect
                x={polX}
                y={BASE - polH}
                width={BAR}
                height={polH}
                fill="var(--accent)"
                fill-opacity="0.75"
                stroke="var(--line)"
              />
              <text x={polX + BAR / 2} y={BASE - polH - 5} text-anchor="middle">
                {fmt(values.pol)}
              </text>
              <text x={group.gx + BAR + 4} y={BASE + 16} text-anchor="middle" font-size="10">
                {group.label}
              </text>
              <text
                x={group.gx + BAR + 4}
                y={BASE + 30}
                text-anchor="middle"
                font-size="10"
                fill="var(--muted)"
              >
                {values.factor}
              </text>
            </g>
          );
        })}
        <text x={panel.x} y="256" font-size="10" fill="var(--accent-text)">
          {panel.margin}
        </text>
      </g>
    ))}
    <rect
      x="16"
      y="276"
      width="14"
      height="12"
      fill="none"
      stroke="var(--muted)"
      stroke-dasharray="4 3"
    />
    <text x="36" y="286" font-size="10" fill="var(--muted)">
      antes: referencia congelada
    </text>
    <rect
      x="260"
      y="276"
      width="14"
      height="12"
      fill="var(--accent)"
      fill-opacity="0.75"
      stroke="var(--line)"
    />
    <text x="280" y="286" font-size="10" fill="var(--muted)">
      después: la política tras DPO
    </text>
  </g>
</svg>
