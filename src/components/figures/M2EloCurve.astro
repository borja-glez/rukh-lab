---
/**
 * The Elo logistic and what each game is worth to the fit, on one axis.
 *
 * The solid curve is the expected score against a rival `d` points weaker or stronger; the
 * dashed one is `p(1 - p)`, the curvature each game adds to the likelihood, scaled so its peak
 * sits at the top. The dashed curve is why the interval of a real run is wider than the textbook
 * one: a game against a rival you beat (or lose to) almost always teaches the fit very little.
 * The two series are told apart by stroke, not by colour.
 */
const left = 64;
const right = 604;
const topY = 34;
const baseY = 234;
const span = 800;
const x = (d: number) => left + ((d + span) / (2 * span)) * (right - left);
const y = (v: number) => baseY - v * (baseY - topY);
const score = (d: number) => 1 / (1 + 10 ** (-d / 400));
const steps = Array.from({ length: 161 }, (_, i) => -span + i * 10);
const line = (f: (d: number) => number) =>
  steps.map((d, i) => `${i === 0 ? 'M' : 'L'}${x(d).toFixed(1)} ${y(f(d)).toFixed(1)}`).join(' ');
const scorePath = line(score);
const infoPath = line((d) => (score(d) * (1 - score(d))) / 0.25);
const marks = [-400, 0, 400].map((d) => ({
  d,
  p: score(d),
  label: `${Math.round(score(d) * 100)} %`,
}));
const ticks = [-800, -600, -400, -200, 0, 200, 400, 600, 800];
---

<svg
  viewBox="0 0 640 300"
  role="img"
  aria-label="La curva logística del Elo. Con 400 puntos menos que el rival se puntúa un 9 %, a la par un 50 % y con 400 puntos más un 91 %. Una segunda curva, discontinua, muestra cuánto informa cada partida al ajuste: es máxima cuando se puntúa un 50 % y cae casi a cero a 600 puntos de distancia por cualquiera de los dos lados."
>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    <line x1={left} y1={baseY} x2={right} y2={baseY} stroke="var(--line)" />
    <line x1={left} y1={topY} x2={left} y2={baseY} stroke="var(--line)" />
    <text x={left - 8} y={topY + 4} text-anchor="end">
      1
    </text>
    <text x={left - 8} y={y(0.5) + 4} text-anchor="end">
      0,5
    </text>
    <text x={left - 8} y={baseY + 4} text-anchor="end">
      0
    </text>
    {ticks.map((d) => (
      <>
        <line x1={x(d)} y1={baseY} x2={x(d)} y2={baseY + 5} stroke="var(--line)" />
        <text x={x(d)} y={baseY + 18} text-anchor="middle">
          {d > 0 ? `+${d}` : d}
        </text>
      </>
    ))}
    <text x={(left + right) / 2} y={baseY + 36} text-anchor="middle">
      Elo del modelo − Elo del rival
    </text>

    <path d={infoPath} fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="5 4" />
    <path d={scorePath} fill="none" stroke="var(--accent)" stroke-width="2.5" />

    {marks.map((m) => (
      <>
        <line
          x1={x(m.d)}
          y1={y(m.p)}
          x2={x(m.d)}
          y2={baseY}
          stroke="var(--line)"
          stroke-dasharray="2 3"
        />
        <circle cx={x(m.d)} cy={y(m.p)} r="4" fill="var(--accent)" />
        <text x={x(m.d) + 8} y={y(m.p) + (m.d > 0 ? 16 : -6)} fill="var(--ink)">
          {m.label}
        </text>
      </>
    ))}

    <line x1="330" y1="286" x2="362" y2="286" stroke="var(--accent)" stroke-width="2.5" />
    <text x="368" y="290">
      puntuación esperada
    </text>
    <line
      x1="74"
      y1="286"
      x2="106"
      y2="286"
      stroke="var(--ink)"
      stroke-width="1.5"
      stroke-dasharray="5 4"
    />
    <text x="112" y="290">
      cuánto informa una partida
    </text>
  </g>
</svg>
