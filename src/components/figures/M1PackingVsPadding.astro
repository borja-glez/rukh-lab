---
/**
 * The two ways of making games rectangular for the GPU, drawn with the same four games.
 *
 * Top: one game per row, padded to the 200-token block (or cut when longer). Bottom: the games
 * written one after another in a single stream, and each training window is 200 tokens starting
 * at a game's `<bos>`, so it holds that game and, when there is room, the beginning of the next.
 *
 * The game lengths are illustrative, not measured; the measured padding fractions (about 60 %
 * one game per row, 0.5 % packed) are in the lesson text, next to where they were measured.
 * Each window gets its own lane below the stream because they overlap: window A covers the start
 * of B, which is the point of the drawing.
 *
 * Animated: one 200-token window hops along the stream from one `<bos>` to the next, and the lane
 * of the window it is standing on lights up. The motion teaches what the lanes alone leave to
 * the reader: the window never starts in the middle of a game, it always runs past the end of
 * the one it starts on into the next, and it never lands on a `<pad>`, because the stream has
 * none. The hops are the lanes' own offsets, passed in as `--hop-*`, so the moving window cannot
 * drift from the static ones. Without motion the lanes say the same thing at once.
 */
const BLOCK = 200;
const x0 = 40;
const width = 560;
const rowH = 20;
const bosW = 5;

const games = [
  { name: 'A', len: 62 },
  { name: 'B', len: 148 },
  { name: 'C', len: 84 },
  { name: 'D', len: 230 },
];

/* Top panel: 200 tokens span the full width. */
const sA = width / BLOCK;
const rows = games.map((g, i) => ({
  ...g,
  y: 34 + i * 26,
  real: Math.min(g.len, BLOCK),
  pad: Math.max(0, BLOCK - g.len),
  cut: Math.max(0, g.len - BLOCK),
}));

/* Bottom panel: the whole stream spans the full width. */
const total = games.reduce((sum, g) => sum + g.len, 0);
const sB = width / total;
const streamY = 184;
let acc = 0;
const segments = games.map((g) => {
  const seg = { ...g, start: acc };
  acc += g.len;
  return seg;
});
const hops = segments.map((g) => `${(g.start * sB).toFixed(2)}px`);
const windowW = Math.min(BLOCK, total) * sB;
const lanes = segments.map((g, i) => ({
  name: g.name,
  x: x0 + g.start * sB,
  w: Math.min(BLOCK, total - g.start) * sB,
  y: streamY + 34 + i * 13,
}));

const legend = [
  { fill: 'var(--event)', opacity: 1, text: '<bos>', x: 40 },
  { fill: 'var(--accent)', opacity: 0.8, text: 'jugadas', x: 120 },
  { fill: 'var(--box-fill)', opacity: 1, text: '<pad>', x: 220 },
  { fill: 'var(--brand)', opacity: 0.3, text: 'ventana de 200 tokens', x: 300 },
];
---

<svg
  class="fig--packing"
  viewBox="0 0 640 318"
  role="img"
  aria-label="Las mismas cuatro partidas, A, B, C y D, de 62, 148, 84 y 230 tokens, servidas de dos formas. Arriba, una partida por fila de 200 tokens: A, B y C se rellenan con pad hasta 200 y D se corta en 200. Abajo, las cuatro partidas escritas seguidas en un solo flujo, sin relleno; cada ventana de entrenamiento son 200 tokens que empiezan en el bos de una partida y siguen con el principio de la siguiente. En la versión animada, una ventana salta por el flujo de un bos al siguiente."
>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
    <text x={x0} y="20" font-size="12">
      una partida por fila, rellenada hasta 200
    </text>
    {rows.map((r) => (
      <>
        <text x="26" y={r.y + 14} text-anchor="middle" fill="var(--muted)">
          {r.name}
        </text>
        <rect
          x={x0}
          y={r.y}
          width={r.real * sA}
          height={rowH}
          fill="var(--accent)"
          fill-opacity="0.8"
          stroke="var(--line)"
        />
        <rect x={x0} y={r.y} width={bosW} height={rowH} fill="var(--event)" />
        {r.pad > 0 && (
          <>
            <rect
              x={x0 + r.real * sA}
              y={r.y}
              width={r.pad * sA}
              height={rowH}
              fill="var(--box-fill)"
              stroke="var(--line)"
            />
            <text
              x={x0 + r.real * sA + (r.pad * sA) / 2}
              y={r.y + 14}
              text-anchor="middle"
              font-size="10"
              fill="var(--muted)"
            >
              {`<pad> × ${r.pad}`}
            </text>
          </>
        )}
        {r.cut > 0 && (
          <text x={x0 + width - 8} y={r.y + 14} text-anchor="end" font-size="10">
            {`cortada: ${r.cut} tokens fuera`}
          </text>
        )}
      </>
    ))}

    <text x={x0} y="162" font-size="12">
      flujo empaquetado, ventanas alineadas a un &lt;bos&gt;
    </text>
    {segments.map((g) => (
      <>
        <rect
          x={x0 + g.start * sB}
          y={streamY}
          width={g.len * sB}
          height={rowH}
          fill="var(--accent)"
          fill-opacity="0.8"
          stroke="var(--line)"
        />
        <rect x={x0 + g.start * sB} y={streamY} width={bosW} height={rowH} fill="var(--event)" />
        <text x={x0 + (g.start + g.len / 2) * sB} y={streamY + 14} text-anchor="middle">
          {g.name}
        </text>
      </>
    ))}
    <rect
      class="fig-packing__window"
      style={hops.map((hop, i) => `--hop-${i}:${hop}`).join(';')}
      x={x0}
      y={streamY - 4}
      width={windowW}
      height={rowH + 8}
      fill="var(--brand)"
      fill-opacity="0.18"
      stroke="var(--brand)"
      stroke-width="2"
    />
    <text x={x0 + width + 6} y={streamY + 14} fill="var(--muted)">
      …
    </text>
    {lanes.map((l, i) => (
      <g class={`fig-packing__lane fig-packing__lane--${i}`}>
        <text x={l.x - 4} y={l.y + 8} text-anchor="end" font-size="10" fill="var(--muted)">
          {l.name}
        </text>
        <rect
          x={l.x}
          y={l.y}
          width={l.w}
          height="9"
          fill="var(--brand)"
          fill-opacity="0.3"
          stroke="var(--brand)"
        />
      </g>
    ))}

    {legend.map((item) => (
      <>
        <rect
          x={item.x}
          y="298"
          width="14"
          height="12"
          fill={item.fill}
          fill-opacity={item.opacity}
          stroke="var(--line)"
        />
        <text x={item.x + 20} y="308" font-size="10" fill="var(--muted)">
          {item.text}
        </text>
      </>
    ))}
  </g>
</svg>
