---
/**
 * Why an int8 export that agrees 95 % of the time is a different player, and where the other 5 %
 * lives.
 *
 * Dynamic int8 quantisation rounds the weights, and that rounding reaches every logit as a small
 * error of its own. Two positions, the two best moves of each: in the first the gap between them
 * is much wider than the error, so the rounded model still picks the same move; in the second the
 * two logits are close, the bands where each can land after rounding overlap, and the rounded
 * model can pick the other one. The disagreements are not spread evenly over the positions: they
 * pile up where the decision was hard, which is why parity cannot say what they cost.
 *
 * Schematic on purpose: no axis values, because the point is the shape (gap against error), not
 * any measured logit.
 *
 * Animated: inside every bar, which stays at the original logit, a thinner filled bar -- the
 * logit after rounding -- lands at a different point of the dashed band on each beat, the way the
 * same weights rounded differently would, all four on the same clock. In the clear position the
 * two never come near each other; in the level one, once per cycle, the second ends up longer than
 * the first -- that is the int8 model choosing the other move, drawn as it happens. The motion shows
 * what the static bands only imply: the error is the same size in both panels, and it only
 * changes the answer where the gap is smaller than it. The four landing points of each bar are in
 * `landings`, as logits, kept inside ±EPS, and reach `global.css` as scale factors of the bar.
 * With motion reduced the rounded bars are not drawn and the figure is the static one.
 */
const X0 = 170;
const SPAN = 420;
const x = (v: number) => X0 + v * SPAN;
const EPS = 0.05;

const panels = [
  {
    title: 'una jugada clara',
    y: 34,
    moves: [0.82, 0.44],
    landings: [
      [0.8, 0.85, 0.78, 0.84],
      [0.47, 0.4, 0.46, 0.41],
    ],
    note: 'las bandas no se tocan: el int8 elige la misma jugada',
    risky: false,
  },
  {
    title: 'una posición igualada',
    y: 142,
    moves: [0.66, 0.62],
    /* The second landing flips the order: 0.63 against 0.66. */
    landings: [
      [0.69, 0.63, 0.7, 0.62],
      [0.59, 0.66, 0.58, 0.6],
    ],
    note: 'las bandas se solapan: el int8 puede elegir la otra',
    risky: true,
  },
];

const scales = (value: number, landing: number[]) =>
  landing.map((l, i) => `--s${i}:${(l / value).toFixed(4)}`).join(';');

const label =
  'Dos posiciones, con el logit de sus dos mejores jugadas y la banda en la que cada logit puede caer después de cuantizar a int8. En la primera, una jugada clara, la distancia entre los dos logits es mucho mayor que la banda y el modelo cuantizado elige la misma jugada. En la segunda, una posición igualada, las dos bandas se solapan y el modelo cuantizado puede elegir la otra. Las discrepancias se concentran en las posiciones difíciles. En la versión animada, una barra más fina dentro de cada una, el logit ya cuantizado, cae en distintos puntos de su banda: en la posición clara nunca se cruzan; en la igualada, la segunda supera a la primera una vez por ciclo.';
---

<svg class="fig--quant" viewBox="0 0 640 262" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--muted)">
    {panels.map((panel) => (
      <g>
        <text x="10" y={panel.y} fill="var(--ink)" font-size="12">
          {panel.title}
        </text>
        {panel.moves.map((value, index) => {
          const rowY = panel.y + 16 + index * 30;
          return (
            <g>
              <text x="10" y={rowY + 13}>
                {index === 0 ? 'mejor jugada' : 'segunda'}
              </text>
              <rect
                x={X0}
                y={rowY}
                width={x(value) - X0}
                height="18"
                fill="var(--box-fill)"
                stroke="var(--ink)"
                stroke-width="0.8"
              />
              <rect
                class="fig-quant__bar"
                style={scales(value, panel.landings[index])}
                x={X0}
                y={rowY + 5}
                width={x(value) - X0}
                height="8"
                fill="var(--ink)"
                fill-opacity="0.55"
              />
              <rect
                x={x(value - EPS)}
                y={rowY - 4}
                width={x(value + EPS) - x(value - EPS)}
                height="26"
                fill={panel.risky ? 'var(--accent)' : 'none'}
                fill-opacity={panel.risky ? 0.18 : 0}
                stroke={panel.risky ? 'var(--accent)' : 'var(--muted)'}
                stroke-width="1"
                stroke-dasharray="3 2"
              />
            </g>
          );
        })}
        <text x={X0} y={panel.y + 88} fill={panel.risky ? 'var(--accent-text-aa)' : 'var(--ink)'}>
          {panel.note}
        </text>
      </g>
    ))}
    <line x1="10" y1="236" x2="630" y2="236" stroke="var(--line)" stroke-width="0.6"></line>
    <text x="10" y="254" font-size="10">
      barra: logit del modelo original · banda discontinua: dónde puede caer tras cuantizar
    </text>
  </g>
</svg>
