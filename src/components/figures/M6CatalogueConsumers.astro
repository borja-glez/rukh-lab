---
/**
 * One list, four consumers: the catalogue of `rukh.hub` and everything that walks it.
 *
 * `rukh pull`, `rukh eval nightly`, `rukh publish cards` and `rukh publish collection` all read
 * the same list, so what can be downloaded, what is measured, what carries a card and what sits
 * in the Hub collection cannot drift apart. The public baseline is the exception drawn on
 * purpose: it is declared in `nightly.py`, next to the only consumer that needs it, because
 * inside the catalogue the other three would pull it as ours, card it as ours and collect it as
 * ours.
 */
const consumers = [
  { cmd: 'rukh eval nightly', what: 'mide cada etapa, el mismo día', y: 20 },
  { cmd: 'rukh pull', what: 'lo deja donde lo leen las configs', y: 80 },
  { cmd: 'rukh publish cards', what: 'regenera y sube solo el README', y: 140 },
  { cmd: 'rukh publish collection', what: 'la página del Hub, en orden', y: 200 },
];
const CX = 360;
const CW = 270;
const CH = 44;

const label =
  'El catálogo de rukh.hub, con trece modelos y ocho datasets, alimenta a cuatro consumidores: rukh eval nightly, que mide cada etapa el mismo día; rukh pull, que deja cada artefacto donde lo leen las configuraciones; rukh publish cards, que regenera las cards y sube solo el README; y rukh publish collection, que monta la colección del Hub. El baseline público de Karvonen no está en el catálogo: se declara en nightly.py y solo lo recibe nightly, que lo mide pero no lo descarga como nuestro, no le pone card ni lo mete en la colección.';
---

<svg viewBox="0 0 640 262" role="img" aria-label={label}>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
    <!-- the external baseline, declared where it is used -->
    <rect
      x="10"
      y="16"
      width="200"
      height="52"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1"
      stroke-dasharray="4 3"
    ></rect>
    <text x="22" y="37">
      karvonen-8l
    </text>
    <text x="22" y="55" fill="var(--muted)" font-size="10">
      en nightly.py, no es nuestro
    </text>
    <line
      x1="210"
      y1="42"
      x2={CX - 4}
      y2="42"
      stroke="var(--muted)"
      stroke-width="1"
      stroke-dasharray="4 3"
    ></line>
    <path d={`M${CX - 4} 42 l-7 -4 v8 z`} fill="var(--muted)"></path>
    <text x="222" y="34" fill="var(--muted)" font-size="10">
      solo se mide
    </text>

    <!-- the catalogue -->
    <rect
      x="10"
      y="110"
      width="200"
      height="96"
      fill="var(--ink)"
      stroke="var(--ink)"
      stroke-width="1"
    ></rect>
    <text x="22" y="136" fill="var(--paper)" font-size="12">
      catálogo
    </text>
    <text x="22" y="154" fill="var(--paper)">
      rukh.hub
    </text>
    <text x="22" y="178" fill="var(--paper)" font-size="10">
      13 modelos
    </text>
    <text x="22" y="194" fill="var(--paper)" font-size="10">
      8 datasets
    </text>

    {consumers.map((c) => (
      <g>
        <line
          x1="210"
          y1="158"
          x2={CX - 4}
          y2={c.y + CH / 2}
          stroke="var(--accent)"
          stroke-width="1.2"
        />
        <rect
          x={CX}
          y={c.y}
          width={CW}
          height={CH}
          fill="var(--box-fill)"
          stroke="var(--ink)"
          stroke-width="1"
        />
        <text x={CX + 12} y={c.y + 18}>
          {c.cmd}
        </text>
        <text x={CX + 12} y={c.y + 35} fill="var(--muted)" font-size="10">
          {c.what}
        </text>
      </g>
    ))}
    <text x="10" y="252" fill="var(--muted)" font-size="10">
      una sola lista: lo que se descarga, se mide, se documenta y se enseña no puede separarse
    </text>
  </g>
</svg>
