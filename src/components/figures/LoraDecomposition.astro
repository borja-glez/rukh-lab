---
/**
 * Why a two-megabyte file can change a 115-million-parameter model: the correction has to pass
 * through a waist of eight dimensions.
 *
 * The animation is the argument. Both paths carry the same signal from the same input strip to
 * the same output strip; the top one goes straight through a 768 x 768 matrix, the bottom one is
 * forced through `r = 8` and back out. Nothing about the drawing says the low-rank path is
 * cheaper — the counts do — but the waist is what makes "cheaper" believable, and it is also
 * exactly the limitation: whatever the adapter learns has to fit through there.
 *
 * Numbers are `medium`'s, not an example: `d_model` 768, one query projection is 589 824 numbers,
 * its adapter is 12 288, and the whole adapter over sixteen layers is 393 216 of 115 120 128.
 *
 * Lives in a component rather than inline in the MDX for the reason the other figures do: MDX
 * wraps a multi-line JSX body in a `<p>`, and a `<p>` inside an `<svg>` ends the SVG early.
 */
const dots = [0, 1, 2, 3];
---

<figure class="lora">
  <svg
    viewBox="0 0 640 300"
    role="img"
    aria-label="Dos caminos entre la misma entrada y la misma salida. El de arriba atraviesa una matriz cuadrada de 768 por 768 con 589 824 números. El de abajo pasa primero por una matriz de 768 por 8, se estrecha a ocho dimensiones y se vuelve a abrir con otra de 8 por 768: 12 288 números en total, el 2,1 por ciento del primero."
  >
    <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
      <!-- the input strip, shared by both paths -->
      <text x="14" y="26">
        entrada
      </text>
      <text x="14" y="38" font-size="9">
        768
      </text>
      <rect
        x="14"
        y="46"
        width="26"
        height="200"
        fill="var(--box-fill)"
        stroke="var(--line)"
        stroke-width="1"
      ></rect>

      <!-- top path: the frozen weight -->
      <text x="150" y="26" fill="var(--ink)">
        W · congelada
      </text>
      <rect
        x="150"
        y="46"
        width="120"
        height="86"
        fill="var(--diagram-stroke)"
        fill-opacity="0.22"
        stroke="var(--line)"
        stroke-width="1"
      ></rect>
      <text x="210" y="95" text-anchor="middle" font-size="11" fill="var(--ink)">
        768 × 768
      </text>
      <text x="210" y="110" text-anchor="middle" font-size="9.5">
        589 824 números
      </text>
      <line
        class="wire"
        x1="40"
        y1="89"
        x2="150"
        y2="89"
        stroke="var(--line)"
        stroke-width="1"
      ></line>
      <line
        class="wire"
        x1="270"
        y1="89"
        x2="560"
        y2="89"
        stroke="var(--line)"
        stroke-width="1"
      ></line>

      <!-- bottom path: the adapter, through the waist -->
      <text x="150" y="176" fill="var(--accent-text-aa)">
        B · A · el adaptador
      </text>
      <rect
        x="150"
        y="192"
        width="52"
        height="70"
        fill="var(--accent)"
        fill-opacity="0.28"
        stroke="var(--line)"
        stroke-width="1"
      ></rect>
      <text x="176" y="224" text-anchor="middle" font-size="9.5" fill="var(--ink)">
        A
      </text>
      <text x="176" y="236" text-anchor="middle" font-size="8.5">
        8 × 768
      </text>

      <rect
        x="232"
        y="215"
        width="18"
        height="24"
        fill="var(--accent)"
        fill-opacity="0.85"
        stroke="var(--line)"
        stroke-width="1"
      ></rect>
      <text x="241" y="257" text-anchor="middle" font-size="9.5" fill="var(--accent-text-aa)">
        r = 8
      </text>

      <rect
        x="280"
        y="192"
        width="52"
        height="70"
        fill="var(--accent)"
        fill-opacity="0.28"
        stroke="var(--line)"
        stroke-width="1"
      ></rect>
      <text x="306" y="224" text-anchor="middle" font-size="9.5" fill="var(--ink)">
        B
      </text>
      <text x="306" y="236" text-anchor="middle" font-size="8.5">
        768 × 8
      </text>

      <line
        class="wire"
        x1="40"
        y1="227"
        x2="150"
        y2="227"
        stroke="var(--line)"
        stroke-width="1"
      ></line>
      <line
        class="wire"
        x1="202"
        y1="227"
        x2="232"
        y2="227"
        stroke="var(--line)"
        stroke-width="1"
      ></line>
      <line
        class="wire"
        x1="250"
        y1="227"
        x2="280"
        y2="227"
        stroke="var(--line)"
        stroke-width="1"
      ></line>
      <line
        class="wire"
        x1="332"
        y1="227"
        x2="560"
        y2="227"
        stroke="var(--line)"
        stroke-width="1"
      ></line>
      <text x="360" y="212" font-size="9.5">
        12 288 números · el 2,1 % de W
      </text>

      <!-- the sum, and the output strip -->
      <line
        x1="560"
        y1="89"
        x2="560"
        y2="227"
        stroke="var(--line)"
        stroke-width="1"
        stroke-dasharray="3 3"
      ></line>
      <text x="568" y="162" font-size="14" fill="var(--ink)">
        +
      </text>
      <rect
        x="586"
        y="46"
        width="26"
        height="200"
        fill="var(--box-fill)"
        stroke="var(--line)"
        stroke-width="1"
      ></rect>
      <text x="586" y="26">
        salida
      </text>
      <text x="586" y="38" font-size="9">
        768
      </text>

      <!-- the signal: the same dots on both paths, so only the waist is different -->
      {dots.map((index) => (
        <>
          <circle class={`dot dot--${index}`} cx="40" cy="89" r="3.5" fill="var(--ink)" />
          <circle
            class={`dot dot--low dot--${index}`}
            cx="40"
            cy="227"
            r="3.5"
            fill="var(--accent-text-aa)"
          />
        </>
      ))}
    </g>
  </svg>
  <figcaption class="caption">
    La corrección no puede ser cualquier cosa: tiene que caber por ocho dimensiones. Eso es lo que
    la abarata y también lo que la limita.
  </figcaption>
</figure>

<style>
  .lora svg {
    width: 100%;
    height: auto;
  }

  /*
   * One keyframe set, two paths: the dots travel the same horizontal distance in the same time,
   * so the only visible difference between the two rows is the shape of what they pass through.
   */
  @keyframes lora-travel {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(546px);
    }
  }

  .dot {
    animation: lora-travel 4.8s linear infinite;
  }

  .dot--0 {
    animation-delay: 0s;
  }
  .dot--1 {
    animation-delay: 1.2s;
  }
  .dot--2 {
    animation-delay: 2.4s;
  }
  .dot--3 {
    animation-delay: 3.6s;
  }

  .dot--low {
    opacity: 0.9;
  }

  /*
   * With motion turned off the figure still has to make its point, so the dots stop where the
   * shapes are rather than disappearing: one inside `W`, one inside the waist.
   */
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
    .dot--0 {
      transform: translateX(170px);
    }
    .dot--1,
    .dot--2,
    .dot--3 {
      display: none;
    }
    .dot--low.dot--0 {
      transform: translateX(201px);
    }
  }
</style>
