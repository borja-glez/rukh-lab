---
/**
 * The label-count curve of M3 lab 3 next to the noise that makes it flat.
 *
 * The four joined points are `val/value_mae` of the nested 10/25/50/100 % runs (`last-n`, moves
 * scheme); the hollow point is the standalone `last-n` run on the same 100 % of the labels. All
 * five numbers are the measured ones in the lesson. The vertical axis is cut to 0.117..0.1225 on
 * purpose, and says so, because the point of the figure is the size of the differences: the whole
 * curve spans 0.0025 while two identical runs are 0.0035 apart.
 *
 * The curve is a solid line with filled dots and the second run a hollow dot, so the two series
 * are told apart by shape and not by colour.
 */
const low = 0.117;
const high = 0.1225;
const top = 30;
const bottom = 200;
const left = 60;
const right = 540;
const y = (v: number) => bottom - ((v - low) / (high - low)) * (bottom - top);

const points = [
  { label: '10 %', x: 100, v: 0.1217 },
  { label: '25 %', x: 220, v: 0.1192 },
  { label: '50 %', x: 340, v: 0.121 },
  { label: '100 %', x: 460, v: 0.1215 },
];
const rerun = { x: 460, v: 0.118 };
const ticks = [0.118, 0.12, 0.122];
const comma = (v: number) => v.toFixed(4).replace('.', ',');
const path = points.map((p, i) => `${i ? 'L' : 'M'} ${p.x} ${y(p.v)}`).join(' ');
---

<svg
  viewBox="0 0 640 290"
  role="img"
  aria-label="Error de valor contra porcentaje de etiquetas. La curva une cuatro puntos: 0,1217 con el 10 %, 0,1192 con el 25 %, 0,1210 con el 50 % y 0,1215 con el 100 %; una franja marca su rango, de ancho 0,0025. Un punto hueco en el 100 % es otra tirada con la misma receta y las mismas etiquetas: 0,1180, a 0,0035 del punto de la curva. El eje vertical está recortado entre 0,117 y 0,1225."
>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    <text x={left} y="16" fill="var(--ink)" font-size="11">
      error de valor (val/value_mae) · eje recortado
    </text>
    <rect
      x={left}
      y={y(0.1217)}
      width={right - left}
      height={y(0.1192) - y(0.1217)}
      fill="var(--accent)"
      fill-opacity="0.14"
    ></rect>
    <line x1={left} y1={bottom} x2={right} y2={bottom} stroke="var(--line)" stroke-width="1"></line>
    <line x1={left} y1={top} x2={left} y2={bottom} stroke="var(--line)" stroke-width="1"></line>
    {ticks.map((t) => (
      <g>
        <line x1={left - 4} y1={y(t)} x2={left} y2={y(t)} stroke="var(--line)" stroke-width="1" />
        <text x={left - 8} y={y(t) + 4} text-anchor="end">
          {t.toFixed(3).replace('.', ',')}
        </text>
      </g>
    ))}
    <path d={path} fill="none" stroke="var(--ink)" stroke-width="1.5"></path>
    {points.map((p) => (
      <g>
        <circle cx={p.x} cy={y(p.v)} r="4" fill="var(--ink)" />
        <text x={p.x + 8} y={y(p.v) - 6} fill="var(--ink)">
          {comma(p.v)}
        </text>
        <text x={p.x} y={bottom + 18} text-anchor="middle">
          {p.label}
        </text>
      </g>
    ))}
    <circle
      cx={rerun.x}
      cy={y(rerun.v)}
      r="4.5"
      fill="var(--paper)"
      stroke="var(--accent-text)"
      stroke-width="2"
    ></circle>
    <text x={rerun.x - 10} y={y(rerun.v) + 4} text-anchor="end" fill="var(--accent-text)">
      {comma(rerun.v)} · otra tirada, mismas etiquetas
    </text>
    <text x={(left + right) / 2} y={bottom + 34} text-anchor="middle">
      porcentaje de etiquetas de entrenamiento
    </text>
    <text x={left} y="262">
      franja: el rango de toda la curva, 0,0025
    </text>
    <text x={left} y="278">
      punto hueco: una tirada idéntica al 100 %, a 0,0035 del punto de la curva
    </text>
  </g>
</svg>
