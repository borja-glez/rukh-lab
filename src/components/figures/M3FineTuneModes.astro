---
/**
 * The three fine-tuning modes of `rukh train heads`, drawn on the same eight-block encoder: what
 * each one is allowed to move, and the value error each one reached in the lab.
 *
 * A filled piece is trained; an outlined one is frozen (and kept in eval mode, so dropout does not
 * move it either). The distinction is carried by fill versus outline, not by colour, so the figure
 * reads the same in both themes and without telling colours apart.
 *
 * The numbers under each column are the `val/value_mae` of the M3 lab 3 runs (moves scheme, 15 M
 * encoder, 4 000 steps, one seed per mode). They are measured, not illustrative.
 */
const blocks = Array.from({ length: 8 }, (_, i) => 8 - i);
const colWidth = 180;
const boxX = 20;
const boxW = colWidth - 2 * boxX;

type Piece = 'heads' | 'norm' | 'block' | 'embed';

const modes: {
  name: string;
  note: string;
  trains: (piece: Piece, block?: number) => boolean;
  mae: string;
  best: boolean;
}[] = [
  {
    name: 'probe',
    note: 'solo las cabezas',
    trains: (piece) => piece === 'heads',
    mae: '0,1429',
    best: false,
  },
  {
    name: 'last-n',
    note: 'cabezas + 2 bloques + norma',
    trains: (piece, block) =>
      piece === 'heads' || piece === 'norm' || (piece === 'block' && (block ?? 0) >= 7),
    mae: '0,1180',
    best: true,
  },
  {
    name: 'full',
    note: 'todo el modelo',
    trains: () => true,
    mae: '0,1354',
    best: false,
  },
];

const headsY = 50;
const normY = 80;
const firstBlockY = 102;
const blockStep = 19;
const blockH = 15;
const embedY = firstBlockY + blocks.length * blockStep + 2;
---

<svg
  viewBox="0 0 640 340"
  role="img"
  aria-label="Tres columnas con el mismo encoder de ocho bloques, embeddings abajo, norma final y tres cabezas arriba. En probe solo se entrenan las cabezas y todo el encoder está congelado: error de valor 0,1429. En last-n se entrenan las cabezas, los bloques 7 y 8 y la norma final: error 0,1180, el mejor. En full se entrena todo: error 0,1354."
>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
    {modes.map((mode, index) => {
      const dx = 30 + index * 200;
      const fillFor = (on: boolean) => (on ? 'var(--accent)' : 'none');
      const textFor = (on: boolean) => (on ? 'var(--paper)' : 'var(--muted)');
      return (
        <g transform={`translate(${dx} 0)`}>
          <text x={boxX} y="18" font-size="13" fill="var(--ink)">
            {mode.name}
          </text>
          <text x={boxX} y="36">
            {mode.note}
          </text>
          <rect
            x={boxX}
            y={headsY}
            width={boxW}
            height="22"
            rx="3"
            fill={fillFor(mode.trains('heads'))}
            fill-opacity="0.9"
            stroke="var(--ink)"
            stroke-width="1"
          />
          <text
            x={boxX + boxW / 2}
            y={headsY + 15}
            text-anchor="middle"
            fill={textFor(mode.trains('heads'))}
          >
            tres cabezas
          </text>
          <rect
            x={boxX}
            y={normY}
            width={boxW}
            height="15"
            rx="2"
            fill={fillFor(mode.trains('norm'))}
            fill-opacity="0.9"
            stroke="var(--line)"
            stroke-width="1"
          />
          <text
            x={boxX + boxW / 2}
            y={normY + 11}
            text-anchor="middle"
            fill={textFor(mode.trains('norm'))}
          >
            norma final
          </text>
          {blocks.map((block, row) => {
            const on = mode.trains('block', block);
            const y = firstBlockY + row * blockStep;
            return (
              <g>
                <rect
                  x={boxX}
                  y={y}
                  width={boxW}
                  height={blockH}
                  rx="2"
                  fill={fillFor(on)}
                  fill-opacity="0.9"
                  stroke="var(--line)"
                  stroke-width="1"
                />
                <text x={boxX + boxW / 2} y={y + 11} text-anchor="middle" fill={textFor(on)}>
                  {`bloque ${block}`}
                </text>
              </g>
            );
          })}
          <rect
            x={boxX}
            y={embedY}
            width={boxW}
            height="15"
            rx="2"
            fill={fillFor(mode.trains('embed'))}
            fill-opacity="0.9"
            stroke="var(--line)"
            stroke-width="1"
          />
          <text
            x={boxX + boxW / 2}
            y={embedY + 11}
            text-anchor="middle"
            fill={textFor(mode.trains('embed'))}
          >
            embeddings
          </text>
          <text x={boxX} y={embedY + 42}>
            error de valor
          </text>
          <text
            x={boxX}
            y={embedY + 60}
            font-size="14"
            fill={mode.best ? 'var(--accent-text)' : 'var(--ink)'}
          >
            {mode.best ? `${mode.mae} · el mejor` : mode.mae}
          </text>
        </g>
      );
    })}
    <text x="50" y="334">
      relleno: se entrena · contorno: congelado y en modo eval
    </text>
  </g>
</svg>
