---
/**
 * What a softmax does when you push one logit down: the probability does not vanish, it is
 * redistributed over everything else in proportion — including the tail you never wanted.
 *
 * Twelve bars rather than three on purpose. With three, lowering one looks like a trade with the
 * other two; the thing the eye has to catch is that the whole tail rises at once. The tail is
 * coloured as illegal moves because that turns an arithmetic lesson into the mechanism behind a
 * number the reader has already seen: legality measured without the mask.
 *
 * Laid out in two columns with room for a third, so the "anchored" case can be added later
 * without redrawing.
 */
const moves = [
  { t: 'g1f3', p: 0.34, kind: 'target' },
  { t: 'b1c3', p: 0.18, kind: 'ok' },
  { t: 'd2d4', p: 0.13, kind: 'ok' },
  { t: 'e2e3', p: 0.09, kind: 'ok' },
  ...['a2a3', 'h2h4', 'b2b3', 'g2g4', 'a1b1', 'h1g1', 'c1b2', 'd1e2'].map((t, i) => ({
    t,
    p: [0.06, 0.05, 0.04, 0.035, 0.03, 0.02, 0.015, 0.01][i],
    kind: 'tail',
  })),
];
/* A distribution has to sum to 1 before the lesson can say anything about where the mass goes. */
const before = moves.reduce((s, m) => s + m.p, 0);
if (Math.abs(before - 1) > 1e-9) {
  throw new Error(`SoftmaxPush: the twelve probabilities sum to ${before}, not 1`);
}
const pushed = moves.map((m, i) => (i === 0 ? m.p * 0.05 : m.p));
const total = pushed.reduce((s, p) => s + p, 0);
const after = pushed.map((p) => p / total);
/* Every label is computed from the bars, so the caption cannot drift from the drawing. */
const sum = (values: number[], kind: string) =>
  values.reduce((s, p, i) => (moves[i].kind === kind ? s + p : s), 0);
const pct = (p: number) => `${Math.round(p * 100)} %`;
const targetBefore = pct(moves[0].p);
const tailBefore = pct(
  sum(
    moves.map((m) => m.p),
    'tail',
  ),
);
const tailAfter = pct(sum(after, 'tail'));
const colour = (k: string) =>
  k === 'target' ? 'var(--ink)' : k === 'ok' ? 'var(--event)' : 'var(--accent)';
const y = (i: number) => 44 + i * 19;
const bar = (p: number) => Math.max(1.5, p * 300);
---

<svg
  viewBox="0 0 640 300"
  role="img"
  aria-label={`Dos distribuciones de doce jugadas. En la primera la mejor se lleva el ${targetBefore} y la cola de ocho jugadas dudosas suma el ${tailBefore}. Al empujar la mejor hacia abajo, esa probabilidad no desaparece: la cola entera sube a la vez y pasa a sumar el ${tailAfter}.`}
>
  <g font-family="var(--font-mono)" font-size="10" fill="var(--ink)">
    <text x="14" y="18" fill="var(--muted)">
      antes · suma = 1
    </text>
    <text x="330" y="18" fill="var(--muted)">
      tras empujar `g1f3` hacia abajo · suma = 1
    </text>

    {moves.map((m, i) => (
      <>
        <text x="14" y={y(i) + 4} font-size="9" fill="var(--muted)">
          {m.t}
        </text>
        <rect
          x="58"
          y={y(i) - 7}
          width={bar(m.p)}
          height="12"
          fill={colour(m.kind)}
          fill-opacity="0.85"
        />
        <text x="330" y={y(i) + 4} font-size="9" fill="var(--muted)">
          {m.t}
        </text>
        <rect
          x="374"
          y={y(i) - 7}
          width={bar(after[i])}
          height="12"
          fill={colour(m.kind)}
          fill-opacity="0.85"
        />
      </>
    ))}

    <line
      x1="58"
      y1={y(3) + 10}
      x2="300"
      y2={y(3) + 10}
      stroke="var(--line)"
      stroke-dasharray="3 3"
    />
    <line
      x1="374"
      y1={y(3) + 10}
      x2="616"
      y2={y(3) + 10}
      stroke="var(--line)"
      stroke-dasharray="3 3"
    />
    <text x="58" y="290" font-size="9.5" fill="var(--muted)">
      la cola suma {tailBefore}
    </text>
    <text x="374" y="290" font-size="9.5" fill="var(--muted)">
      la cola suma {tailAfter} · nadie la subió a propósito
    </text>
  </g>
</svg>
