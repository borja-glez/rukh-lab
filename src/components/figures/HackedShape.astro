---
/**
 * The measurement that killed the first version of the reward-hacking lab.
 *
 * Six rewards, one candidate group, and the finding nobody expects: all six crown the same move.
 * Every one is monotone in the engine's score, so the top of the ranking cannot move. The damage
 * is underneath, in what the optimiser actually consumes -- GRPO does not see the reward, it sees
 * `(r - mean) / std` over the group.
 *
 * So the bars are advantages, not rewards, and every number is from `labs/m5/reward_hacking.py`
 * on the first case at depth 10. The group is four legal moves the engine scored -23, -67, -378
 * and -966 centipawns, plus two moves that cannot be played.
 *
 * Left, the sound reward: the two illegal proposals sit at the bottom at -1.28, where a gate is
 * supposed to put them. Right, the same group with one change -- the quality term loses its floor
 * -- and the two illegal proposals come out at **+0.18**, above a legal move 355 centipawns off
 * the best. The gate did not move; the range underneath it did, and a floor is only a floor
 * relative to what it has to be below.
 *
 * The honest cost of the cap is visible on the left too: `b2b4` and `f3g4` both land on +0.14,
 * because a 355-centipawn error and a 943-centipawn one both clamp to zero quality. A bounded
 * interval is paid for with resolution at the bottom, and that is the trade the project took.
 */
interface Slice {
  label: string;
  cp: string;
  sound: number;
  broken: number;
  illegal?: boolean;
}

const candidates: Slice[] = [
  { label: 'g1e2', cp: '−23', sound: 1.27, broken: 0.99 },
  { label: 'c2c3', cp: '−67', sound: 1.02, broken: 0.85 },
  { label: 'b2b4', cp: '−378', sound: 0.14, broken: -0.15 },
  { label: 'f3g4', cp: '−966', sound: 0.14, broken: -2.05 },
  { label: 'a1d1', cp: 'ilegal', sound: -1.28, broken: 0.18, illegal: true },
  { label: 'b1d1', cp: 'ilegal', sound: -1.28, broken: 0.18, illegal: true },
];

const SCALE = 24;
const AXIS = 112;
const bar = (value: number) => Math.max(Math.abs(value) * SCALE, 1.5);

const panels = [
  { title: 'recompensa sana', key: 'sound' as const, worst: '25,0 %', head: '0,250' },
  { title: 'sin suelo en la calidad', key: 'broken' as const, worst: '46,5 %', head: '0,142' },
];
const originX = (index: number) => 52 + index * 306;
---

<figure class="fig fig--hacked">
  <svg
    viewBox="0 0 640 260"
    role="img"
    aria-label="Ventajas de las mismas seis candidatas bajo dos recompensas. Con la sana, las dos jugadas ilegales quedan abajo del todo en menos 1,28 y las cuatro legales por encima. Sin suelo en el término de calidad, las dos ilegales salen en más 0,18, por encima de una jugada legal que está a 355 centipeones del óptimo y que saca menos 0,15. Las dos coronan la misma jugada, g1e2."
  >
    <g font-family="var(--font-mono)" font-size="10" fill="var(--muted)">
      {panels.map((panel, panelIndex) => (
        <g>
          <text x={originX(panelIndex)} y="22" fill="var(--ink)">
            {panel.title}
          </text>
          <line
            x1={originX(panelIndex) - 8}
            y1={AXIS}
            x2={originX(panelIndex) + 6 * 44 - 12}
            y2={AXIS}
            stroke="var(--line)"
            stroke-width="0.8"
          ></line>
          {candidates.map((candidate, index) => {
            const value = candidate[panel.key];
            const up = value >= 0;
            const x = originX(panelIndex) + index * 44;
            return (
              <g>
                <rect
                  x={x}
                  y={up ? AXIS - bar(value) : AXIS}
                  width="26"
                  height={bar(value)}
                  rx="1.5"
                  fill={up ? 'var(--accent)' : 'var(--diagram-stroke)'}
                  fill-opacity={candidate.illegal ? '0.14' : up ? '0.32' : '0.24'}
                  stroke={up ? 'var(--accent)' : 'var(--line)'}
                  stroke-width="0.9"
                  stroke-dasharray={candidate.illegal ? '3 2' : undefined}
                />
                <text
                  x={x + 13}
                  y={up ? AXIS - bar(value) - 5 : AXIS + bar(value) + 11}
                  text-anchor="middle"
                  font-size="8"
                  fill={candidate.illegal ? 'var(--ink)' : 'var(--muted)'}
                >
                  {value >= 0 ? `+${value.toFixed(2)}` : value.toFixed(2)}
                </text>
                <text x={x + 13} y="178" text-anchor="middle" font-size="8" fill="var(--ink)">
                  {candidate.label}
                </text>
                <text x={x + 13} y="190" text-anchor="middle" font-size="8">
                  {candidate.cp}
                </text>
              </g>
            );
          })}
          <text x={originX(panelIndex)} y="214" font-size="9">
            corona g1e2 · cabeza {panel.head}
          </text>
          <text x={originX(panelIndex)} y="228" font-size="9" fill="var(--accent-text-aa)">
            la peor se lleva el {panel.worst} de la masa
          </text>
        </g>
      ))}
      <text x="52" y="250" font-size="9">
        a trazos, las dos jugadas que no se pueden jugar: a la derecha puntúan por encima de una
        legal que está a 355 centipeones del óptimo
      </text>
    </g>
  </svg>
  <figcaption class="caption">
    Misma corona, misma ordenación arriba. Quitarle el suelo al término de calidad no cambia qué
    jugada gana: cambia que una jugada imposible pase a valer más que una legal mala.
  </figcaption>
</figure>
