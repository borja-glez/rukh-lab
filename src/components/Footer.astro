---
import { SITE } from '../lib/site';

const t = {
  tagline: 'Un curso que construye un modelo de lenguaje de ajedrez desde cero.',
  license: 'Código MIT · Lecciones CC BY-NC-SA 4.0',
  nav: 'Pie de página',
  links: [
    { href: '/curso/', label: 'Curso' },
    { href: '/glosario/', label: 'Glosario' },
    { href: '/cheatsheets/', label: 'Cheatsheets' },
    { href: '/proyecto/', label: 'Proyecto' },
  ],
};
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__col">
      <span class="brand mono">
        <span class="brand__mark" aria-hidden="true"></span>rukh · lab
      </span>
      <p class="caption footer__tagline">{t.tagline}</p>
    </div>
    <nav class="footer__col" aria-label={t.nav}>
      <ul class="footer__links mono">
        {t.links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
        <li>
          <a href={SITE.demoUrl} rel="noopener">
            rukh.borjaglez.com
          </a>
        </li>
        <li>
          <a href={SITE.githubUrl} rel="noopener">
            GitHub
          </a>
        </li>
        <li>
          <a href={SITE.hfUrl} rel="noopener">
            Hugging Face
          </a>
        </li>
      </ul>
    </nav>
    <p class="caption footer__meta">
      <a href={SITE.portfolioUrl} rel="noopener">
        borjaglez.com
      </a>{' '}
      · Ourense · {SITE.year} · {t.license}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px 48px;
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .brand__mark {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--ink);
  }

  .footer__tagline {
    max-width: 40ch;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-size: 12px;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--ink);
  }

  .footer__meta {
    grid-column: 1 / -1;
  }

  .footer__meta a {
    color: inherit;
  }

  @media (max-width: 720px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
