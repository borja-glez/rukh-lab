---
/**
 * The map of the whole course, with the reader's module marked on it.
 *
 * It sits at the top of the first lesson of every module (`at="inicio"`: where the apprentice is
 * and why this step exists) and at the bottom of the last one (`at="final"`: what the reader has
 * now and where the next stop is), so a reader always knows which part of building a language
 * model they are in, and a lesson does not have to retell the itinerary in prose. With no
 * `module` it is the bare map, for the course index.
 *
 * The stops are an ordered list, not an SVG: seven stops with two lines of text each do not fit
 * a phone in one row, and a list can turn into a vertical line under 720 px. Each node is a small
 * SVG; the connectors are pseudo-elements. The state of every stop is written in words for
 * screen readers, never carried by colour alone.
 */
import { NEXT_PHASE, STOPS } from '../data/recorrido';

interface Props {
  /** The module the reader is in, e.g. `m2`. Omit for the plain map. */
  module?: string;
  at?: 'inicio' | 'final';
}

const { module, at = 'inicio' } = Astro.props;
const current = module ? STOPS.findIndex((s) => s.id === module) : -1;
const stop = current >= 0 ? STOPS[current] : undefined;
const next = current >= 0 ? STOPS[current + 1] : undefined;

type State = 'done' | 'current' | 'todo';
/** At the end of a module, the module itself counts as done. */
const stateOf = (i: number): State => {
  if (current < 0) return 'todo';
  if (i < current || (i === current && at === 'final')) return 'done';
  return i === current ? 'current' : 'todo';
};
const stateText: Record<State, string> = {
  done: 'hecho',
  current: 'estás aquí',
  todo: 'por delante',
};
const heading = !stop ? 'el recorrido' : at === 'inicio' ? 'dónde estás' : 'lo conseguido';
---

<section
  class:list={['rc', `rc--${at}`, { 'rc--map': !stop }]}
  aria-label={stop ? `El recorrido del curso: ${heading}` : 'El recorrido del curso'}
>
  <p class="label label--accent rc__label">// el recorrido · {heading}</p>

  <ol class="rc__line">
    {STOPS.map((s, i) => {
      const state = stateOf(i);
      const segmentDone = current >= 0 && (i < current || (i === current && at === 'final'));
      return (
        <li class:list={['rc__stop', `is-${state}`, { 'seg-done': segmentDone }]}>
          <svg class="rc__node" viewBox="0 0 32 32" aria-hidden="true">
            {state === 'current' && <circle class="rc__pulse" cx="16" cy="16" r="13" />}
            <circle class="rc__dot" cx="16" cy="16" r="12" />
            {state === 'done' ? (
              <path class="rc__check" d="m10 16.5 4 4 8-9" />
            ) : (
              <text x="16" y="16.5" text-anchor="middle" dominant-baseline="middle">
                {i}
              </text>
            )}
          </svg>
          <span class="rc__text">
            <span class="rc__name">
              <span class="mono rc__id">{s.id.toUpperCase()}</span> {s.name}
            </span>
            <span class="rc__stage">{s.stage}</span>
            {current >= 0 && <span class="sr-only">({stateText[state]})</span>}
          </span>
        </li>
      );
    })}
    <li class="rc__stop rc__stop--phase2">
      <svg class="rc__node" viewBox="0 0 32 32" aria-hidden="true">
        <circle class="rc__dot" cx="16" cy="16" r="12"></circle>
        <text x="16" y="16.5" text-anchor="middle" dominant-baseline="middle">
          …
        </text>
      </svg>
      <span class="rc__text">
        <span class="rc__name">
          <span class="mono rc__id">FASE 2</span> {NEXT_PHASE.name}
        </span>
        <span class="rc__stage">{NEXT_PHASE.stage}</span>
      </span>
    </li>
  </ol>

  {stop && at === 'inicio' && (
    <div class="rc__panel">
      <div>
        <p class="label rc__k">el aprendiz, ahora</p>
        <p class="rc__v">{stop.apprentice}</p>
      </div>
      <div>
        <p class="label rc__k">por qué este paso · fuera del ajedrez</p>
        <p class="rc__v">{stop.why}</p>
      </div>
    </div>
  )}
  {stop && at === 'final' && (
    <div class="rc__panel">
      <div>
        <p class="label rc__k">lo que tienes ahora</p>
        <p class="rc__v">{stop.achieved}</p>
      </div>
      <div>
        <p class="label rc__k">
          siguiente parada · {next ? `${next.id.toUpperCase()} ${next.name}` : NEXT_PHASE.name}
        </p>
        <p class="rc__v">{next ? next.apprentice : NEXT_PHASE.apprentice}</p>
      </div>
    </div>
  )}
</section>

<style>
  .rc {
    --rc-node: 30px;
    margin: 2rem 0 0;
    padding: 18px 20px 20px;
    border: 1px solid var(--line);
    background: var(--frame-bg);
  }

  .rc--final {
    margin-top: 3rem;
  }

  .rc__label {
    margin: 0 0 14px;
  }

  .rc__line {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rc__stop {
    position: relative;
    display: grid;
    grid-template-columns: var(--rc-node) 1fr;
    gap: 12px;
    align-items: start;
    padding-bottom: 14px;
  }

  /* The connector to the next stop: down the left edge on a phone. */
  .rc__stop:not(:last-child)::after {
    content: '';
    position: absolute;
    top: var(--rc-node);
    bottom: 0;
    left: calc(var(--rc-node) / 2 - 1px);
    width: 2px;
    background: var(--line);
  }

  .rc__stop.seg-done::after {
    background: var(--brand);
  }

  .rc__stop:nth-last-child(2)::after {
    background: none;
    border-left: 2px dashed var(--line);
    width: 0;
  }

  .rc__node {
    display: block;
    width: var(--rc-node);
    height: var(--rc-node);
    overflow: visible;
  }

  .rc__dot {
    fill: var(--box-fill);
    stroke: var(--diagram-stroke);
    stroke-width: 1.5;
  }

  .rc__node text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--muted);
  }

  .is-done .rc__dot {
    fill: var(--brand);
    stroke: var(--brand);
  }

  .rc__check {
    fill: none;
    stroke: var(--paper);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .is-current .rc__dot {
    fill: var(--accent);
    stroke: var(--accent-text);
    stroke-width: 2;
  }

  .is-current .rc__node text {
    fill: var(--selection-fg);
    font-weight: 700;
  }

  .rc__pulse {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    transform-origin: 16px 16px;
  }

  .rc__stop--phase2 .rc__dot {
    stroke-dasharray: 3 3;
  }

  .rc__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 4px;
    min-width: 0;
  }

  .rc__name {
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .rc__id {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .is-current .rc__name {
    font-weight: 600;
  }

  .rc__stage {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .rc__panel {
    display: grid;
    gap: 14px;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
  }

  .rc__k {
    margin: 0 0 4px;
  }

  .rc__v {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* One row on a wide screen: nodes on top, connectors running right. */
  @media (min-width: 720px) {
    .rc__line {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .rc__stop {
      grid-template-columns: 1fr;
      justify-items: center;
      align-content: start;
      gap: 8px;
      padding-bottom: 0;
      text-align: center;
    }

    .rc__stop:not(:last-child)::after {
      top: calc(var(--rc-node) / 2 - 1px);
      bottom: auto;
      left: calc(50% + var(--rc-node) / 2);
      width: calc(100% - var(--rc-node));
      height: 2px;
    }

    .rc__stop:nth-last-child(2)::after {
      border-left: 0;
      border-top: 2px dashed var(--line);
      height: 0;
    }

    .rc__text {
      padding: 0 4px;
      overflow-wrap: anywhere;
      hyphens: auto;
    }

    .rc__panel {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rc__pulse {
      animation: rc-pulse 2.4s ease-out infinite;
    }

    .rc--final .is-done:has(+ .is-todo) .rc__check,
    .rc--final .is-done:has(+ .rc__stop--phase2) .rc__check {
      stroke-dasharray: 20;
      stroke-dashoffset: 20;
      animation: rc-check 0.7s 0.3s ease-out forwards;
    }
  }

  @keyframes rc-pulse {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  @keyframes rc-check {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
