---
import type { Locale } from '../lib/site';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t =
  lang === 'en'
    ? { group: 'Colour theme', light: 'Light theme', dark: 'Dark theme' }
    : { group: 'Tema de color', light: 'Tema claro', dark: 'Tema oscuro' };
---

<div class="theme" role="group" aria-label={t.group}>
  <button
    class="theme__item"
    type="button"
    data-theme-option="light"
    aria-label={t.light}
    title={t.light}
  >
    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5"></circle>
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.2 2.2M16.9 16.9l2.2 2.2M4.9 19.1l2.2-2.2M16.9 7.1l2.2-2.2"></path>
    </svg>
  </button>
  <button
    class="theme__item"
    type="button"
    data-theme-option="dark"
    aria-label={t.dark}
    title={t.dark}
  >
    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
    </svg>
  </button>
</div>

<style>
  .theme {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* 44px tall hit area with a 26px visual pill inside. */
  .theme__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .theme__item svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme__item:hover {
    color: var(--ink);
  }

  .theme__item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /*
    Active state resolved in CSS only (no flash on load): the scheme chosen with
    data-theme or, failing that, the system one.
  */
  html[data-theme='light'] .theme__item[data-theme-option='light'],
  html[data-theme='dark'] .theme__item[data-theme-option='dark'] {
    background: var(--ink);
    color: var(--paper);
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme]) .theme__item[data-theme-option='light'] {
      background: var(--ink);
      color: var(--paper);
    }
  }

  @media (prefers-color-scheme: dark) {
    html:not([data-theme]) .theme__item[data-theme-option='dark'] {
      background: var(--ink);
      color: var(--paper);
    }
  }
</style>
