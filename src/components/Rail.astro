---
/**
 * Vertical rail with one tick per section, pinned to the left gutter. Ticks light
 * up as their section scrolls into view (src/scripts/toc.ts drives it via the
 * `data-rail-tick` attribute). Hidden on narrow screens.
 */
interface Props {
  ticks: { id: string; label: string }[];
}

const { ticks } = Astro.props;
---

<div class="rail" data-rail aria-hidden="true">
  {ticks.map((tick, i) => (
    <a class="rail__stop" href={`#${tick.id}`} data-rail-tick={tick.id} tabindex="-1">
      <span class="rail__tick" />
      <span class="rail__label mono">{String(i).padStart(2, '0')}</span>
    </a>
  ))}
</div>

<style>
  .rail {
    position: sticky;
    top: calc(var(--header-h) + 48px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: 40px;
    padding-left: 3px;
  }

  .rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 6px;
    width: 1px;
    background: var(--line);
  }

  .rail__stop {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .rail__tick {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--diagram-stroke);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .rail__label {
    font-size: 10px;
    color: var(--muted);
    opacity: 0.45;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
  }

  .rail__stop.is-active .rail__tick {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.5);
  }

  .rail__stop.is-active .rail__label {
    opacity: 1;
    color: var(--ink);
  }

  @media (max-width: 1100px) {
    .rail {
      display: none;
    }
  }
</style>
