---
import ThemeToggle from './ThemeToggle.astro';
import { SITE, type Locale } from '../lib/site';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  lang?: Locale;
  secondary?: boolean;
}

const nav: NavItem[] =
  lang === 'en'
    ? [
        { href: '/curso/', label: 'Course', lang: 'es' },
        { href: '/proyecto/', label: 'Project' },
      ]
    : [
        { href: '/curso/', label: 'Curso' },
        { href: '/glosario/', label: 'Glosario', secondary: true },
        { href: '/cheatsheets/', label: 'Cheatsheets', secondary: true },
        { href: '/proyecto/', label: 'Proyecto', lang: 'en' },
      ];

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(`${href}`);
const playLabel = lang === 'en' ? 'Play' : 'Jugar';
const navLabel = lang === 'en' ? 'Main navigation' : 'Navegación principal';
const homeLabel = lang === 'en' ? 'Rukh lab, home' : 'Rukh lab, inicio';
---

<header class="header">
  <a class="brand mono" href={lang === 'en' ? '/en/' : '/'} aria-label={homeLabel}>
    <span class="brand__mark" aria-hidden="true"></span>rukh · lab
  </a>
  <nav class="nav mono" aria-label={navLabel}>
    <ul class="nav__list">
      {nav.map((item) => (
        <li>
          <a
            class:list={[
              'nav__item',
              { 'is-active': isCurrent(item.href), 'nav__item--secondary': item.secondary },
            ]}
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            lang={item.lang}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a class="nav__item nav__item--play" href={SITE.demoUrl} rel="noopener">
          {playLabel}
          <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
        </a>
      </li>
    </ul>
  </nav>
  <ThemeToggle lang={lang} />
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--gutter);
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__mark {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--ink);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__item:hover {
    color: var(--ink);
  }

  .nav__item.is-active {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--accent);
  }

  .nav__item--play {
    color: var(--accent-text);
  }

  .nav__item--play svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 720px) {
    .header {
      gap: 8px;
    }

    .nav__item {
      padding: 0 8px;
      font-size: 11px;
    }

    /* Glossary and cheatsheets stay reachable from the footer and the course page. */
    .nav__item--secondary:not(.is-active) {
      display: none;
    }
  }
</style>
